<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EnviousWispr</AssemblyName>
    <RootNamespace>EnviousWispr</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WindowsDesktop SDK drops System.IO + System.Net.Http from implicit usings; restore them -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />

    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
