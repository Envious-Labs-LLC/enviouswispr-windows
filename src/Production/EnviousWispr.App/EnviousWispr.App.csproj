<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EnviousWispr.App</RootNamespace>
    <AssemblyName>EnviousWispr.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DefaultLanguage>en-US</DefaultLanguage>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>EnviousWispr.App.Program</StartupObject>
    <ApplicationIcon>Assets\Brand\EnviousWispr.ico</ApplicationIcon>
    <Version>0.19.0</Version>
    <EnviousWisprReleaseChannel Condition="'$(EnviousWisprReleaseChannel)' == ''">stable</EnviousWisprReleaseChannel>
  </PropertyGroup>

  <!--
    PACKAGING IS OPT-IN, so one property is the whole difference between the build that ships and the
    build every gate already runs. `validate.ps1` and CI build this project UNPACKAGED today, and step E
    of #42 is what finally retires that path; until then a switch that changed the default would break
    the gate that proves the change. `scripts/package-store.ps1` sets EnviousWisprPackaged=true.
  -->
  <PropertyGroup Condition="'$(EnviousWisprPackaged)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxManifest>Package.appxmanifest</AppxManifest>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <!-- The Store re-signs, and a sideload build is signed explicitly by the packaging script. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
  </PropertyGroup>

  <!--
    A STORE PACKAGE MUST CARRY ITS OWN .NET. `dotnet build -p:EnviousWisprPackaged=true` produced a
    package that started only because this PC has the .NET 10 runtime installed; a customer's PC does
    not, and the worker inside it was missing besides. Only a self-contained publish makes a shippable
    package, so anything else is refused here rather than discovered on a customer's machine.
  -->
  <Target Name="RefuseFrameworkDependentStorePackage" BeforeTargets="PrepareForBuild" Condition="'$(EnviousWisprPackaged)' == 'true' And '$(SelfContained)' != 'true'">
    <Error Text="A Store package must be self-contained. Build it with scripts/package-store.ps1 (dotnet publish -r win-x64 --self-contained true -p:EnviousWisprPackaged=true)." />
  </Target>

  <PropertyGroup Condition="'$(EnviousWisprPackaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <AssemblyMetadata Include="EnviousWisprReleaseChannel" Value="$(EnviousWisprReleaseChannel)" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnviousWisprPackaged)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Assets\Store\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Brand\EnviousWispr.ico" />
    <None Remove="Assets\Brand\EnviousWisprAppIcon.png" />
    <None Remove="Assets\Brand\EnviousWisprMark.svg" />
    <Content Include="Assets\Brand\EnviousWispr.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\EnviousWisprAppIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\EnviousWisprMark.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnviousWispr.Audio\EnviousWispr.Audio.csproj" />
    <ProjectReference Include="..\EnviousWispr.ASR\EnviousWispr.ASR.csproj" />
    <ProjectReference Include="..\EnviousWispr.Core\EnviousWispr.Core.csproj" />
    <ProjectReference Include="..\EnviousWispr.LLM\EnviousWispr.LLM.csproj" />
    <ProjectReference Include="..\EnviousWispr.ModelDelivery\EnviousWispr.ModelDelivery.csproj" />
    <ProjectReference Include="..\EnviousWispr.Pipeline\EnviousWispr.Pipeline.csproj" />
    <ProjectReference Include="..\EnviousWispr.PostProcessing\EnviousWispr.PostProcessing.csproj" />
    <ProjectReference Include="..\EnviousWispr.Presentation\EnviousWispr.Presentation.csproj" />
    <ProjectReference Include="..\EnviousWispr.RuntimeWorker\EnviousWispr.RuntimeWorker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\EnviousWispr.Services\EnviousWispr.Services.csproj" />
  </ItemGroup>

  <Target Name="CopyRuntimeWorkerForAppBuild" AfterTargets="Build" Condition="'$(SelfContained)' != 'true'">
    <ItemGroup>
      <RuntimeWorkerBuildFiles Include="..\EnviousWispr.RuntimeWorker\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\EnviousWispr.RuntimeWorker*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeWorkerBuildFiles)" DestinationFiles="@(RuntimeWorkerBuildFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="CopyRuntimeWorkerForAppPublish" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <RuntimeWorkerPublishFiles Include="..\EnviousWispr.RuntimeWorker\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\EnviousWispr.RuntimeWorker*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeWorkerPublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

  <!--
    THE STORE PACKAGE IS BUILT FROM THE PUBLISH ITEM LIST, NOT FROM THE PUBLISH FOLDER. The two Copy
    targets above put the worker into the folder AFTER Publish, which the MSIX payload never sees: the
    package carried the worker's apphost, deps and runtimeconfig (the SDK adds those for any referenced
    Exe) but not EnviousWispr.RuntimeWorker.dll, so every start failed and the app said "Local
    transcription could not start". Adding the worker's files as publish items puts them in the package;
    a file the SDK already listed is skipped so the payload never carries one path twice. Ref #42.
  -->
  <Target Name="AddRuntimeWorkerToStorePackage" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(EnviousWisprPackaged)' == 'true'">
    <ItemGroup>
      <_StoreRuntimeWorkerFile Include="..\EnviousWispr.RuntimeWorker\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\EnviousWispr.RuntimeWorker*" Exclude="..\EnviousWispr.RuntimeWorker\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\*.pdb" />
      <_StoreRuntimeWorkerMissing Include="@(_StoreRuntimeWorkerFile->'%(Filename)%(Extension)')" SourcePath="%(FullPath)" />
      <_StoreRuntimeWorkerMissing Remove="@(ResolvedFileToPublish->'%(RelativePath)')" />
      <ResolvedFileToPublish Include="@(_StoreRuntimeWorkerMissing->'%(SourcePath)')" RelativePath="%(Identity)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="'@(_StoreRuntimeWorkerFile)' == ''" Text="The runtime worker was not built for $(RuntimeIdentifier); the Store package would ship without transcription." />
  </Target>

  <Target Name="CopyUnpackagedWinUiResourcesForPublish" AfterTargets="Publish" Condition="'$(EnviousWisprPackaged)' != 'true'">
    <ItemGroup>
      <UnpackagedWinUiResource Include="$(TargetDir)*.xbf" />
      <UnpackagedWinUiResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(UnpackagedWinUiResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
