<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EnviousWispr.App</RootNamespace>
    <AssemblyName>EnviousWispr.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DefaultLanguage>en-US</DefaultLanguage>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>EnviousWispr.App.Program</StartupObject>
    <ApplicationIcon>Assets\Brand\EnviousWispr.ico</ApplicationIcon>
    <Version>0.19.0</Version>
    <EnviousWisprReleaseChannel Condition="'$(EnviousWisprReleaseChannel)' == ''">stable</EnviousWisprReleaseChannel>
  </PropertyGroup>

  <!--
    PACKAGING IS OPT-IN, so one property is the whole difference between the build that ships and the
    build every gate already runs. `validate.ps1` and CI build this project UNPACKAGED today, and step E
    of #42 is what finally retires that path; until then a switch that changed the default would break
    the gate that proves the change. `scripts/package-store.ps1` sets EnviousWisprPackaged=true.
  -->
  <PropertyGroup Condition="'$(EnviousWisprPackaged)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxManifest>Package.appxmanifest</AppxManifest>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <!-- The Store re-signs, and a sideload build is signed explicitly by the packaging script. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnviousWisprPackaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <AssemblyMetadata Include="EnviousWisprReleaseChannel" Value="$(EnviousWisprReleaseChannel)" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnviousWisprPackaged)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Assets\Store\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Brand\EnviousWispr.ico" />
    <None Remove="Assets\Brand\EnviousWisprAppIcon.png" />
    <None Remove="Assets\Brand\EnviousWisprMark.svg" />
    <Content Include="Assets\Brand\EnviousWispr.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\EnviousWisprAppIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\EnviousWisprMark.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnviousWispr.Audio\EnviousWispr.Audio.csproj" />
    <ProjectReference Include="..\EnviousWispr.ASR\EnviousWispr.ASR.csproj" />
    <ProjectReference Include="..\EnviousWispr.Core\EnviousWispr.Core.csproj" />
    <ProjectReference Include="..\EnviousWispr.LLM\EnviousWispr.LLM.csproj" />
    <ProjectReference Include="..\EnviousWispr.ModelDelivery\EnviousWispr.ModelDelivery.csproj" />
    <ProjectReference Include="..\EnviousWispr.Pipeline\EnviousWispr.Pipeline.csproj" />
    <ProjectReference Include="..\EnviousWispr.PostProcessing\EnviousWispr.PostProcessing.csproj" />
    <ProjectReference Include="..\EnviousWispr.RuntimeWorker\EnviousWispr.RuntimeWorker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\EnviousWispr.Services\EnviousWispr.Services.csproj" />
  </ItemGroup>

  <Target Name="CopyRuntimeWorkerForAppBuild" AfterTargets="Build" Condition="'$(SelfContained)' != 'true'">
    <ItemGroup>
      <RuntimeWorkerBuildFiles Include="..\EnviousWispr.RuntimeWorker\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\EnviousWispr.RuntimeWorker*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeWorkerBuildFiles)" DestinationFiles="@(RuntimeWorkerBuildFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="CopyRuntimeWorkerForAppPublish" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <RuntimeWorkerPublishFiles Include="..\EnviousWispr.RuntimeWorker\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\EnviousWispr.RuntimeWorker*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeWorkerPublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="CopyUnpackagedWinUiResourcesForPublish" AfterTargets="Publish">
    <ItemGroup>
      <UnpackagedWinUiResource Include="$(TargetDir)*.xbf" />
      <UnpackagedWinUiResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(UnpackagedWinUiResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
