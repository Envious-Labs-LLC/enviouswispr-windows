                                                <Border Width="288" Height="58" Background="{ThemeResource BrandSidebarBgBrush}" CornerRadius="29" Padding="16,10">
                                                    <Grid ColumnSpacing="{StaticResource BrandSpacingS}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Foreground="{ThemeResource BrandTextPrimaryBrush}" FontFamily="Consolas" Style="{StaticResource BrandRowLabelStyle}" Text="00:12" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Height="25" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center"><Border Width="4" Height="8" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="13" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="19" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="11" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="22" Background="{ThemeResource BrandSpectrumSpringBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="16" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="9" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="20" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="14" Background="{ThemeResource BrandSpectrumRedBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="7" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="17" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="2" VerticalAlignment="Center" /><Border Width="4" Height="10" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="2" VerticalAlignment="Center" /></StackPanel></Grid>
