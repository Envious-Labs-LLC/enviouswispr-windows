                                                    <Grid ColumnSpacing="{StaticResource BrandSpacingS}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="27" Height="16"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="{ThemeResource BrandSpectrumVioletColor}" Offset="0" /><GradientStop Color="{ThemeResource BrandSpectrumBlueColor}" Offset="0.35" /><GradientStop Color="{ThemeResource BrandSpectrumSpringColor}" Offset="0.7" /><GradientStop Color="{ThemeResource BrandSpectrumGoldColor}" Offset="1" /></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Grid.Column="1" Foreground="{ThemeResource BrandTextPrimaryBrush}" FontFamily="Consolas" Style="{StaticResource BrandRowLabelStyle}" Text="00:12" VerticalAlignment="Center" /></Grid>
