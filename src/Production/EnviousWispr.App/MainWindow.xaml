                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource BrandAccentLightColor}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.86" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.72" />
                    <SolidColorBrush x:Key="ListViewItemForeground" Color="{ThemeResource BrandTextPrimaryColor}" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{ThemeResource BrandTextPrimaryColor}" />
                    <SolidColorBrush x:Key="ListViewItemFocusVisualPrimaryBrush" Color="{ThemeResource BrandAccentColor}" />
                    <SolidColorBrush x:Key="ListViewItemFocusVisualSecondaryBrush" Color="{ThemeResource BrandCardBgColor}" />
                    <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="{ThemeResource BrandAccentColor}" />
                    <SolidColorBrush x:Key="ListViewItemFocusSecondaryBorderBrush" Color="{ThemeResource BrandCardBgColor}" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource BrandAccentSolidColor}" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="{ThemeResource BrandAccentSolidColor}" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="{ThemeResource BrandAccentSolidColor}" Opacity="0.78" />

                    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{ThemeResource BrandErrorSoftColor}" />
                    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{ThemeResource BrandWarningSoftColor}" />
                    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{ThemeResource BrandSuccessSoftColor}" />
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource BrandAccentLightColor}" />
                    <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="{ThemeResource BrandErrorColor}" />
                    <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="{ThemeResource BrandWarningColor}" />
                    <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="{ThemeResource BrandSuccessColor}" />
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="{ThemeResource BrandAccentSolidColor}" />
                    <SolidColorBrush x:Key="InfoBarTitleForeground" Color="{ThemeResource BrandTextPrimaryColor}" />
                    <SolidColorBrush x:Key="InfoBarMessageForeground" Color="{ThemeResource BrandTextBodyColor}" />
                    <SolidColorBrush x:Key="InfoBarHyperlinkButtonForeground" Color="{ThemeResource BrandAccentColor}" />
                    <SolidColorBrush x:Key="InfoBarBorderBrush" Color="{ThemeResource BrandDividerColor}" />

                    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource BrandAccentColor}" />
                    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource BrandAccentColor}" Opacity="0.86" />
                    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource BrandAccentColor}" Opacity="0.72" />
                    <SolidColorBrush x:Key="HyperlinkButtonBackground" Color="{StaticResource BrandTransparentColor}" />
                    <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="{ThemeResource BrandAccentLightColor}" />
                    <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.72" />
                    <SolidColorBrush x:Key="HyperlinkButtonBorderBrush" Color="{StaticResource BrandTransparentColor}" />
                    <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPointerOver" Color="{ThemeResource BrandDividerColor}" />
                    <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPressed" Color="{ThemeResource BrandAccentColor}" />

                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <!--
            A ZERO-SIZE SWATCH WHOSE ONLY JOB IS TO RESOLVE A THEME COLOUR TO A NUMBER. The window's
            caption buttons are drawn by Windows, not by XAML, so their colour has to be handed over
            as a literal - and hard-coding the two values here would put a second copy of the text
            colour in the codebase, which is how a palette drifts. Reading it off an element bound to
            the same ThemeResource keeps one source, and it re-resolves on every theme change for
            free.
        -->
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="ThemeColorProbe" Width="0" Height="0" IsHitTestVisible="False" Background="{ThemeResource BrandTextPrimaryBrush}" />
        <Border x:Name="KeybindErrorProbe" Width="0" Height="0" IsHitTestVisible="False" Background="{ThemeResource BrandErrorBrush}" />
        <Border x:Name="KeybindListeningProbe" Width="0" Height="0" IsHitTestVisible="False" Background="{ThemeResource BrandAccentBrush}" BorderBrush="{ThemeResource BrandAccentLightBrush}" />
        <Border x:Name="KeybindDefaultBgProbe" Width="0" Height="0" IsHitTestVisible="False" Background="{ThemeResource BrandPageBgBrush}" />
        <!--
            The top bar carries the EnviousWispr brand identity and real app version on the left, and the
            streamlined release notes, feedback, and record actions on the right.
        -->
        <TitleBar x:Name="AppTitleBar" AutomationProperties.Name="EnviousWispr window title" IsTabStop="False">
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Width="{StaticResource BrandTitleBarLogoSize}" Height="{StaticResource BrandTitleBarLogoSize}" AutomationProperties.AccessibilityView="Raw" Source="Assets/Brand/EnviousWisprMark.svg" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="EnviousWispr" VerticalAlignment="Center" />
                    <Border x:Name="TitleBarVersionBadge" Style="{StaticResource BrandAccentChipStyle}" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleBarVersionText" Text="" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandAccentBrush}" />
                    </Border>
                </StackPanel>
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="WhatsNewToolbarButton" AutomationProperties.Name="What’s New" ToolTipService.ToolTip="What’s New" Click="WhatsNewToolbarButton_Click" Style="{StaticResource BrandQuietButtonStyle}" Padding="{StaticResource BrandToolbarButtonPadding}">
                        <Grid>
                            <Border x:Name="WhatsNewBadge" Width="7" Height="7" CornerRadius="4" Background="{ThemeResource BrandAccentBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-3,-4,0" Visibility="Collapsed" />
                            <FontIcon Glyph="&#xE789;" FontSize="14" />
                        </Grid>
                    </Button>
                    <Button x:Name="FeedbackToolbarButton" AutomationProperties.Name="Feedback" ToolTipService.ToolTip="Send Feedback" Click="FeedbackToolbarButton_Click" Style="{StaticResource BrandQuietButtonStyle}" Padding="{StaticResource BrandToolbarButtonPadding}">
                        <FontIcon Glyph="&#xED15;" FontSize="14" />
                    </Button>
                    <Button x:Name="RecordToolbarButton" AutomationProperties.Name="Record dictation" ToolTipService.ToolTip="Toggle dictation recording" Click="RecordToolbarButton_Click" Style="{StaticResource BrandPrimaryButtonStyle}" Padding="{StaticResource BrandRecordToolbarButtonPadding}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                            <FontIcon x:Name="RecordToolbarButtonIcon" Glyph="&#xE720;" FontSize="14" />
                            <TextBlock x:Name="RecordToolbarButtonText" Text="Record" Style="{StaticResource BrandRowLabelStyle}" Foreground="{ThemeResource BrandOnAccentBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid x:Name="ShellContentGrid" Grid.Row="1">
            <!--
                THE PRIMARY ACTION IS PINNED, NOT SCROLLED. Read out of the app's own accessibility
                tree on a 1024x768 desktop: "Get started" was OFFSCREEN, and so were the microphone
                status and the push-to-talk explanation. Any laptop 768 pixels tall lands there, and
                a first-run screen whose only way forward is below the fold reads as a screen with
                no way forward. There was a Ctrl+Enter accelerator and an access key, which help
                somebody who already knows they exist.

                The window height cannot solve this: it is already clamped to the work area, so on a
                short screen the content is what has to give. Pinning the action means what gives is
                the reading matter above it, which is the right way round.
            -->
            <Grid x:Name="OnboardingView" Background="{ThemeResource BrandPageBgBrush}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--
                    FIVE SCREENS IN ONE VIEW, IN THE macOS ORDER: welcome, setting up (the speech model, then
                    the one Windows permission), ready, warming up, and a practice box. One header card
                    carries every screen's title so the heading a screen reader lands on is always in the
                    same place; each screen's content is a panel below it, and exactly one is visible. What
                    moves the flow on is OnboardingFlow in Presentation, where the gates and every Windows
                    difference are decided and tested.
                -->
                <ScrollViewer x:Name="OnboardingScroll" AutomationProperties.Name="EnviousWispr setup" HorizontalScrollMode="Disabled">
                <!--
                    ONE MEASURE FOR EVERY SCREEN, CENTRED. A capped element centred by its own alignment is
                    only as wide as its content, so the column changed width from screen to screen - the
                    welcome's long lines filled it and the warm-up's short ones did not - and the frame
                    appeared to jump as the flow moved on. Capping a star column between two star gutters
                    keeps the same width on every screen and still centres it, the way the settings pages
                    cap theirs.
                -->
                <Grid x:Name="OnboardingContent" Padding="{StaticResource BrandOnboardingContentPadding}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100*" MaxWidth="{StaticResource BrandOnboardingContentColumnMaxWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSectionSpacing}">
                        <Border Style="{StaticResource BrandHeaderCardStyle}">
                            <Grid ColumnSpacing="{StaticResource BrandOnboardingWideSpacing}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Image Width="{StaticResource BrandOnboardingMarkSize}" Height="{StaticResource BrandOnboardingMarkSize}" AutomationProperties.AccessibilityView="Raw" Source="Assets/Brand/EnviousWisprMark.svg" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                    <TextBlock x:Name="OnboardingStepText" Style="{StaticResource BrandHelperStyle}" Text="Step 1 of 5" />
                                    <TextBlock x:Name="OnboardingTitle" x:Uid="OnboardingTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource BrandPageTitleStyle}" Text="Your voice, instantly captured." TextWrapping="Wrap" />
                                    <TextBlock x:Name="OnboardingSubtitle" Style="{StaticResource BrandBodyStyle}" Text="The privacy-first dictation app built for Windows." TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <InfoBar x:Name="OnboardingReliabilityInfoBar" IsClosable="False" IsOpen="False" Severity="Warning" />

                        <!-- 1. WELCOME. macOS's four feature cards, in its order and words where they are true here. -->
                        <StackPanel x:Name="OnboardingWelcomePanel" Spacing="{StaticResource BrandOnboardingCardSpacing}">
                            <Border Style="{StaticResource BrandHeaderCardStyle}">
                                <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                        <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE72E;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="On-Device" />
                                        <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Your voice never leaves your PC." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BrandHeaderCardStyle}">
                                <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                        <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE709;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Offline-Ready" />
                                        <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Works without internet." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BrandHeaderCardStyle}">
                                <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                        <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE945;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Native Speed" />
                                        <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Built for Windows, on your graphics card or processor." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource BrandHeaderCardStyle}">
                                <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                        <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE77B;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Free &amp; Private" />
                                        <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Audio stays on this PC; dictated text stays local unless you turn on cloud polish. Anonymous usage metrics and crash reports are on by default to help us catch broken updates, and can be turned off anytime in Diagnostics." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- SAID AT THE FIRST RUN BECAUSE UNINSTALLING CANNOT SAY IT. The Store package has no uninstall hook and the data folder survives it (#42), so this is the one moment the app is sure to be heard before it matters. -->
                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Uninstalling keeps your history and downloaded models. To remove them, use Delete all EnviousWispr data on the Backup page before you uninstall." TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 2a. SETTING UP: the speech model, which is the gate, and the recording key, which is reported. -->
                        <StackPanel x:Name="OnboardingChecklistPanel" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                            <Border Padding="{StaticResource BrandOnboardingCardPadding}" Style="{StaticResource BrandSectionCardStyle}">
                                <StackPanel Spacing="{StaticResource BrandSectionSpacing}">
                                    <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Width="{StaticResource BrandOnboardingStatusSize}" Height="{StaticResource BrandOnboardingStatusSize}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                                            <TextBlock x:Name="OnboardingModelPendingMark" HorizontalAlignment="Center" Style="{StaticResource BrandRowLabelStyle}" Text="1" VerticalAlignment="Center" />
                                            <ProgressRing x:Name="OnboardingModelWorkingMark" Foreground="{ThemeResource BrandAccentBrush}" IsActive="False" Visibility="Collapsed" />
                                            <FontIcon x:Name="OnboardingModelDoneMark" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" />
                                            <FontIcon x:Name="OnboardingModelErrorMark" Foreground="{ThemeResource BrandErrorBrush}" Glyph="&#xE711;" Visibility="Collapsed" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Setting up speech model" />
                                            <TextBlock x:Name="OnboardingModelText" Style="{StaticResource BrandBodyStyle}" Text="One-time setup" TextWrapping="Wrap" />
                                            <ProgressBar x:Name="OnboardingModelProgress" AutomationProperties.Name="Speech model download" Background="{ThemeResource BrandDividerBrush}" Foreground="{ThemeResource BrandAccentSolidBrush}" Maximum="100" Minimum="0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Width="{StaticResource BrandOnboardingStatusSize}" Height="{StaticResource BrandOnboardingStatusSize}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                                            <TextBlock x:Name="OnboardingKeyPendingMark" HorizontalAlignment="Center" Style="{StaticResource BrandRowLabelStyle}" Text="2" VerticalAlignment="Center" />
                                            <FontIcon x:Name="OnboardingKeyDoneMark" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" />
                                            <FontIcon x:Name="OnboardingKeyErrorMark" Foreground="{ThemeResource BrandErrorBrush}" Glyph="&#xE711;" Visibility="Collapsed" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Setting your keybind" />
                                            <TextBlock x:Name="OnboardingHotkeyText" Style="{StaticResource BrandBodyStyle}" Text="Getting your keybind ready…" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="OnboardingSetupNote" AutomationProperties.LiveSetting="Assertive" Style="{StaticResource BrandBodyStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingM}">
                                <Button x:Name="OnboardingRetryButton" Click="OnboardingRetryButton_Click" Content="Retry" Style="{StaticResource BrandPrimaryButtonStyle}" Visibility="Collapsed" />
                                <Button x:Name="OnboardingCancelSetupButton" AutomationProperties.HelpText="Pauses the speech model download. It resumes from where it stopped when you start it again." Click="OnboardingCancelSetupButton_Click" Content="Cancel" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 2b. THE ONE PERMISSION. macOS asks for two; Windows has only the microphone switch. -->
                        <StackPanel x:Name="OnboardingPermissionPanel" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                            <Border Padding="{StaticResource BrandOnboardingCardPadding}" Style="{StaticResource BrandSectionCardStyle}">
                                <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Top">
                                        <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE720;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Microphone" />
                                        <TextBlock Style="{StaticResource BrandBodyStyle}" Text="To hear your voice for transcription." TextWrapping="Wrap" />
                                        <TextBlock x:Name="OnboardingMicrophoneText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" Text="Checking Windows audio devices…" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border x:Name="OnboardingMicrophoneAllowedBadge" Style="{StaticResource BrandSuccessChipStyle}" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}"><Ellipse Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandSuccessBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" /><TextBlock Style="{StaticResource BrandStatusChipTextStyle}" Foreground="{ThemeResource BrandSuccessBrush}" Text="Allowed" /></StackPanel></Border>

                                        <Button x:Name="OnboardingMicrophonePrivacyButton" AutomationProperties.HelpText="Opens the Windows microphone privacy page, where the switch for desktop apps is turned on." Click="OpenMicrophonePrivacyButton_Click" Content="Turn on" Style="{StaticResource BrandPrimaryButtonStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Windows lets EnviousWispr paste into other apps without a separate permission, so this is the only one." TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 3. READY. The key the app is listening for, shown the way macOS shows its keycap. -->
                        <StackPanel x:Name="OnboardingReadyPanel" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                            <Border Padding="{StaticResource BrandOnboardingCardPadding}" Style="{StaticResource BrandSectionCardStyle}">
                                <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingM}">
                                    <Border x:Name="OnboardingKeycap" HorizontalAlignment="Center" Padding="{StaticResource BrandOnboardingKeycapPadding}" Background="{ThemeResource BrandAccentLightBrush}" BorderBrush="{ThemeResource BrandAccentBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}">
                                        <TextBlock x:Name="OnboardingKeycapText" Foreground="{ThemeResource BrandAccentBrush}" HorizontalAlignment="Center" Style="{StaticResource BrandPageTitleStyle}" Text="Ctrl+Win" />
                                    </Border>
                                    <TextBlock x:Name="OnboardingKeyUsageText" HorizontalAlignment="Center" Style="{StaticResource BrandBodyStyle}" Text="Hold to dictate. Release to transcribe." TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock x:Name="OnboardingHandsFreeText" HorizontalAlignment="Center" Foreground="{ThemeResource BrandAccentBrush}" Style="{StaticResource BrandBodyStyle}" Text="Double-press to go hands-free." TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Change it any time on the Keybinds page. A new key starts working the next time EnviousWispr opens." TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource BrandRowLabelStyle}" Text="POWER USER?" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Change your AI model, keybind, and more in Settings." TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. WARMING UP. Opens only on an engine that says it is ready. -->
                        <StackPanel x:Name="OnboardingWarmingPanel" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                            <StackPanel x:Name="OnboardingWarmingActivity" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                <ProgressRing x:Name="OnboardingWarmingRing" Foreground="{ThemeResource BrandAccentBrush}" IsActive="False" Width="{StaticResource BrandOnboardingStatusSize}" Height="{StaticResource BrandOnboardingStatusSize}" />
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Loading the speech model" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="OnboardingWarmingFailure" Padding="{StaticResource BrandOnboardingCardPadding}" Background="{ThemeResource BrandErrorSoftBrush}" CornerRadius="{StaticResource BrandSectionRadius}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingM}">
                                    <TextBlock x:Name="OnboardingWarmingFailureText" AutomationProperties.LiveSetting="Assertive" HorizontalAlignment="Center" Style="{StaticResource BrandBodyStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <Button x:Name="OnboardingWarmingRetryButton" Click="OnboardingRetryButton_Click" Content="TRY AGAIN" HorizontalAlignment="Center" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="{StaticResource BrandOnboardingCardPadding}" Style="{StaticResource BrandSectionCardStyle}">
                                <StackPanel Spacing="{StaticResource BrandSpacingM}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                        <Grid Width="{StaticResource BrandOnboardingStatusSize}" AutomationProperties.AccessibilityView="Raw"><FontIcon x:Name="OnboardingWarmMicMark" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" /><FontIcon x:Name="OnboardingWarmMicPending" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xEA3A;" /></Grid>
                                        <TextBlock x:Name="OnboardingWarmMicText" Style="{StaticResource BrandBodyStyle}" Text="Microphone ready" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                        <Grid Width="{StaticResource BrandOnboardingStatusSize}" AutomationProperties.AccessibilityView="Raw"><FontIcon x:Name="OnboardingWarmKeyMark" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" /><FontIcon x:Name="OnboardingWarmKeyPending" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xEA3A;" /></Grid>
                                        <TextBlock x:Name="OnboardingWarmKeyText" Style="{StaticResource BrandBodyStyle}" Text="Your shortcut is set" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                        <Grid Width="{StaticResource BrandOnboardingStatusSize}" AutomationProperties.AccessibilityView="Raw"><FontIcon x:Name="OnboardingWarmEngineMark" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" /><FontIcon x:Name="OnboardingWarmEnginePending" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xEA3A;" /></Grid>
                                        <TextBlock x:Name="OnboardingWarmEngineText" Style="{StaticResource BrandBodyStyle}" Text="Speech engine" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="OnboardingWarmingCaption" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="This usually takes a moment. Nothing else is needed from you." TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 5. PRACTICE. EnviousWispr's own text box, which ordinary delivery writes into like any other. -->
                        <StackPanel x:Name="OnboardingPracticePanel" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                            <TextBox x:Name="OnboardingPracticeBox" AcceptsReturn="True" AutomationProperties.Name="Your first dictation" MinHeight="{StaticResource BrandOnboardingPracticeBoxHeight}" TextChanged="OnboardingPracticeBox_TextChanged" TextWrapping="Wrap" />
                            <TextBlock x:Name="OnboardingPracticeFootnote" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Your recording indicator appears while you hold the key." TextAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="OnboardingPracticeMicrophoneButton" AutomationProperties.HelpText="Opens the Windows microphone privacy page, where the switch for desktop apps is turned on." Click="OpenMicrophonePrivacyButton_Click" Content="Turn on the microphone" HorizontalAlignment="Center" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
                <!--
                    THE CAP AND THE PADDING SIT ON THE SAME ELEMENT, WHICH IS WHAT KEEPS THE BUTTON
                    LINED UP WITH THE CARDS. The scrolling content caps at 1040 and pads 40 a side,
                    so a card is 960 wide. Padding the Border and capping its child instead let the
                    button reach the full 1040 and hang 40 pixels past the cards on a wide window.

                    THE PRIMARY ACTION IS PINNED, NOT SCROLLED: on a 768-pixel laptop a first-run
                    screen whose only way forward is below the fold reads as a screen with no way
                    forward. Its words change with the screen; its place does not.
                -->
                <Border x:Name="OnboardingFooter" Grid.Row="1" Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="0,1,0,0">
                    <Grid MaxWidth="{StaticResource BrandOnboardingContentMaxWidth}" Padding="{StaticResource BrandOnboardingFooterPadding}">
                    <StackPanel Spacing="{StaticResource BrandSpacingS}">
                        <Button x:Name="FinishOnboardingButton" AccessKey="G" AutomationProperties.HelpText="Moves to the next setup step. Press Control plus Enter from anywhere on this screen." Click="FinishOnboardingButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource BrandPrimaryButtonStyle}" Content="Get Started">
                            <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control" /></Button.KeyboardAccelerators>
                        </Button>
                        <HyperlinkButton x:Name="OnboardingSkipButton" Click="OnboardingSkipButton_Click" Content="Skip this step" HorizontalAlignment="Center" Style="{StaticResource BrandHyperlinkButtonStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="OnboardingFooterText" Style="{StaticResource BrandHelperStyle}" Text="You can change every choice later in Settings. No account is required." TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <NavigationView x:Name="ProductNavigation" AutomationProperties.Name="EnviousWispr navigation" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" OpenPaneLength="240" PaneDisplayMode="Left" SelectionChanged="ProductNavigation_SelectionChanged">
                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource BrandSidebarBgColor}" Opacity="0.6" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource BrandSidebarBgColor}" Opacity="0.6" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource BrandPageBgColor}" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{ThemeResource BrandDividerColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="{ThemeResource BrandSidebarBgColor}" Opacity="0" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource BrandAccentColor}" Opacity="0.12" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{ThemeResource BrandAccentColor}" Opacity="0.20" />
                    <!--
                        THE SELECTED ROW IS A SUBTLE RAISE, AND THE ACCENT LIVES IN THE PILL. This
                        used to be a fully filled accent bar with white text, which is a list-view or
                        web pattern rather than a Windows one - and it is also why the selection
                        appeared to teleport between rows. Windows animates the little accent
                        indicator from the old row to the new one; a filled row has no indicator to
                        move, so there was nothing to animate and the change read as a jump.
                        Using the card colour here means the selected row reads as lifted off the
                        sidebar the same way every card in the window reads as lifted off the page.
                    -->
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource BrandCardBgColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource BrandCardBgColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource BrandCardBgColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource BrandTextBodyColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource BrandTextBodyColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{ThemeResource BrandTextBodyColor}" />
                    <!--
                        A selected label stays the ordinary text colour and is distinguished by the
                        pill and the raise, not by being repainted. White-on-accent only worked
                        because the row behind it was filled.
                    -->
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource BrandTextPrimaryColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource BrandTextPrimaryColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource BrandTextPrimaryColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="{ThemeResource BrandTextSecondaryColor}" />
                    <!--
                        THE PILL, AND IT IS THE ONLY ACCENT-COLOURED THING IN THE SIDEBAR NOW. It was
                        white, which is invisible against a filled accent row - the indicator was
                        there the whole time and could not be seen, which is the other half of why
                        the selection looked like it snapped.
                    -->
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource BrandAccentColor}" />
                    <Style TargetType="NavigationViewItem">
                        <Setter Property="Height" Value="{StaticResource BrandNavRowHeight}" />
                        <Setter Property="MinHeight" Value="{StaticResource BrandNavRowHeight}" />
                    </Style>
                    <Style TargetType="NavigationViewItemHeader">
                        <!-- No Height. The heading is sized by its own text; the block is made
                             shorter with margin. A fixed height here clipped the glyphs. -->
                        <Setter Property="Margin" Value="{StaticResource BrandNavGroupHeaderMargin}" />
                    </Style>
                    <DataTemplate x:Key="BrandNavigationGroupHeaderTemplate">
                        <TextBlock Style="{StaticResource BrandNavGroupLabelStyle}" Text="{Binding}" />
                    </DataTemplate>
                    <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">1,1,0,0</Thickness>
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
                    <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                    <Thickness x:Key="NavigationViewPaneContentGridMargin">0</Thickness>
                </NavigationView.Resources>
                <NavigationView.PaneHeader>
                    <AutoSuggestBox x:Name="SidebarSearchBox" AutomationProperties.Name="Search settings" PlaceholderText="Search settings" QueryIcon="Find" TextChanged="SidebarSearchBox_TextChanged" SuggestionChosen="SidebarSearchBox_SuggestionChosen" Margin="0,8,0,8" />
                </NavigationView.PaneHeader>
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="HistoryNavItem" x:Uid="HistoryNavItem" AccessKey="Y" Content="History" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="history">
                        <NavigationViewItem.Icon><FontIcon x:Name="HistoryNavGlyph" Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemHeader Content="Record" ContentTemplate="{StaticResource BrandNavigationGroupHeaderTemplate}" />
                    <NavigationViewItem x:Name="DictationSettingsNavItem" Content="Dictation Settings" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="settings-dictation">
                        <NavigationViewItem.Icon><FontIcon x:Name="SettingsDictationNavGlyph" Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="KeybindsNavItem" Content="Keybinds" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="settings-keybinds">
                        <NavigationViewItem.Icon><FontIcon x:Name="SettingsKeybindsNavGlyph" Glyph="&#xE765;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="TranscribeFileNavItem" Content="Transcribe a File" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="settings-transcribe-file">
                        <NavigationViewItem.Icon><FontIcon x:Name="SettingsTranscribeFileNavGlyph" Glyph="&#xE8E5;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemHeader Content="Process" ContentTemplate="{StaticResource BrandNavigationGroupHeaderTemplate}" />
                    <NavigationViewItem x:Name="AiPolishNavItem" Content="AI Polish" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="settings-ai-polish">
                        <NavigationViewItem.Icon><FontIcon x:Name="SettingsAiPolishNavGlyph" Glyph="&#xE70F;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="DictionaryNavItem" x:Uid="DictionaryNavItem" AccessKey="D" Content="Your Words" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="dictionary">
                        <NavigationViewItem.Icon><FontIcon x:Name="DictionaryNavGlyph" Glyph="&#xE736;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="SnippetsNavItem" x:Uid="SnippetsNavItem" AccessKey="S" Content="Snippets" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="snippets">
                        <NavigationViewItem.Icon><FontIcon x:Name="SnippetsNavGlyph" Glyph="&#xE70B;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemHeader Content="System" ContentTemplate="{StaticResource BrandNavigationGroupHeaderTemplate}" />
                    <NavigationViewItem x:Name="AppSettingsNavItem" Content="App Settings" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="settings-app">
                        <NavigationViewItem.Icon><FontIcon x:Name="SettingsAppNavGlyph" Glyph="&#xE713;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="DiagnosticsNavItem" Content="Diagnostics" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="settings-diagnostics">
                        <NavigationViewItem.Icon><FontIcon x:Name="SettingsDiagnosticsNavGlyph" Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Name="HelpNavItem" x:Uid="HelpNavItem" AccessKey="P" Content="Help and privacy" FocusVisualPrimaryBrush="{ThemeResource BrandOnAccentBrush}" FocusVisualSecondaryBrush="{ThemeResource BrandTextPrimaryBrush}" Tag="help">
                        <NavigationViewItem.Icon><FontIcon x:Name="HelpNavGlyph" Glyph="&#xE897;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <Grid x:Name="MainContentGrid" Padding="28,18,28,32">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <InfoBar Grid.Row="0" x:Name="OperationInfoBar" Margin="0,0,0,12" IsOpen="False" IsClosable="True" VerticalAlignment="Top" />

                    <ScrollViewer Grid.Row="1" x:Name="WhatsNewPage" AutomationProperties.Name="What’s New page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource BrandFluentPageMaxWidth}" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" Spacing="{StaticResource BrandSpacingL}">
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource BrandPageTitleStyle}" Text="What’s New" />
                                <TextBlock Style="{StaticResource BrandBodyStyle}" Text="The latest improvements and fixes in this release." TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}">
                                <StackPanel Spacing="{StaticResource BrandSpacingS}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Version 0.19.0" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource BrandAccentChipStyle}">
                                            <TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Windows 11 Fluent" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Text="A major Windows 11 native Fluent refresh bringing desktop parity, streamlined vocabulary tools, and hands-free dictation controls." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}">
                                <StackPanel Spacing="{StaticResource BrandSpacingM}">
                                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Experience and Workspace" />
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE790;" />
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Native Windows 11 Fluent design &amp; Mica shell" />
                                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Updated navigation, typography, light and dark themes, and Mica backdrop across settings and tools." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE81C;" />
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Two-pane History diary &amp; built-in Feedback dialog" />
                                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Browse dictations beside a full-height detail pane with one-click copy, paste, repolish, and in-app feedback reporting." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE720;" />
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="System tray waveform icon &amp; Fluent tray menu" />
                                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="At-a-glance listening status in the notification area with dark-mode native menu actions for your last dictation." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}">
                                <StackPanel Spacing="{StaticResource BrandSpacingM}">
                                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Dictation, Controls, and Polish" />
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE765;" />
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Keybind capture &amp; hands-free Auto-Stop" />
                                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Press shortcuts directly to assign Push to Talk, Toggle, Cancel, Quick Add, and reuse keys, with configurable silence Auto-Stop." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE890;" />
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Recording Pill &amp; live Reading Well preview" />
                                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Choose Classic or Level Rail pill styles, top or bottom placement, and optional live transcript preview while speaking." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE8D2;" />
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Local dictation &amp; AI Polish" />
                                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Run Parakeet or Whisper locally on your PC, keep custom words and snippets on-device, and optionally polish with EG-1, Ollama, or your cloud key." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="WhatsNewBuildInfoText" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="1" x:Name="HistoryPage" AutomationProperties.Name="History page" Background="{ThemeResource BrandPageBgBrush}" Visibility="Collapsed">
                        <Grid HorizontalAlignment="Stretch" MaxWidth="{StaticResource BrandFluentPageMaxWidth}" Margin="24,18,24,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header: Compact recovery row, tabs, search, filter controls, and bulk selection toolbar -->
                            <StackPanel Grid.Row="0" Spacing="{StaticResource BrandSpacingM}" Margin="0,0,0,12">
                                <Border x:Name="RecoveryCard" AutomationProperties.Name="Recovered unfinished dictation" Margin="0" Padding="14,10" Style="{StaticResource BrandSectionCardStyle}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" Visibility="Collapsed">
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" CornerRadius="2" Background="{ThemeResource BrandWarningBrush}" Margin="0,2" IsHitTestVisible="False" />
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                            <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                                    <TextBlock x:Name="RecoveryTitleText" Style="{StaticResource BrandRowLabelStyle}" Text="Recovered unfinished dictation" />
                                                    <TextBlock x:Name="RecoveryBodyText" Style="{StaticResource BrandHelperStyle}" Text="Review it here; it will never be pasted automatically." TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                                    <Button x:Name="UndoRecoveryButton" AutomationProperties.AutomationId="UndoRecoveryButton" AutomationProperties.HelpText="Pastes the cancelled dictation back where you were dictating." Click="UndoRecoveryButton_Click" Content="Undo" Padding="10,4" Style="{StaticResource BrandPrimaryButtonStyle}" Visibility="Collapsed" />
                                                    <Button x:Name="CopyRecoveryButton" Click="CopyRecoveryButton_Click" Padding="10,4" Style="{StaticResource BrandQuietButtonStyle}" AutomationProperties.Name="Copy recovered text">
                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                                            <FontIcon x:Name="CopyRecoveryIcon" FontSize="14" Glyph="&#xE8C8;" />
                                                            <TextBlock x:Name="CopyRecoveryLabel" Text="Copy recovered text" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="DeleteRecoveryButton_Click" Content="Delete" Padding="10,4" Style="{StaticResource BrandQuietButtonStyle}" AutomationProperties.Name="Delete recovery copy" />
                                                </StackPanel>
                                            </Grid>
                                            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="RecoveryTextBox" AutomationProperties.Name="Recovered dictation text" IsTextSelectionEnabled="True" Foreground="{ThemeResource BrandTextPrimaryBrush}" Style="{StaticResource BrandBodyStyle}" TextAlignment="DetectFromContent" TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Tab strip + active engine / polish summary + matching item count badge -->
                                <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                        <Button x:Name="HistoryFilterDictationButton" Content="Dictations" ToolTipService.ToolTip="Dictations (D)" Click="HistoryFilterButton_Click" Tag="Dictation" Style="{StaticResource BrandTabStripActiveButtonStyle}" Padding="12,6" />
                                        <Button x:Name="HistoryFilterTranscribeButton" Content="Transcribed Files" ToolTipService.ToolTip="Transcribed files (T)" Click="HistoryFilterButton_Click" Tag="TranscribeFile" Style="{StaticResource BrandTabStripButtonStyle}" Padding="12,6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center">
                                        <Border Style="{StaticResource BrandNeutralChipStyle}" ToolTipService.ToolTip="Active speech engine and AI polish provider">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                                <TextBlock x:Name="HistoryEngineStatusText" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Parakeet" />
                                                <TextBlock Style="{StaticResource BrandNeutralChipTextStyle}" Text="·" />
                                                <TextBlock x:Name="HistoryPolishStatusText" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Off" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource BrandNeutralChipStyle}">
                                            <TextBlock x:Name="HistoryCountText" Style="{StaticResource BrandNeutralChipTextStyle}" Text="0 items" AutomationProperties.Name="Matching history count" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Search row -->
                                <Grid>
                                    <TextBox x:Name="HistorySearchBox" AutomationProperties.Name="Search dictation history" PlaceholderText="Search transcript text, original words, engine, or model" Padding="12,8,44,8" TextChanged="HistorySearchBox_TextChanged" />
                                    <Button x:Name="InlineClearHistorySearchButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Padding="8,4" Visibility="Collapsed" Click="ClearHistorySearchButton_Click" Style="{StaticResource BrandQuietButtonStyle}" AutomationProperties.Name="Clear search" ToolTipService.ToolTip="Clear search">
                                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>

                                <!-- Filter & selection controls bar -->
                                <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center">
                                        <Button x:Name="HistoryDateFilterButton" Style="{StaticResource BrandQuietButtonStyle}" Padding="12,6" AutomationProperties.Name="Filter by date">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                                <FontIcon FontSize="14" Glyph="&#xE787;" />
                                                <TextBlock x:Name="HistoryDateFilterText" Text="Any time" VerticalAlignment="Center" />
                                                <FontIcon FontSize="14" Glyph="&#xE70D;" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout x:Name="HistoryDateFilterFlyout" Placement="BottomEdgeAlignedLeft">
                                                    <MenuFlyoutItem Text="Any time" Tag="AnyTime" Click="HistoryDateFilterItem_Click" />
                                                    <MenuFlyoutItem Text="Today" Tag="Today" Click="HistoryDateFilterItem_Click" />
                                                    <MenuFlyoutItem Text="Yesterday" Tag="Yesterday" Click="HistoryDateFilterItem_Click" />
                                                    <MenuFlyoutItem Text="Last 7 days" Tag="Last7Days" Click="HistoryDateFilterItem_Click" />
                                                    <MenuFlyoutItem Text="Last 30 days" Tag="Last30Days" Click="HistoryDateFilterItem_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button x:Name="ResetHistoryFiltersBarButton" Content="Clear filters" Style="{StaticResource BrandQuietButtonStyle}" Padding="10,6" Click="ClearHistoryFiltersButton_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center">
                                        <Button x:Name="HistorySelectToggleButton" Style="{StaticResource BrandQuietButtonStyle}" Padding="12,6" Click="HistorySelectToggleButton_Click" AutomationProperties.Name="Select dictations">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                                <FontIcon FontSize="14" Glyph="&#xE762;" />
                                                <TextBlock x:Name="HistorySelectToggleText" Text="Select" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="HistoryHelpButton" Style="{StaticResource BrandQuietButtonStyle}" Padding="10,6" Click="HistoryHelpButton_Click" AutomationProperties.Name="How History works" ToolTipService.ToolTip="How History works">
                                            <FontIcon FontSize="14" Glyph="&#xE897;" />
                                            <Button.Flyout>
                                                <Flyout x:Name="HistoryHelpFlyout" Placement="BottomEdgeAlignedRight">
                                                    <StackPanel Width="340" Spacing="{StaticResource BrandSpacingM}">
                                                        <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="How History works" />
                                                        <ItemsControl x:Name="HistoryHelpItemsControl">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid ColumnSpacing="{StaticResource BrandSpacingS}" Margin="0,0,0,10">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" Glyph="{Binding Glyph}" />
                                                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="{Binding Title}" TextWrapping="Wrap" />
                                                                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="{Binding Body}" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button x:Name="HistoryMoreButton" Style="{StaticResource BrandQuietButtonStyle}" Padding="10,6" AutomationProperties.Name="More history actions" ToolTipService.ToolTip="More history actions">
                                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem x:Name="HistoryMoreDeleteAllItem" Text="Delete all history" Click="ClearHistoryButton_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Bulk selection toolbar (visible when Select mode is active) -->
                                <Border x:Name="HistorySelectionToolbar" Visibility="Collapsed" Style="{StaticResource BrandSectionCardStyle}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" Padding="14,12">
                                    <StackPanel Spacing="{StaticResource BrandSpacingS}">
                                        <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                                <TextBlock x:Name="HistorySelectionCountText" Style="{StaticResource BrandRowLabelStyle}" Text="0 selected" />
                                                <TextBlock x:Name="HistorySelectionDetailText" Style="{StaticResource BrandHelperStyle}" Text="Tick cards below, or use Select all matching." TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ProgressRing x:Name="BulkDeleteHistoryProgress" Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                            <Button x:Name="HistorySelectAllButton" Content="Select all matching" Click="SelectAllMatchingButton_Click" Style="{StaticResource BrandQuietButtonStyle}" Padding="12,6" />
                                            <Button x:Name="DeleteSelectedHistoryButton" Content="Delete selected" Click="DeleteSelectedHistoryButton_Click" Style="{StaticResource BrandDestructiveButtonStyle}" Padding="12,6" IsEnabled="False" />
                                            <Button x:Name="ClearHistoryButton" Click="ClearHistoryButton_Click" AutomationProperties.Name="Delete all history" Style="{StaticResource BrandDestructiveButtonStyle}" Padding="12,6">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                    <TextBlock Text="Delete all history" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Chronological Day-Grouped Card Diary & Empty/Error States -->
                            <Grid Grid.Row="1">
                                <ListView x:Name="HistoryList" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Local dictation history" SelectionMode="None" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource BrandHistoryListItemStyle}" Padding="0,0,16,32">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection><AddDeleteThemeTransition /><ContentThemeTransition /><ReorderThemeTransition /></TransitionCollection>
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemTemplateSelector>
                                        <local:HistoryDiaryRowTemplateSelector>
                                            <local:HistoryDiaryRowTemplateSelector.DayHeaderTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="{StaticResource BrandSpacingS}" Margin="2,14,2,6" AutomationProperties.Name="{Binding AccessibilityLabel}">
                                                        <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource BrandDayTitleStyle}" Text="{Binding DayHeaderTitle}" VerticalAlignment="Center" />
                                                                <TextBlock Visibility="{Binding DayHeaderSubtitleVisibility}" Style="{StaticResource BrandSubsectionEyebrowStyle}" Text="{Binding DayHeaderSubtitle}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Style="{StaticResource BrandNeutralChipStyle}" VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource BrandNeutralChipTextStyle}" Text="{Binding DayCountText}" />
                                                            </Border>
                                                        </Grid>
                                                        <Border Height="1" Background="{ThemeResource BrandDividerBrush}" IsHitTestVisible="False" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </local:HistoryDiaryRowTemplateSelector.DayHeaderTemplate>
                                            <local:HistoryDiaryRowTemplateSelector.CardTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Border Background="{ThemeResource BrandCardBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}" Padding="16">
                                                            <StackPanel Spacing="{StaticResource BrandSpacingM}">
                                                                <!-- Card Header Row -->
                                                                <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0" Visibility="{Binding SelectionCheckBoxVisibility}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="CardSelectCheckBox_Click" MinWidth="0" Padding="4,0,6,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding SelectionCheckBoxLabel}" />
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center">
                                                                        <Border Visibility="{Binding SelectedAccentVisibility}" Width="4" Height="16" CornerRadius="2" Background="{ThemeResource BrandAccentBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="{Binding TimeDisplay}" VerticalAlignment="Center" />
                                                                        <Border Visibility="{Binding FileChipVisibility}" Style="{StaticResource BrandNeutralChipStyle}" VerticalAlignment="Center">
                                                                            <TextBlock Style="{StaticResource BrandNeutralChipTextStyle}" Text="File" />
                                                                        </Border>
                                                                        <Border Visibility="{Binding RecoveryChipVisibility}" Style="{StaticResource BrandWarningChipStyle}" VerticalAlignment="Center">
                                                                            <TextBlock Style="{StaticResource BrandStatusChipTextStyle}" Foreground="{ThemeResource BrandWarningBrush}" Text="{Binding RecoveryChipText}" />
                                                                        </Border>
                                                                        <Border Visibility="{Binding HeldSafelyChipVisibility}" Style="{StaticResource BrandAccentChipStyle}" VerticalAlignment="Center">
                                                                            <TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Held safely" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Visibility="{Binding HasPolishEditsVisibility}" Content="{Binding ShowEditsButtonText}" Click="CardShowEditsToggle_Click" Style="{StaticResource BrandQuietButtonStyle}" Padding="10,4" VerticalAlignment="Center" />
                                                                </Grid>

                                                                <!-- AI Polish View Switcher (shown when Show edits is open) -->
                                                                <StackPanel Visibility="{Binding ShowEditsPanelVisibility}" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center">
                                                                    <Border CornerRadius="9" Background="{ThemeResource BrandAccentLightBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" Padding="3">
                                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                                                            <Button Content="Polished" Visibility="{Binding PolishedActiveVisibility}" Click="CardShowPolished_Click" Style="{StaticResource BrandSegmentedActiveButtonStyle}" Padding="10,4" />
                                                                            <Button Content="Polished" Visibility="{Binding PolishedInactiveVisibility}" Click="CardShowPolished_Click" Style="{StaticResource BrandSegmentedButtonStyle}" Padding="10,4" />
                                                                            <Button Content="Original" Visibility="{Binding OriginalActiveVisibility}" Click="CardShowOriginal_Click" Style="{StaticResource BrandSegmentedActiveButtonStyle}" Padding="10,4" />
                                                                            <Button Content="Original" Visibility="{Binding OriginalInactiveVisibility}" Click="CardShowOriginal_Click" Style="{StaticResource BrandSegmentedButtonStyle}" Padding="10,4" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="{Binding ComparisonStatusText}" VerticalAlignment="Center" />
                                                                </StackPanel>

                                                                <!-- Transcript Text -->
                                                                <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                                                    <TextBlock FontSize="15" MaxLines="{Binding TranscriptMaxLines}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="{Binding DisplayText}" IsTextSelectionEnabled="True" TextAlignment="DetectFromContent" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="CardTranscriptText_IsTextTrimmedChanged" />
                                                                    <HyperlinkButton Visibility="{Binding ShowMoreToggleVisibility}" Content="{Binding ShowMoreButtonText}" Click="CardShowMoreToggle_Click" Style="{StaticResource BrandHyperlinkButtonStyle}" HorizontalAlignment="Left" Padding="0,2" />
                                                                </StackPanel>

                                                                <!-- Alternate Version Comparison Reference (when Show edits is active) -->
                                                                <Border Visibility="{Binding ShowEditsPanelVisibility}" Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                                    <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                                                        <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="{Binding ComparisonOtherHeader}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                            <Button Grid.Column="1" Click="CardCopyAlternateButton_Click" IsEnabled="{Binding CanRunCardActions}" Style="{StaticResource BrandQuietButtonStyle}" Padding="9,3" AutomationProperties.Name="{Binding CopyAlternateButtonLabel}" VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                                                                    <FontIcon FontSize="14" Glyph="{Binding CopyAlternateButtonGlyph}" />
                                                                                    <TextBlock Text="{Binding CopyAlternateButtonLabel}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </Grid>
                                                                        <TextBlock Style="{StaticResource BrandBodyStyle}" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="{Binding ComparisonOtherText}" IsTextSelectionEnabled="True" TextAlignment="DetectFromContent" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Inline Audio Recording Playback & Scrubbable Waveform -->
                                                                <Border Visibility="{Binding PlaybackRowVisibility}" Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                                    <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Grid.Column="0" Width="32" Height="32" Padding="0" Style="{StaticResource BrandQuietButtonStyle}" Click="CardPlayPauseButton_Click" IsEnabled="{Binding CanTogglePlayback}" AutomationProperties.Name="{Binding PlaybackButtonAutomationName}" ToolTipService.ToolTip="{Binding PlaybackButtonAutomationName}">
                                                                            <FontIcon FontSize="14" Glyph="{Binding PlaybackButtonGlyph}" />
                                                                        </Button>
                                                                        <controls:HistoryWaveformScrubber Grid.Column="1" Height="24" MinWidth="100" VerticalAlignment="Center" Peaks="{Binding WaveformPeaks}" ProgressFraction="{Binding PlaybackProgress}" PlayedBrush="{ThemeResource BrandAccentSolidBrush}" UnplayedBrush="{ThemeResource BrandTextTertiaryBrush}" SeekRequested="CardWaveform_SeekRequested" AutomationProperties.Name="{Binding PlaybackScrubberLabel}" ToolTipService.ToolTip="Click or drag to jump in recording" />
                                                                        <TextBlock Grid.Column="2" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="{Binding PlaybackClockText}" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Inline Paste or Playback Notice -->
                                                                <TextBlock Visibility="{Binding InlineNoticeVisibility}" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="{Binding InlineNoticeText}" TextWrapping="Wrap" />

                                                                <!-- Card Footer: Provenance stacked cleanly above compact actions so 480 DIP windows never clip -->
                                                                <StackPanel Spacing="{StaticResource BrandSpacingS}">
                                                                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="{Binding ProvenanceText}" TextWrapping="Wrap" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                        <ProgressRing Width="16" Height="16" IsActive="{Binding IsRepolishing}" Visibility="{Binding RepolishingVisibility}" VerticalAlignment="Center" />
                                                                        <Button Content="Paste" Click="CardPasteButton_Click" IsEnabled="{Binding CanRunCardActions}" Style="{StaticResource BrandPrimaryButtonStyle}" Padding="9,4" AutomationProperties.AutomationId="{Binding PasteButtonAutomationId}" AutomationProperties.Name="Paste saved dictation" AutomationProperties.HelpText="Pastes the saved dictation into the app you were using before EnviousWispr." />
                                                                        <Button Click="CardCopyButton_Click" IsEnabled="{Binding CanRunCardActions}" Style="{StaticResource BrandQuietButtonStyle}" Padding="9,4" AutomationProperties.Name="Copy saved dictation">
                                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                                                                <FontIcon FontSize="14" Glyph="{Binding CopyButtonGlyph}" />
                                                                                <TextBlock Text="{Binding CopyButtonText}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Content="Keep" Click="CardKeepButton_Click" IsEnabled="{Binding CanRunCardActions}" Visibility="{Binding KeepButtonVisibility}" Style="{StaticResource BrandQuietButtonStyle}" Padding="9,4" AutomationProperties.Name="Keep recovery entry" />
                                                                        <Button Content="Re-polish" Click="CardRepolishButton_Click" Visibility="{Binding RepolishButtonVisibility}" IsEnabled="{Binding CanRepolish}" Style="{StaticResource BrandQuietButtonStyle}" Padding="9,4" AutomationProperties.Name="Re-polish dictation" />
                                                                        <Button Content="Delete" Click="CardDeleteButton_Click" IsEnabled="{Binding CanRunCardActions}" Style="{StaticResource BrandDestructiveButtonStyle}" Padding="9,4" AutomationProperties.Name="Delete dictation" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Visibility="{Binding ActiveCardOutlineVisibility}" BorderBrush="{ThemeResource BrandAccentBrush}" BorderThickness="2" CornerRadius="{StaticResource BrandSectionRadius}" IsHitTestVisible="False" />
                                                    </Grid>
                                                </DataTemplate>
                                            </local:HistoryDiaryRowTemplateSelector.CardTemplate>
                                        </local:HistoryDiaryRowTemplateSelector>
                                    </ListView.ItemTemplateSelector>
                                    <ListView.Footer>
                                        <Border x:Name="HistoryLoadMoreContainer" Padding="0,6,0,18" Visibility="Collapsed">
                                            <Button x:Name="LoadMoreHistoryButton" HorizontalAlignment="Center" Click="LoadMoreHistoryButton_Click" Style="{StaticResource BrandQuietButtonStyle}" Content="Show older dictations" />
                                        </Border>
                                    </ListView.Footer>
                                </ListView>

                                <StackPanel x:Name="HistoryLoadingState" AutomationProperties.Name="Loading local history" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Spacing="{StaticResource BrandSpacingS}">
                                    <FontIcon FontSize="24" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xE895;" HorizontalAlignment="Center" />
                                    <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Loading local history…" TextAlignment="Center" />
                                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Your saved dictations will appear here when the local history file is ready." TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel x:Name="HistoryEmptyState" AutomationProperties.Name="No dictation history yet" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                                    <FontIcon FontSize="32" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xE720;" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="HistoryEmptyTitle" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandRowTitleStyle}" Text="Ready to Transcribe" TextAlignment="Center" />
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Press the record button or hold your shortcut to start dictating. Saved transcripts will appear here chronologically." TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HistoryDetailReadyHotkeyText" Style="{StaticResource BrandHelperStyle}" Text="Keybind: Ctrl+Win" TextAlignment="Center" />
                                </StackPanel>

                                <StackPanel x:Name="HistorySearchEmptyState" AutomationProperties.Name="No matching dictations" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Spacing="{StaticResource BrandSpacingS}" Visibility="Collapsed">
                                    <FontIcon FontSize="24" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xE721;" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="HistorySearchEmptyTitle" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandRowLabelStyle}" Text="No matching dictations" TextAlignment="Center" />
                                    <TextBlock x:Name="HistorySearchEmptyDescription" Style="{StaticResource BrandHelperStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingS}">
                                        <Button x:Name="HistoryEmptyClearSearchButton" Click="ClearHistorySearchButton_Click" Content="Clear search" Style="{StaticResource BrandQuietButtonStyle}" />
                                        <Button x:Name="HistoryEmptyClearFiltersButton" Click="ClearHistoryFiltersButton_Click" Content="Clear filters" Style="{StaticResource BrandQuietButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="HistoryUnavailableState" AutomationProperties.Name="History is unavailable" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Spacing="{StaticResource BrandSpacingS}" Visibility="Collapsed">
                                    <FontIcon FontSize="24" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xE783;" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="HistoryUnavailableTitle" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandRowLabelStyle}" Text="History is unavailable" TextAlignment="Center" />
                                    <TextBlock x:Name="HistoryUnavailableDescription" Style="{StaticResource BrandHelperStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <ScrollViewer Grid.Row="1" x:Name="DictionaryPage" AutomationProperties.Name="Dictionary page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource BrandFluentPageMaxWidth}" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" Spacing="{StaticResource BrandSpacingL}">
                            <Grid ColumnSpacing="{StaticResource BrandSpacingL}" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BrandPageTitleStyle}" Text="Your Words" />
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Custom terms and vocabulary the app uses to recognize what you say." TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Grid.Column="1" Background="{ThemeResource BrandHitTestBrush}" ColumnSpacing="{StaticResource BrandSpacingM}" IsDoubleTapEnabled="False" Tapped="SettingRow_Tapped" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DictionaryEnabledToggleLabel" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource BrandRowLabelStyle}" Text="Enable Dictionary" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="DictionaryEnabledToggle" Grid.Column="1" AutomationProperties.LabeledBy="{x:Bind DictionaryEnabledToggleLabel, Mode=OneTime}" Toggled="DictionaryEnabledToggle_Toggled" Style="{StaticResource BrandToggleSwitchStyle}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="{StaticResource BrandSpacingXs}">
                                    <Button x:Name="DictTabYourWords" Click="DictionaryTab_Click" Tag="your-words" Style="{StaticResource BrandTabStripActiveButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8,10,8">
                                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Center">
                                                <FontIcon FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE8F1;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource BrandSpacingXs}">
                                                <TextBlock Text="Your Words" Style="{StaticResource BrandRowLabelStyle}" />
                                                <TextBlock Text="Words you added" Style="{StaticResource BrandHelperStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="DictTabPacks" Click="DictionaryTab_Click" Tag="packs" Style="{StaticResource BrandTabStripButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8,10,8">
                                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Center">
                                                <FontIcon FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE74C;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource BrandSpacingXs}">
                                                <TextBlock Text="Vocabulary Packs" Style="{StaticResource BrandRowLabelStyle}" />
                                                <TextBlock Text="Ready-made lists" Style="{StaticResource BrandHelperStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="DictTabLearnFrom" Click="DictionaryTab_Click" Tag="learn-from" Style="{StaticResource BrandTabStripButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8,10,8">
                                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
