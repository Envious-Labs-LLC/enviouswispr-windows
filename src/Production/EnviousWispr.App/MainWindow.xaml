<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EnviousWispr.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:EnviousWispr.Core.Settings"
    Title="EnviousWispr">
    <Grid x:Name="WindowRoot" Background="{ThemeResource BrandWindowBgBrush}">
        <Grid.Resources>
            <!-- Keep WinUI's native control templates, but feed their documented visual-state resources from the brand palette. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource BrandToggleOnColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource BrandToggleOnColor}" Opacity="0.88" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource BrandToggleOnColor}" Opacity="0.76" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{ThemeResource BrandToggleOnColor}" Opacity="0.45" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource BrandToggleOnColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{ThemeResource BrandToggleOnColor}" Opacity="0.88" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{ThemeResource BrandToggleOnColor}" Opacity="0.76" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="{ThemeResource BrandToggleOnColor}" Opacity="0.45" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{ThemeResource BrandToggleOffColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{ThemeResource BrandToggleOffColor}" Opacity="0.88" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{ThemeResource BrandToggleOffColor}" Opacity="0.76" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="{ThemeResource BrandToggleOffColor}" Opacity="0.45" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{ThemeResource BrandToggleOffColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{ThemeResource BrandToggleOffColor}" Opacity="0.88" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{ThemeResource BrandToggleOffColor}" Opacity="0.76" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="{ThemeResource BrandToggleOffColor}" Opacity="0.45" />
            <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="ToggleSwitchContentForegroundDisabled" Color="{ThemeResource BrandTextTertiaryColor}" />
            <SolidColorBrush x:Key="ToggleSwitchHeaderForeground" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="ToggleSwitchHeaderForegroundDisabled" Color="{ThemeResource BrandTextTertiaryColor}" />

            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.86" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.68" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource BrandDividerColor}" Opacity="0.45" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource BrandTextTertiaryColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource BrandAccentColor}" Opacity="0.76" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource BrandDividerColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource BrandAccentSolidColor}" Opacity="0.88" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource BrandAccentSolidColor}" Opacity="0.76" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{ThemeResource BrandAccentLightColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource BrandOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{ThemeResource BrandTextTertiaryColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{ThemeResource BrandAccentSolidColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{ThemeResource BrandAccentSolidColor}" Opacity="0.76" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="{ThemeResource BrandDividerColor}" />

            <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource BrandPageBgColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource BrandAccentLightColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource BrandCardBgColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{ThemeResource BrandPageBgColor}" Opacity="0.55" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource BrandControlBorderColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource BrandAccentColor}" Opacity="0.72" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{ThemeResource BrandControlBorderColor}" Opacity="0.55" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{ThemeResource BrandTextTertiaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource BrandTextTertiaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource BrandTextSecondaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource BrandTextSecondaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{ThemeResource BrandTextTertiaryColor}" Opacity="0.72" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{ThemeResource BrandAccentLightColor}" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="{ThemeResource BrandPageBgColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{ThemeResource BrandAccentLightColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.76" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{ThemeResource BrandPageBgColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{ThemeResource BrandAccentLightColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{ThemeResource BrandPageBgColor}" Opacity="0.55" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{ThemeResource BrandDividerColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{ThemeResource BrandDividerColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{ThemeResource BrandAccentColor}" Opacity="0.72" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{ThemeResource BrandDividerColor}" Opacity="0.55" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{ThemeResource BrandTextTertiaryColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource BrandCardBgColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackgroundDisabled" Color="{ThemeResource BrandCardBgColor}" Opacity="0.55" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{ThemeResource BrandDividerColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{ThemeResource BrandAccentLightColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.82" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.68" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.86" />
            <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{ThemeResource BrandAccentSolidColor}" />

            <SolidColorBrush x:Key="ListViewItemBackground" Color="{ThemeResource BrandCardBgColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource BrandAccentLightColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.72" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource BrandAccentLightColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.86" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.72" />
            <SolidColorBrush x:Key="ListViewItemForeground" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="ListViewItemFocusVisualPrimaryBrush" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="ListViewItemFocusVisualSecondaryBrush" Color="{ThemeResource BrandCardBgColor}" />
            <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="ListViewItemFocusSecondaryBorderBrush" Color="{ThemeResource BrandCardBgColor}" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource BrandAccentSolidColor}" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="{ThemeResource BrandAccentSolidColor}" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="{ThemeResource BrandAccentSolidColor}" Opacity="0.78" />

            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{ThemeResource BrandErrorSoftColor}" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{ThemeResource BrandWarningSoftColor}" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{ThemeResource BrandSuccessSoftColor}" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource BrandAccentLightColor}" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="{ThemeResource BrandErrorColor}" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="{ThemeResource BrandWarningColor}" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="{ThemeResource BrandSuccessColor}" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="{ThemeResource BrandAccentSolidColor}" />
            <SolidColorBrush x:Key="InfoBarTitleForeground" Color="{ThemeResource BrandTextPrimaryColor}" />
            <SolidColorBrush x:Key="InfoBarMessageForeground" Color="{ThemeResource BrandTextBodyColor}" />
            <SolidColorBrush x:Key="InfoBarHyperlinkButtonForeground" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="InfoBarBorderBrush" Color="{ThemeResource BrandDividerColor}" />

            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource BrandAccentColor}" Opacity="0.86" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource BrandAccentColor}" Opacity="0.72" />
            <SolidColorBrush x:Key="HyperlinkButtonBackground" Color="{StaticResource BrandTransparentColor}" />
            <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="{ThemeResource BrandAccentLightColor}" />
            <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="{ThemeResource BrandAccentLightColor}" Opacity="0.72" />
            <SolidColorBrush x:Key="HyperlinkButtonBorderBrush" Color="{StaticResource BrandTransparentColor}" />
            <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPointerOver" Color="{ThemeResource BrandDividerColor}" />
            <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPressed" Color="{ThemeResource BrandAccentColor}" />
        </Grid.Resources>
        <!--
            A ZERO-SIZE SWATCH WHOSE ONLY JOB IS TO RESOLVE A THEME COLOUR TO A NUMBER. The window's
            caption buttons are drawn by Windows, not by XAML, so their colour has to be handed over
            as a literal - and hard-coding the two values here would put a second copy of the text
            colour in the codebase, which is how a palette drifts. Reading it off an element bound to
            the same ThemeResource keeps one source, and it re-resolves on every theme change for
            free.
        -->
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="ThemeColorProbe" Width="0" Height="0" IsHitTestVisible="False" Background="{ThemeResource BrandTextPrimaryBrush}" />
        <Border x:Name="KeybindErrorProbe" Width="0" Height="0" IsHitTestVisible="False" Background="{ThemeResource BrandErrorBrush}" />
        <TitleBar x:Name="AppTitleBar" AutomationProperties.Name="EnviousWispr window title" IsTabStop="False" Title="EnviousWispr" Subtitle="Private voice dictation for Windows">
            <TitleBar.LeftHeader>
                <Image Width="31" Height="24" AutomationProperties.AccessibilityView="Raw" Source="Assets/Brand/EnviousWisprMark.svg" VerticalAlignment="Center" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <Grid Grid.Row="1">
            <!--
                THE PRIMARY ACTION IS PINNED, NOT SCROLLED. Read out of the app's own accessibility
                tree on a 1024x768 desktop: "Get started" was OFFSCREEN, and so were the microphone
                status and the push-to-talk explanation. Any laptop 768 pixels tall lands there, and
                a first-run screen whose only way forward is below the fold reads as a screen with
                no way forward. There was a Ctrl+Enter accelerator and an access key, which help
                somebody who already knows they exist.

                The window height cannot solve this: it is already clamped to the work area, so on a
                short screen the content is what has to give. Pinning the action means what gives is
                the reading matter above it, which is the right way round.
            -->
            <Grid x:Name="OnboardingView" Background="{ThemeResource BrandPageBgBrush}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="OnboardingScroll" AutomationProperties.Name="Welcome to EnviousWispr" HorizontalScrollMode="Disabled">
                <Grid MaxWidth="{StaticResource BrandOnboardingContentMaxWidth}" Padding="{StaticResource BrandOnboardingContentPadding}" HorizontalAlignment="Center">
                    <StackPanel Spacing="{StaticResource BrandSectionSpacing}">
                        <Border Style="{StaticResource BrandHeaderCardStyle}">
                            <Grid ColumnSpacing="{StaticResource BrandOnboardingWideSpacing}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Image Width="{StaticResource BrandOnboardingMarkSize}" Height="{StaticResource BrandOnboardingMarkSize}" AutomationProperties.AccessibilityView="Raw" Source="Assets/Brand/EnviousWisprMark.svg" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                    <TextBlock x:Uid="OnboardingTitle" Style="{StaticResource BrandPageTitleStyle}" Text="Your voice, instantly captured." />
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Speak naturally in any Windows app. EnviousWispr transcribes locally, cleans the result, and delivers it back where you started. In apps Windows protects, it lands on your clipboard ready to paste." TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource BrandHeaderCardStyle}">
                            <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                    <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE72E;" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Private by default" />
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Audio and transcription stay on this PC. Optional cloud polish receives text only, goes directly to your chosen provider, and is off until you enable it." TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="How to dictate" />
                        <Grid ColumnSpacing="{StaticResource BrandSectionSpacing}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border MinHeight="{StaticResource BrandOnboardingStepCardMinHeight}" Style="{StaticResource BrandHeaderCardStyle}">
                                <StackPanel Spacing="{StaticResource BrandOnboardingCardSpacing}">
                                    <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                        <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE8B0;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Text="1. Put the cursor where your words should go." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" MinHeight="{StaticResource BrandOnboardingStepCardMinHeight}" Style="{StaticResource BrandHeaderCardStyle}">
                                <StackPanel Spacing="{StaticResource BrandOnboardingCardSpacing}">
                                    <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                        <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE720;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Text="2. Hold the configured key while you speak." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" MinHeight="{StaticResource BrandOnboardingStepCardMinHeight}" Style="{StaticResource BrandHeaderCardStyle}">
                                <StackPanel Spacing="{StaticResource BrandOnboardingCardSpacing}">
                                    <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                        <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE73E;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Text="3. Release to transcribe and insert. Press Escape to cancel safely." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Padding="{StaticResource BrandOnboardingCardPadding}" Style="{StaticResource BrandSectionCardStyle}">
                            <StackPanel Spacing="{StaticResource BrandSectionSpacing}">
                                <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Ready on this PC" />
                                <TextBlock Style="{StaticResource BrandBodyStyle}" Text="These checks are honest snapshots. Missing models or permissions can be fixed later without blocking access to your data and settings." TextWrapping="Wrap" />
                                <InfoBar x:Name="OnboardingReliabilityInfoBar" IsClosable="False" IsOpen="False" Severity="Warning" />
                                <Grid ColumnSpacing="{StaticResource BrandSectionSpacing}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                            <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE720;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Microphone" />
                                            <TextBlock x:Name="OnboardingMicrophoneText" Style="{StaticResource BrandBodyStyle}" Text="Checking Windows audio devices…" TextWrapping="Wrap" />
                                            <Button AutomationProperties.HelpText="Opens the Windows microphone privacy controls." Click="OpenMicrophonePrivacyButton_Click" Content="Open microphone privacy settings" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" TabIndex="10" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                            <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE9D9;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Local transcription" />
                                            <TextBlock x:Name="OnboardingModelText" Style="{StaticResource BrandBodyStyle}" Text="Checking installed model packs…" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Column="2" ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                            <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE765;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Push-to-talk" />
                                            <TextBlock x:Name="OnboardingHotkeyText" Style="{StaticResource BrandBodyStyle}" Text="F8 will start and stop dictation." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
                <!--
                    THE CAP AND THE PADDING SIT ON THE SAME ELEMENT, WHICH IS WHAT KEEPS THE BUTTON
                    LINED UP WITH THE CARDS. The scrolling content caps at 1040 and pads 40 a side,
                    so a card is 960 wide. Padding the Border and capping its child instead let the
                    button reach the full 1040 and hang 40 pixels past the cards on a wide window.
                -->
                <Border Grid.Row="1" Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="0,1,0,0">
                    <Grid MaxWidth="{StaticResource BrandOnboardingContentMaxWidth}" Padding="{StaticResource BrandOnboardingFooterPadding}">
                    <StackPanel Spacing="{StaticResource BrandSpacingS}">
                        <Button x:Name="FinishOnboardingButton" x:Uid="FinishOnboardingButton" AccessKey="G" AutomationProperties.HelpText="Completes setup and opens the EnviousWispr home page. Press Control plus Enter from anywhere on this screen." Click="FinishOnboardingButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource BrandPrimaryButtonStyle}" Content="Get started" TabIndex="0">
                            <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control" /></Button.KeyboardAccelerators>
                        </Button>
                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="You can change every choice later in Settings. No account is required." TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Width="{Binding OpenPaneLength, ElementName=ProductNavigation}"
                Margin="{StaticResource BrandWindowFrameInset}"
                HorizontalAlignment="Left"
                Background="{ThemeResource BrandSidebarBgBrush}"
                IsHitTestVisible="False"
                Style="{StaticResource BrandWindowCardStyle}"
                Visibility="{Binding Visibility, ElementName=ProductNavigation}" />

            <NavigationView x:Name="ProductNavigation" AutomationProperties.Name="EnviousWispr navigation" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" Margin="{StaticResource BrandWindowFrameInset}" OpenPaneLength="320" PaneDisplayMode="Left" SelectionChanged="ProductNavigation_SelectionChanged">
                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource BrandSidebarBgColor}" Opacity="0" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource BrandSidebarBgColor}" Opacity="0" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource BrandPageBgColor}" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{ThemeResource BrandDividerColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="{ThemeResource BrandSidebarBgColor}" Opacity="0" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource BrandAccentColor}" Opacity="0.12" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{ThemeResource BrandAccentColor}" Opacity="0.20" />
                    <!--
                        THE SELECTED ROW IS A SUBTLE RAISE, AND THE ACCENT LIVES IN THE PILL. This
                        used to be a fully filled accent bar with white text, which is a list-view or
                        web pattern rather than a Windows one - and it is also why the selection
                        appeared to teleport between rows. Windows animates the little accent
                        indicator from the old row to the new one; a filled row has no indicator to
                        move, so there was nothing to animate and the change read as a jump.
                        Using the card colour here means the selected row reads as lifted off the
                        sidebar the same way every card in the window reads as lifted off the page.
                    -->
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource BrandCardBgColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource BrandCardBgColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource BrandCardBgColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource BrandTextBodyColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource BrandTextBodyColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{ThemeResource BrandTextBodyColor}" />
                    <!--
                        A selected label stays the ordinary text colour and is distinguished by the
                        pill and the raise, not by being repainted. White-on-accent only worked
                        because the row behind it was filled.
                    -->
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource BrandTextPrimaryColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource BrandTextPrimaryColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource BrandTextPrimaryColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="{ThemeResource BrandTextSecondaryColor}" />
                    <!--
                        THE PILL, AND IT IS THE ONLY ACCENT-COLOURED THING IN THE SIDEBAR NOW. It was
                        white, which is invisible against a filled accent row - the indicator was
                        there the whole time and could not be seen, which is the other half of why
                        the selection looked like it snapped.
                    -->
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource BrandAccentColor}" />
                    <Style TargetType="NavigationViewItem">
                        <Setter Property="Height" Value="{StaticResource BrandNavRowHeight}" />
                        <Setter Property="MinHeight" Value="{StaticResource BrandNavRowHeight}" />
                    </Style>
                    <Style TargetType="NavigationViewItemHeader">
