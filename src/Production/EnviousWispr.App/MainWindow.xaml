                    <Grid Grid.Row="1" x:Name="HistoryPage" AutomationProperties.Name="History page" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="304" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="5" Background="{ThemeResource BrandSidebarBgBrush}" Opacity="0.45" IsHitTestVisible="False" />
                                <Grid Grid.Row="0" Padding="14,14,14,8" ColumnSpacing="{StaticResource BrandSpacingS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="HistorySearchBox" AutomationProperties.Name="Search dictation history" PlaceholderText="Search history" TextChanged="HistorySearchBox_TextChanged" />
                                    <TextBlock x:Name="HistoryCountText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="0" />
                                </Grid>
                                <Border Grid.Row="1" Padding="14,0,14,10">
