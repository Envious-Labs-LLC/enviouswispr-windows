l Spacing="{StaticResource BrandSpacingS}"><ComboBox x:Name="WordStrictnessComboBox" Header="How closely it must match" HeaderTemplate="{StaticResource BrandControlHeaderTemplate}" HorizontalAlignment="Left" MinWidth="360" SelectedValuePath="Tag" SelectedIndex="0"><ComboBoxItem><ComboBoxItem.Tag><settings:MatchStrictness>Default</settings:MatchStrictness></ComboBoxItem.Tag><TextBlock Text="Default: the balance every word had before" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></ComboBoxItem><ComboBoxItem><ComboBoxItem.Tag><settings:MatchStrictness>Loose</settings:MatchStrictness></ComboBoxItem.Tag><TextBlock Text="Loose: correct it even when what I said was some way off" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></ComboBoxItem><ComboBoxItem><ComboBoxItem.Tag><settings:MatchStrictness>Strict</settings:MatchStrictness></ComboBoxItem.Tag><TextBlock Text="Strict: correct it only when I said it almost exactly" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></ComboBoxItem></ComboBox><Button x:Name="SuggestAliasesButton" Click="SuggestAliasesButton_Click" Content="Suggest what it might hear" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" /><TextBlock x:Name="SuggestAliasesStatusText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" TextWrapping="Wrap" Visibility="Collapsed" /><ScrollViewer x:Name="SuggestedAliasesScroller" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" Visibility="Collapsed"><StackPanel x:Name="SuggestedAliasesPanel" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" /></ScrollViewer></StackPanel></StackPanel></Border>
