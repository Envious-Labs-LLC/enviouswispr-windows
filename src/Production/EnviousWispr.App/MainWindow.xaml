                                a new keyword, click away, and be left on the old one with nothing saying so.
                            -->
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><Grid ColumnSpacing="{StaticResource BrandSpacingS}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE720;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}"><TextBox x:Name="SnippetKeywordBox" Header="Keyword" HeaderTemplate="{StaticResource BrandControlHeaderTemplate}" HorizontalAlignment="Left" MinWidth="240" MaxLength="64" KeyDown="SnippetKeywordBox_KeyDown" LostFocus="SnippetKeywordBox_LostFocus" AutomationProperties.HelpText="A snippet only fires when you say this word first." /><TextBlock Style="{StaticResource BrandHelperStyle}" Text="A snippet only fires when you say this word first. Say the trigger on its own and your dictation is left alone." TextWrapping="Wrap" /><TextBlock x:Name="SnippetKeywordExample" Style="{StaticResource BrandHelperStyle}" TextWrapping="Wrap" /></StackPanel></Grid></StackPanel></Border>
