                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE707;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}"><TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Recording pill position" TextWrapping="Wrap" /><ItemsControl x:Name="OverlayPositionComboBox" HorizontalAlignment="Stretch" TabFocusNavigation="Once"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{StaticResource BrandSpacingS}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><RadioButton GroupName="PillOverlayPosition" Checked="AppearanceCardChecked" Style="{StaticResource BrandSelectableCardStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" ContentTemplate="{StaticResource BrandSelectableChoiceTemplate}" Content="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="LivePreviewSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}">
                                <StackPanel Spacing="{StaticResource BrandSpacingM}">
                                    <TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Live preview" />
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE890;" /><StackPanel Grid.Column="1" Background="{ThemeResource BrandHitTestBrush}" Spacing="{StaticResource BrandSpacingXs}" Tapped="SettingRow_Tapped"><TextBlock x:Name="LivePreviewToggleLabel" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource BrandRowLabelStyle}" Text="Show Live Preview while speaking" TextWrapping="Wrap" /><ToggleSwitch AutomationProperties.LabeledBy="{x:Bind LivePreviewToggleLabel, Mode=OneTime}" HorizontalAlignment="Left" x:Name="LivePreviewToggle" AutomationProperties.HelpText="Shows a display-only rough transcript while recording. Final delivered text still comes from the selected final transcription engine." Style="{StaticResource BrandToggleSwitchStyle}" Toggled="LivePreviewToggle_Toggled" /></StackPanel></Grid>
                                    <TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Recording pill" />
