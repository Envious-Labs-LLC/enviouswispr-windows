                                    <StackPanel x:Name="HistoryUnavailableState" AutomationProperties.Name="History is unavailable" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Spacing="{StaticResource BrandSpacingS}" Visibility="Collapsed">
