plate><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="{Binding Glyph}" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}"><StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}"><TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Foreground="{ThemeResource BrandSuccessBrush}" Style="{StaticResource BrandHelperStyle}" Text="{Binding VerdictLabel}" Visibility="{Binding RecommendedVisibility}" /><TextBlock Foreground="{ThemeResource BrandWarningBrush}" Style="{StaticResource BrandHelperStyle}" Text="{Binding VerdictLabel}" Visibility="{Binding MixedVisibility}" /><TextBlock Foreground="{ThemeResource BrandErrorBrush}" Style="{StaticResource BrandHelperStyle}" Text="{Binding VerdictLabel}" Visibility="{Binding CautionVisibility}" /><TextBlock Style="{StaticResource BrandHelperStyle}" Text="{Binding VerdictLabel}" Visibility="{Binding UntestedVisibility}" /></StackPanel><TextBlock Style="{StaticResource BrandBodyStyle}" Text="{Binding Note}" TextWrapping="Wrap" Visibility="{Binding NoteVisibility}" /><TextBlock Style="{StaticResource BrandHelperStyle}" Text="{Binding Detail}" TextWrapping="Wrap" /><ProgressBar IsIndeterminate="{Binding Indeterminate}" Maximum="100" Value="{Binding Percent}" Visibility="{Binding ProgressVisibility}" /><TextBlock Style="{StaticResource BrandHelperStyle}" Text="{Binding ProgressText}" TextWrapping="Wrap" Visibility="{Binding ProgressVisibility}" /></StackPanel><Button Grid.Column="2" AutomationProperties.Name="{Binding ActionName}" Click="OllamaModelAction_Click" Content="{Binding ActionLabel}" IsEnabled="{Binding ActionEnabled}" Style="{StaticResource BrandQuietButtonStyle}" VerticalAlignment="Top" Visibility="{Binding ActionVisibility}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid>
