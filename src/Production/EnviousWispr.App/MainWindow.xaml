e="{StaticResource BrandHelpGlyphSize}" Glyph="&#xE9CE;" /><Button.Flyout><Flyout FlyoutPresenterStyle="{StaticResource BrandHelpFlyoutPresenterStyle}"><TextBlock MaxWidth="{StaticResource BrandHelpFlyoutMaxWidth}" Style="{StaticResource BrandBodyStyle}" Text="Shows whether Windows Microphone privacy settings allow EnviousWispr to read audio from active microphones." TextWrapping="Wrap" /></Flyout></Button.Flyout></Button></Grid><TextBlock x:Name="PermissionsMicrophoneText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" Text="Checking Windows audio devices…" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><Border x:Name="PermissionsMicrophoneAllowedBadge" Style="{StaticResource BrandSuccessChipStyle}" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}"><Ellipse Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandSuccessBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" /><TextBlock Style="{StaticResource BrandStatusChipTextStyle}" Foreground="{ThemeResource BrandSuccessBrush}" Text="Allowed" /></StackPanel></Border><Border x:Name="PermissionsMicrophoneAttentionBadge" Style="{StaticResource BrandWarningChipStyle}" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}"><Ellipse Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandWarningBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" /><TextBlock Style="{StaticResource BrandStatusChipTextStyle}" Foreground="{ThemeResource BrandWarningBrush}" Text="Needs attention" /></StackPanel></Border></StackPanel></Grid><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE72E;" /><Button Grid.Column="1" AutomationProperties.HelpText="Opens the Windows microphone privacy controls." Click="OpenMicrophonePrivacyButton_Click" Content="Open microphone privacy settings" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" /></Grid><TextBlock Style="{StaticResource BrandHelperStyle}" Text="Local content-free diagnostics have a 1 to 90 day retention control and can be exported or disabled. Anonymous usage metrics and crash reports are on by default and never include dictated text, audio, API keys, or file paths. You can turn either off anytime in Diagnostics." TextWrapping="Wrap" /></StackPanel></Border></StackPanel></Border>
                            <Border x:Name="UpdatesSection" AutomationProperties.Name="Updates" Style="{StaticResource BrandSettingsSectionStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><StackPanel x:Name="UpdatesEyebrow" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="UpdatesEyebrowGlyph" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind HelpUpdatesNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Updates" /></StackPanel><Border Style="{StaticResource BrandSettingsCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock x:Name="UpdateStatusText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" /><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE895;" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}"><Button x:Name="CheckForUpdatesButton" AutomationProperties.HelpText="Asks the Microsoft Store whether a newer version is available. Checking never interrupts a dictation." Click="CheckForUpdatesButton_Click" Content="Check for updates" Style="{StaticResource BrandQuietButtonStyle}" /><Button x:Name="ApplyUpdateButton" AutomationProperties.HelpText="Asks the Microsoft Store to install the update. EnviousWispr closes when the install finishes." Click="ApplyUpdateButton_Click" Content="Install update" IsEnabled="False" Style="{StaticResource BrandQuietButtonStyle}" /></StackPanel></Grid><TextBlock Style="{StaticResource BrandHelperStyle}" Text="Updates come from the Microsoft Store. EnviousWispr installs one only when you are not dictating." TextWrapping="Wrap" /></StackPanel></Border></StackPanel></Border>
