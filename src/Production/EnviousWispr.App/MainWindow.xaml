                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE8D2;" /><StackPanel Grid.Column="1" Background="{ThemeResource BrandHitTestBrush}" Spacing="{StaticResource BrandSpacingXs}" Tapped="SettingRow_Tapped"><TextBlock x:Name="SpokenPunctuationToggleLabel" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource BrandRowLabelStyle}" Text="Convert spoken punctuation" TextWrapping="Wrap" /><ToggleSwitch AutomationProperties.LabeledBy="{x:Bind SpokenPunctuationToggleLabel, Mode=OneTime}" HorizontalAlignment="Left" x:Name="SpokenPunctuationToggle" Style="{StaticResource BrandToggleSwitchStyle}" /></StackPanel></Grid>
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE8D2;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}"><ComboBox x:Name="EnglishSpellingComboBox" ItemTemplate="{StaticResource BrandTrimmedChoiceTemplate}" AutomationProperties.HelpText="Applies to English dictation. Parakeet does not report which language it heard, so British applies to everything it transcribes: if you also dictate Spanish or Portuguese with Parakeet, keep American." Header="English spelling" HeaderTemplate="{StaticResource BrandControlHeaderTemplate}" HorizontalAlignment="Stretch"><x:String>American (color, organize)</x:String><x:String>British (colour, organise)</x:String></ComboBox><TextBlock Style="{StaticResource BrandHelperStyle}" Text="Applies to English dictation. Parakeet does not report which language it heard, so British applies to everything it transcribes: if you also dictate Spanish or Portuguese with Parakeet, keep American." TextWrapping="Wrap" /></StackPanel></Grid>
