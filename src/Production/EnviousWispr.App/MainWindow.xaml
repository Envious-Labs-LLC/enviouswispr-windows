                                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE896;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingS}"><TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Export my data" TextWrapping="Wrap" /><TextBlock Style="{StaticResource BrandBodyStyle}" Text="Saves one .zip file with your settings, your words, your snippets, and your dictation history as readable text. API keys, downloaded models, diagnostic logs, and saved recordings are not included." TextWrapping="Wrap" /><Button Click="ExportMyDataButton_Click" Content="Export my data" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" /></StackPanel></Grid>
                                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE74D;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingS}"><TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Delete all EnviousWispr data" TextWrapping="Wrap" /><TextBlock Style="{StaticResource BrandBodyStyle}" Text="Removes your dictation history, settings, words, snippets, downloaded models, diagnostic logs, and saved API keys from this PC, then closes EnviousWispr. Do this before you uninstall." TextWrapping="Wrap" /><Button x:Name="DeleteAllDataButton" Click="DeleteAllDataButton_Click" Content="Delete all EnviousWispr data" HorizontalAlignment="Left" Style="{StaticResource BrandDestructiveButtonStyle}" /></StackPanel></Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border x:Name="PermissionsSection" Style="{StaticResource BrandSettingsSectionStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><StackPanel x:Name="PermissionsandprivacyEyebrow" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="PermissionsandprivacyEyebrowGlyph" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind HelpPermissionsNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Permissions and privacy" /></StackPanel><Border Style="{StaticResource BrandSettingsCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock Text="Audio, local models, dictionaries, snippets, and history stay on this PC. Optional cloud polish sends text directly to the selected provider. EnviousWispr diagnostics never include dictated text, audio, keys, clipboard contents, surrounding context, paths, model IDs, or stable device identifiers." TextWrapping="Wrap" /><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE720;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}"><TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Microphone" /><TextBlock x:Name="PermissionsMicrophoneText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" Text="Checking Windows audio devices…" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><Border x:Name="PermissionsMicrophoneAllowedBadge" Style="{StaticResource BrandSuccessChipStyle}" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}"><Ellipse Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandSuccessBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" /><TextBlock Style="{StaticResource BrandStatusChipTextStyle}" Foreground="{ThemeResource BrandSuccessBrush}" Text="Allowed" /></StackPanel></Border><Border x:Name="PermissionsMicrophoneAttentionBadge" Style="{StaticResource BrandWarningChipStyle}" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}"><Ellipse Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandWarningBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" /><TextBlock Style="{StaticResource BrandStatusChipTextStyle}" Foreground="{ThemeResource BrandWarningBrush}" Text="Needs attention" /></StackPanel></Border></StackPanel></Grid><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE72E;" /><Button Grid.Column="1" AutomationProperties.HelpText="Opens the Windows microphone privacy controls." Click="OpenMicrophonePrivacyButton_Click" Content="Open microphone privacy settings" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" /></Grid><TextBlock Style="{StaticResource BrandHelperStyle}" Text="Local content-free diagnostics have a 1 to 90 day retention control and can be exported or disabled. Anonymous usage metrics and crash reports are on by default and never include dictated text, audio, API keys, or file paths. You can turn either off anytime in Diagnostics." TextWrapping="Wrap" /></StackPanel></Border></StackPanel></Border>
                            <Border x:Name="UpdatesSection" AutomationProperties.Name="Updates" Style="{StaticResource BrandSettingsSectionStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><StackPanel x:Name="UpdatesEyebrow" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="UpdatesEyebrowGlyph" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind HelpUpdatesNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Updates" /></StackPanel><Border Style="{StaticResource BrandSettingsCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock x:Name="UpdateStatusText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" /><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE895;" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}"><Button x:Name="CheckForUpdatesButton" AutomationProperties.HelpText="Asks the Microsoft Store whether a newer version is available. Checking never interrupts a dictation." Click="CheckForUpdatesButton_Click" Content="Check for updates" Style="{StaticResource BrandQuietButtonStyle}" /><Button x:Name="ApplyUpdateButton" AutomationProperties.HelpText="Asks the Microsoft Store to install the update. EnviousWispr closes when the install finishes." Click="ApplyUpdateButton_Click" Content="Install update" IsEnabled="False" Style="{StaticResource BrandQuietButtonStyle}" /></StackPanel></Grid><TextBlock Style="{StaticResource BrandHelperStyle}" Text="Updates come from the Microsoft Store. EnviousWispr installs one only when you are not dictating." TextWrapping="Wrap" /></StackPanel></Border></StackPanel></Border>
                            <Border x:Name="LicensesSection" Style="{StaticResource BrandSettingsSectionStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><StackPanel x:Name="OpensourcelicensesEyebrow" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="OpensourcelicensesEyebrowGlyph" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind HelpLicensesNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Open source licenses" /></StackPanel><Border Style="{StaticResource BrandSettingsCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock Text="EnviousWispr is GPLv3 open-source software. Third-party model and runtime notices will ship beside each signed model pack." TextWrapping="Wrap" /><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE8A5;" /><HyperlinkButton Grid.Column="1" HorizontalAlignment="Left" Content="View the EnviousWispr source" NavigateUri="https://github.com/Envious-Labs-LLC" Style="{StaticResource BrandHyperlinkButtonStyle}" /></Grid></StackPanel></Border></StackPanel></Border>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1" x:Name="HelpPage" AutomationProperties.Name="Help and privacy page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource BrandFluentPageMaxWidth}" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource BrandSpacingL}">
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}" Margin="0,0,0,8">
                                <TextBlock x:Name="HelpPageTitle" Style="{StaticResource BrandPageTitleStyle}" Text="Help and privacy" />
                                <TextBlock x:Name="HelpPageDescription" Style="{StaticResource BrandBodyStyle}" Text="Find keyboard guidance, privacy details, updates, and licenses." TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="KeyboardGuideSection" Style="{StaticResource BrandSettingsSectionStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><StackPanel x:Name="KeyboardguideEyebrow" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="KeyboardguideEyebrowGlyph" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind HelpNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Keyboard guide" /></StackPanel><Border Style="{StaticResource BrandSettingsCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock Text="Choose Push to Talk or Toggle under Keybinds, where the recording, cancel, and Add-a-word keys are set too. Paste last dictation (Alt+Shift+Z unless you change it) puts your last dictation where the cursor is; Copy last dictation puts it on the clipboard. Both are also in the tray menu, and either shortcut can be removed. Escape Recovery can finish and preserve a cancelled dictation instead of discarding it." TextWrapping="Wrap" /></StackPanel></Border></StackPanel></Border>
                            <Border x:Name="LanguageSupportSection" Style="{StaticResource BrandSettingsSectionStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><StackPanel x:Name="LanguagesupportEyebrow" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="LanguagesupportEyebrowGlyph" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind HelpNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Language support" /></StackPanel><Border Style="{StaticResource BrandSettingsCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock Text="English dictation is supported with both Parakeet and Whisper. Whisper also supports Spanish, French, and German. Unicode, emoji, punctuation, and right-to-left text are preserved through local processing, history, and clipboard delivery." TextWrapping="Wrap" /></StackPanel></Border></StackPanel></Border>
                            <TextBlock x:Name="BuildInfoText" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <InfoBar Grid.Row="2" x:Name="DeletionLeftoverInfoBar" Margin="0,12,0,0" IsOpen="False" IsClosable="True" Severity="Warning" VerticalAlignment="Bottom" />
                </Grid>
            </NavigationView>
            <!--
                THE SIDEBAR'S EDGE DRAGS. A thin strip laid over the seam between the sidebar and the page: drag it,
                or focus it and use the arrow keys, to make the sidebar narrower or wider between the two layout
                limits; double-click puts it back to its starting width. It follows the navigation's visibility so
                it never floats over the first-run screens.
            -->
            <local:SidebarResizeHandle x:Name="SidebarResizeHandle" AutomationProperties.Name="Resize sidebar" AutomationProperties.HelpText="Drag, or press the Left and Right arrow keys, to make the sidebar narrower or wider. Double-click to restore its starting width." Width="{StaticResource BrandSidebarResizeHandleWidth}" HorizontalAlignment="Left" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="True" UseSystemFocusVisuals="True" Visibility="{x:Bind ProductNavigation.Visibility, Mode=OneWay}" Loaded="SidebarResizeHandle_Loaded" PointerEntered="SidebarResizeHandle_PointerEntered" PointerExited="SidebarResizeHandle_PointerExited" PointerPressed="SidebarResizeHandle_PointerPressed" PointerMoved="SidebarResizeHandle_PointerMoved" PointerReleased="SidebarResizeHandle_PointerReleased" PointerCaptureLost="SidebarResizeHandle_PointerCaptureLost" DoubleTapped="SidebarResizeHandle_DoubleTapped" KeyDown="SidebarResizeHandle_KeyDown">
                <Border Background="{ThemeResource BrandHitTestBrush}">
                    <Border x:Name="SidebarResizeGrip" Width="2" HorizontalAlignment="Center" Background="{ThemeResource BrandAccentBrush}" Opacity="0" />
                </Border>
            </local:SidebarResizeHandle>
        </Grid>
    </Grid>
</Window>
