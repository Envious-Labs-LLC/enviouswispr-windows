                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <RadioButton x:Name="CapsulePillButton" AutomationProperties.Name="Capsule. A small capsule with the rainbow mark and a timer." GroupName="PillWithoutWords" Style="{StaticResource BrandSelectableCardStyle}">
                                            <StackPanel Spacing="{StaticResource BrandSpacingS}">
