                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE8D2;" /><StackPanel Grid.Column="1" Background="{ThemeResource BrandHitTestBrush}" Spacing="{StaticResource BrandSpacingXs}" Tapped="SettingRow_Tapped"><TextBlock x:Name="WordCorrectionToggleLabel" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource BrandRowLabelStyle}" Text="Use dictionary corrections" TextWrapping="Wrap" /><ToggleSwitch AutomationProperties.LabeledBy="{x:Bind WordCorrectionToggleLabel, Mode=OneTime}" HorizontalAlignment="Left" x:Name="WordCorrectionToggle" Style="{StaticResource BrandToggleSwitchStyle}" /></StackPanel></Grid>
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE74D;" /><StackPanel Grid.Column="1" Background="{ThemeResource BrandHitTestBrush}" Spacing="{StaticResource BrandSpacingXs}" Tapped="SettingRow_Tapped"><TextBlock x:Name="FillerRemovalToggleLabel" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource BrandRowLabelStyle}" Text="Remove filler words" TextWrapping="Wrap" /><ToggleSwitch AutomationProperties.LabeledBy="{x:Bind FillerRemovalToggleLabel, Mode=OneTime}" HorizontalAlignment="Left" x:Name="FillerRemovalToggle" Style="{StaticResource BrandToggleSwitchStyle}" /></StackPanel></Grid>
