                                    <RadioButton x:Name="ReadingWellPillButton" AutomationProperties.Name="Reading Well. A wide panel that shows your words as you speak." GroupName="PillWithWords" HorizontalAlignment="Stretch" Style="{StaticResource BrandSelectableCardStyle}">
                                        <StackPanel Spacing="{StaticResource BrandSpacingS}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Reading Well" />
                                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="A wide panel that shows your words as you speak." TextWrapping="Wrap" />
                                            <Border Width="400" MinHeight="96" Background="{ThemeResource BrandSidebarBgBrush}" CornerRadius="18" Padding="14">
                                                <StackPanel Spacing="{StaticResource BrandSpacingS}"><Grid><TextBlock Foreground="{ThemeResource BrandTextPrimaryBrush}" Style="{StaticResource BrandRowLabelStyle}" Text="Listening" /><TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource BrandTextSecondaryBrush}" FontFamily="Consolas" Text="00:12" /></Grid><Border Background="{ThemeResource BrandCardBgBrush}" CornerRadius="10" Padding="12"><TextBlock Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="the quarterly numbers came in" TextWrapping="Wrap" /></Border></StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>
                                    <TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Live Preview is display-only and never replaces final transcription. Design and position changes apply the next time the pill appears." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ClipboardSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingM}"><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Clipboard" /><TextBlock Text="EnviousWispr preserves the existing Windows clipboard before paste and restores it only if no person or other app changed it in the meantime. Unsafe and elevated targets receive a copy-only fallback instead of a blind paste." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="DiagnosticsSection" AutomationProperties.Name="Privacy-safe diagnostics settings" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingM}"><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Privacy-safe diagnostics" /><TextBlock Text="Local diagnostics contain only timestamp, typed event and failure codes, bounded duration, approved provider or engine choice, and a coarse hardware class. They never contain dictated text, audio, keys, clipboard contents, surrounding context, file paths, model IDs, or stable device identifiers." TextWrapping="Wrap" /><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xEC4A;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingS}"><TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Speed check" /><TextBlock Style="{StaticResource BrandBodyStyle}" TextWrapping="Wrap" Text="Runs the text cleanup this PC does after every dictation, many times over, and reports how long it takes. No microphone and no network." /><Button x:Name="RunSpeedCheckButton" Click="RunSpeedCheckButton_Click" Content="Run speed check" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" /><TextBlock x:Name="SpeedCheckUnavailableText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" TextWrapping="Wrap" Visibility="Collapsed" Text="Paused while a dictation is in progress." /><TextBlock x:Name="SpeedCheckResultText" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource BrandTextSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" /></StackPanel></Grid><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE9D9;" /><StackPanel Grid.Column="1" Background="{ThemeResource BrandHitTestBrush}" Spacing="{StaticResource BrandSpacingXs}" Tapped="SettingRow_Tapped"><TextBlock x:Name="LocalDiagnosticsToggleLabel" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource BrandRowLabelStyle}" Text="Keep content-free diagnostics on this PC" TextWrapping="Wrap" /><ToggleSwitch AutomationProperties.LabeledBy="{x:Bind LocalDiagnosticsToggleLabel, Mode=OneTime}" HorizontalAlignment="Left" x:Name="LocalDiagnosticsToggle" Style="{StaticResource BrandToggleSwitchStyle}" /></StackPanel></Grid><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE823;" /><NumberBox x:Name="DiagnosticRetentionDaysBox" Grid.Column="1" Header="Delete local diagnostics after this many days" HeaderTemplate="{StaticResource BrandControlHeaderTemplate}" Minimum="1" Maximum="90" SpinButtonPlacementMode="Inline" /></Grid><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE968;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}"><StackPanel Background="{ThemeResource BrandHitTestBrush}" Spacing="{StaticResource BrandSpacingXs}" Tapped="SettingRow_Tapped"><TextBlock x:Name="ShareTelemetryToggleLabel" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource BrandRowLabelStyle}" Text="Share anonymous operational diagnostics" TextWrapping="Wrap" /><ToggleSwitch AutomationProperties.LabeledBy="{x:Bind ShareTelemetryToggleLabel, Mode=OneTime}" HorizontalAlignment="Left" x:Name="ShareTelemetryToggle" AutomationProperties.HelpText="Off by default. When available and enabled, sends only the listed content-free operational fields directly to the configured Envious Labs telemetry endpoint." Style="{StaticResource BrandToggleSwitchStyle}" /></StackPanel><TextBlock x:Name="DiagnosticsStatusText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" TextWrapping="Wrap" /></StackPanel></Grid><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE896;" /><Button Grid.Column="1" Click="ExportDiagnosticsButton_Click" Content="Export privacy-safe diagnostics" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" /></Grid></StackPanel></Border>
                            <Border x:Name="PortableProfileSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingM}"><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Portable profile" /><TextBlock Text="Export or import settings, dictionary entries, and snippets. Machine-specific microphone choices, API keys, history, audio, and lifecycle state are never included." TextWrapping="Wrap" /><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE8B5;" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}"><Button Click="ExportProfileButton_Click" Content="Export profile" Style="{StaticResource BrandQuietButtonStyle}" /><Button Click="ImportProfileButton_Click" Content="Import profile" Style="{StaticResource BrandQuietButtonStyle}" /></StackPanel></Grid></StackPanel></Border>
                        </StackPanel></Grid>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1" x:Name="HelpPage" AutomationProperties.Name="Help and privacy page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource BrandPageContentMaxWidth}" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="{StaticResource BrandSpacingL}">
                            <Border Style="{StaticResource BrandHeaderCardStyle}"><Grid ColumnSpacing="{StaticResource BrandSpacingL}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="56" Height="56" Style="{StaticResource BrandIconTileStyle}"><FontIcon x:Name="HelpPageGlyph" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE897;" /></Border><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}"><TextBlock x:Name="HelpPageTitle" Style="{StaticResource BrandPageTitleStyle}" Text="Help and privacy" /><TextBlock x:Name="HelpPageDescription" Style="{StaticResource BrandBodyStyle}" Text="Find keyboard guidance, privacy details, updates, and licenses." TextWrapping="Wrap" /></StackPanel></Grid></Border>
                            <Border x:Name="KeyboardGuideSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Keyboard guide" /><TextBlock Text="Choose Push to Talk or Toggle under Settings. Your recording, cancel, and Add-a-word keybinds are configurable. Escape Recovery can finish and preserve a cancelled dictation instead of discarding it." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="PermissionsSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Permissions and privacy" /><TextBlock Text="Audio, local models, dictionaries, snippets, and history stay on this PC. Optional cloud polish sends text directly to the selected provider. EnviousWispr diagnostics never include dictated text, audio, keys, clipboard contents, surrounding context, paths, model IDs, or stable device identifiers." TextWrapping="Wrap" /><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE72E;" /><Button Grid.Column="1" AutomationProperties.HelpText="Opens the Windows microphone privacy controls." Click="OpenMicrophonePrivacyButton_Click" Content="Open microphone privacy settings" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" /></Grid><TextBlock Style="{StaticResource BrandHelperStyle}" Text="Local content-free diagnostics have a 1 to 90 day retention control and can be exported or disabled. Anonymous sharing is off by default, requires explicit consent, and is unavailable unless a vetted HTTPS telemetry endpoint is configured." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="LanguageSupportSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Language support" /><TextBlock Text="English final dictation and English UI are the supported baseline. French and Spanish Whisper have trusted-fixture evidence. German recognition remains experimental and below one per-row accuracy gate. Other Whisper languages, mixed-language speech, and translated UI are not advertised yet." TextWrapping="Wrap" /><TextBlock Style="{StaticResource BrandHelperStyle}" Text="Unicode, emoji, and right-to-left text are preserved through local processing, history, clipboard, and safe delivery. English number and date normalization is skipped for detected non-English speech." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="UpdatesSection" AutomationProperties.Name="Signed updates" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Updates" /><TextBlock x:Name="UpdateStatusText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" /><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE895;" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}"><Button x:Name="CheckForUpdatesButton" AutomationProperties.HelpText="Checks only this build's isolated release channel. Checking is blocked while dictation is recording or processing." Click="CheckForUpdatesButton_Click" Content="Check for updates" Style="{StaticResource BrandQuietButtonStyle}" /><Button x:Name="ApplyUpdateButton" AutomationProperties.HelpText="Restarts EnviousWispr and atomically applies the already downloaded and verified update." Click="ApplyUpdateButton_Click" Content="Apply update and restart" IsEnabled="False" Style="{StaticResource BrandQuietButtonStyle}" /></StackPanel></Grid><TextBlock Style="{StaticResource BrandHelperStyle}" Text="Installer and update files must be code-signed by Envious Labs. Velopack verifies release SHA-256 values; EnviousWispr separately verifies the trusted Windows publisher before apply. User data remains outside the replaceable install directory." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="LicensesSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Open source licenses" /><TextBlock Text="EnviousWispr is GPLv3 open-source software. Third-party model and runtime notices will ship beside each signed model pack." TextWrapping="Wrap" /><Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE8A5;" /><HyperlinkButton Grid.Column="1" HorizontalAlignment="Left" Content="View the EnviousWispr source" NavigateUri="https://github.com/Envious-Labs-LLC" Style="{StaticResource BrandHyperlinkButtonStyle}" /></Grid></StackPanel></Border>
                            <TextBlock x:Name="BuildInfoText" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
                        </StackPanel></Grid>
                    </ScrollViewer>
                    <!--
                        THE PRIMARY ACTION SITS OUTSIDE THE SCROLL AREA, ON PURPOSE. Inside
                        it, the button is only visible if the page happens to be short
                        enough - and one page was already 2.6% too tall, presenting Save as a
                        12-pixel sliver until the user scrolled. Trimming that page would
                        have fixed the instance and left the next long page to rediscover it.
                        The column is capped exactly as the pages are, so the button stays on
                        the same vertical line as the content above it rather than drifting
                        to the window edge.
                    -->
                    <Grid Grid.Row="2" x:Name="SaveSettingsBar" Margin="0,16,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource BrandPageContentMaxWidth}" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="SaveSettingsButton" HorizontalAlignment="Right" Click="SaveSettingsButton_Click" Style="{StaticResource BrandPrimaryButtonStyle}" Content="Save settings" />
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
