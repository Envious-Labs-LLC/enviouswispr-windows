ck Style="{StaticResource BrandHelperStyle}" Text="A fill-in becomes the date, the time, or what you copied. Everything else is pasted as written, and AI Polish never rewrites it. Buttons add a fill-in at the end; you can move it anywhere." TextWrapping="Wrap" /></StackPanel></Grid><Grid ColumnSpacing="{StaticResource BrandSpacingS}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE710;" /><Button Grid.Column="1" HorizontalAlignment="Right" Click="AddSnippetButton_Click" Content="Add snippet" Style="{StaticResource BrandPrimaryButtonStyle}" /></Grid></StackPanel></Border>
