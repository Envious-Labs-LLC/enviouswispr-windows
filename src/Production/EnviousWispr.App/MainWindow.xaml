<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EnviousWispr.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EnviousWispr">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" Background="{ThemeResource BrandWindowBgBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" AutomationProperties.Name="EnviousWispr window title" IsTabStop="False" Title="EnviousWispr" Subtitle="Private voice dictation for Windows">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/Brand/EnviousWisprAppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="OnboardingView" AutomationProperties.Name="Welcome to EnviousWispr" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                <Grid MaxWidth="980" Padding="40,28,40,48" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,28,48,0" Spacing="18">
                        <Image Width="72" Height="72" AutomationProperties.AccessibilityView="Raw" HorizontalAlignment="Left" Source="Assets/Brand/EnviousWisprMark.svg" />
                        <TextBlock x:Uid="OnboardingTitle" Style="{StaticResource BrandPageTitleStyle}" Text="Your voice, instantly captured." />
                        <TextBlock FontSize="18" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Speak naturally in any Windows app. EnviousWispr transcribes locally, cleans the result, and delivers it back where you started." TextWrapping="Wrap" />
                        <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Private by default" />
                                <TextBlock Text="Audio and transcription stay on this PC. Optional cloud polish receives text only, goes directly to your chosen provider, and is off until you enable it." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="How to dictate" />
                        <TextBlock Text="1. Put the cursor where your words should go.&#x0a;2. Hold the configured key while you speak.&#x0a;3. Release to transcribe and insert. Press Escape to cancel safely." TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="20" Style="{StaticResource BrandSectionCardStyle}">
                        <StackPanel Spacing="18">
                            <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Ready on this PC" />
                            <TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="These checks are honest snapshots. Missing models or permissions can be fixed later without blocking access to your data and settings." TextWrapping="Wrap" />
                            <InfoBar x:Name="OnboardingReliabilityInfoBar" IsClosable="False" IsOpen="False" Severity="Warning" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE720;" Foreground="{ThemeResource BrandAccentBrush}" />
                                <StackPanel Grid.Column="1" Spacing="6"><TextBlock FontWeight="SemiBold" Text="Microphone" /><TextBlock x:Name="OnboardingMicrophoneText" Text="Checking Windows audio devices…" TextWrapping="Wrap" /><Button AutomationProperties.HelpText="Opens the Windows microphone privacy controls." Click="OpenMicrophonePrivacyButton_Click" Content="Open microphone privacy settings" HorizontalAlignment="Left" TabIndex="10" /></StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource BrandAccentBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2"><TextBlock FontWeight="SemiBold" Text="Local transcription" /><TextBlock x:Name="OnboardingModelText" Text="Checking installed model packs…" TextWrapping="Wrap" /></StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE765;" Foreground="{ThemeResource BrandAccentBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2"><TextBlock FontWeight="SemiBold" Text="Push-to-talk" /><TextBlock x:Name="OnboardingHotkeyText" Text="F8 will start and stop dictation." TextWrapping="Wrap" /></StackPanel>
                            </Grid>
                            <Button x:Name="FinishOnboardingButton" x:Uid="FinishOnboardingButton" AccessKey="G" AutomationProperties.HelpText="Completes setup and opens the EnviousWispr home page. Press Control plus Enter from anywhere on this screen." Click="FinishOnboardingButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource AccentButtonStyle}" Content="Get started" TabIndex="0">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control" /></Button.KeyboardAccelerators>
                            </Button>
                            <TextBlock FontSize="12" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="You can change every choice later in Settings. No account is required." TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <NavigationView x:Name="ProductNavigation" AutomationProperties.Name="EnviousWispr navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" PaneDisplayMode="Auto" SelectionChanged="ProductNavigation_SelectionChanged">
                <NavigationView.PaneHeader>
                    <StackPanel Margin="0,8,0,12" Orientation="Horizontal" Spacing="10">
                        <Image Width="34" Height="34" AutomationProperties.AccessibilityView="Raw" Source="Assets/Brand/EnviousWisprMark.svg" />
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="EnviousWispr" VerticalAlignment="Center" />
                    </StackPanel>
                </NavigationView.PaneHeader>
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="HomeNavItem" x:Uid="HomeNavItem" AccessKey="M" Content="Home" Icon="Home" Tag="home" />
                    <NavigationViewItemHeader Content="APP" />
                    <NavigationViewItem x:Uid="HistoryNavItem" AccessKey="Y" Content="History" Icon="Clock" Tag="history" />
                    <NavigationViewItem Content="What’s New" Icon="Document" Tag="whats-new" />
                    <NavigationViewItem Content="Appearance" Icon="Setting" Tag="settings-appearance" />
                    <NavigationViewItemHeader Content="RECORD" />
                    <NavigationViewItem x:Name="TranscriptionNavItem" Content="Transcription" Tag="settings-transcription"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C1;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Live Preview" Tag="settings-live-preview"><NavigationViewItem.Icon><FontIcon Glyph="&#xE890;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Microphone" Tag="settings-microphone"><NavigationViewItem.Icon><FontIcon Glyph="&#xE720;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Sounds" Tag="settings-sounds"><NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Keybinds" Tag="settings-keybinds"><NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItemHeader Content="PROCESS" />
                    <NavigationViewItem Content="AI Polish" Tag="settings-ai-polish"><NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem x:Name="DictionaryNavItem" x:Uid="DictionaryNavItem" AccessKey="D" Content="Your Words" Icon="Character" Tag="dictionary" />
                    <NavigationViewItem x:Uid="SnippetsNavItem" AccessKey="S" Content="Snippets" Icon="Document" Tag="snippets" />
                    <NavigationViewItemHeader Content="OUTPUT" />
                    <NavigationViewItem Content="Clipboard" Tag="settings-clipboard"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C8;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItemHeader Content="SYSTEM" />
                    <NavigationViewItem Content="Permissions" Tag="help-permissions"><NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Check for Updates" Tag="help-updates"><NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Open Source Licenses" Tag="help-licenses"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon></NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Name="SettingsNavItem" x:Uid="SettingsNavItem" AccessKey="T" Content="All Settings" Icon="Setting" Tag="settings" />
                    <NavigationViewItem x:Uid="HelpNavItem" AccessKey="P" Content="Help and Privacy" Icon="Help" Tag="help" />
                </NavigationView.FooterMenuItems>
                <Grid Padding="28,18,28,32">
                    <InfoBar x:Name="OperationInfoBar" Margin="0,0,0,12" Canvas.ZIndex="10" IsOpen="False" IsClosable="True" VerticalAlignment="Top" />

                    <ScrollViewer x:Name="HomePage" AutomationProperties.Name="Home page" HorizontalScrollMode="Disabled">
                        <StackPanel MaxWidth="900" Spacing="18">
                            <StackPanel Spacing="6"><TextBlock x:Uid="HomeTitle" Style="{StaticResource BrandPageTitleStyle}" Text="Speak naturally. Keep working." /><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="EnviousWispr is ready in the background. Put your cursor in any app, hold your key, speak, and release." TextWrapping="Wrap" /></StackPanel>
                            <InfoBar x:Name="FoundationInfoBar" IsClosable="False" IsOpen="True" Message="Local transcription, deterministic cleanup, optional AI polish, context-aware insertion, and safe clipboard recovery are active." Severity="Success" Title="Private dictation pipeline active" />
                            <Border x:Name="RecoveryCard" AutomationProperties.Name="Recovered unfinished dictation" Padding="20" Style="{StaticResource BrandSectionCardStyle}" Visibility="Collapsed"><StackPanel Spacing="10"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Recovered unfinished dictation" /><TextBlock Text="EnviousWispr found text that had not reached its destination before the previous run ended. Review it here; it will never be pasted automatically." TextWrapping="Wrap" /><TextBox x:Name="RecoveryTextBox" AcceptsReturn="True" AutomationProperties.Name="Recovered dictation text" IsReadOnly="True" MaxHeight="180" TextAlignment="DetectFromContent" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Click="CopyRecoveryButton_Click" Content="Copy recovered text" /><Button Click="DeleteRecoveryButton_Click" Content="Delete recovery copy" /></StackPanel></StackPanel></Border>
                            <Grid ColumnSpacing="14" RowSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="7"><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Push-to-talk" /><TextBlock x:Name="HotkeyStatusText" FontSize="18" FontWeight="SemiBold" Text="Starting…" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Grid.Column="1" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="7"><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Session" /><TextBlock x:Name="SessionStatusText" AutomationProperties.LiveSetting="Polite" FontSize="18" FontWeight="SemiBold" Text="Idle" TextWrapping="Wrap" /><TextBlock x:Name="LivePreviewText" AutomationProperties.Name="Live transcription preview" Foreground="{ThemeResource BrandTextSecondaryBrush}" MaxLines="3" TextAlignment="DetectFromContent" TextWrapping="Wrap" Visibility="Collapsed" /></StackPanel></Border>
                                <Border Grid.Row="1" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="7"><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Transcription engine" /><TextBlock x:Name="EngineReadinessText" FontWeight="SemiBold" Text="Checking…" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="1" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="7"><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Microphone" /><TextBlock x:Name="MicrophoneReadinessText" FontWeight="SemiBold" Text="Checking…" TextWrapping="Wrap" /></StackPanel></Border>
                            </Grid>
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Recent dictations" /><TextBlock x:Name="HistorySummaryText" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Loading local history…" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Click="OpenHistoryButton_Click" Content="Open history" VerticalAlignment="Center" /></Grid></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="WhatsNewPage" AutomationProperties.Name="What’s New page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <StackPanel MaxWidth="820" Spacing="18">
                            <TextBlock Style="{StaticResource BrandPageTitleStyle}" Text="What’s New" />
                            <TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="The Windows edition is being built around the same daily-use workflow as EnviousWispr for Mac." TextWrapping="Wrap" />
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="10"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Founder build" /><TextBlock Text="Choose Parakeet or Whisper, use deterministic cleanup, optionally polish with EG-1, Ollama, or a direct cloud provider, and keep custom words on this PC." TextWrapping="Wrap" /><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Live Preview, light and dark appearance, and top or bottom recording-pill placement are available in All Settings." TextWrapping="Wrap" /></StackPanel></Border>
                            <TextBlock x:Name="WhatsNewBuildInfoText" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="HistoryPage" AutomationProperties.Name="History page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <StackPanel MaxWidth="900" Spacing="16">
                            <TextBlock Style="{StaticResource BrandPageTitleStyle}" Text="History" />
                            <TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Past dictations stay in a private file on this PC. Search, copy, remove, or turn history off at any time." TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="HistorySearchBox" AutomationProperties.Name="Search dictation history" PlaceholderText="Search local history" TextChanged="HistorySearchBox_TextChanged" /><Button Grid.Column="1" Click="CopyHistoryButton_Click" Content="Copy selected" /><Button Grid.Column="2" Click="KeepHistoryButton_Click" Content="Keep selected" /><Button Grid.Column="3" Click="DeleteHistoryButton_Click" Content="Delete selected" /></Grid>
                            <ListView x:Name="HistoryList" AutomationProperties.Name="Local dictation history" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="6" Spacing="5"><TextBlock FontWeight="SemiBold" Text="{Binding CreatedDisplay}" /><TextBlock MaxLines="4" Text="{Binding Text}" TextAlignment="DetectFromContent" TextWrapping="Wrap" /><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="{Binding Details}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                            <Button HorizontalAlignment="Right" Click="ClearHistoryButton_Click" Content="Delete all history" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="DictionaryPage" AutomationProperties.Name="Dictionary page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <StackPanel MaxWidth="820" Spacing="16">
                            <TextBlock Style="{StaticResource BrandPageTitleStyle}" Text="Your Words" />
                            <TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Teach deterministic word correction how a spoken form should be written. These entries stay local and are included in portable profile exports." TextWrapping="Wrap" />
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SpokenFormBox" Header="When I say" MaxLength="256" PlaceholderText="envy wisper" /><TextBox x:Name="ReplacementBox" Grid.Column="1" Header="Write" MaxLength="256" PlaceholderText="EnviousWispr" /><Button Grid.Column="2" Margin="0,28,0,0" Click="AddWordButton_Click" Content="Add word" /></Grid></Border>
                            <ListView x:Name="DictionaryList" AutomationProperties.Name="Custom dictionary entries" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><Grid Padding="6" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SpokenForm}" TextAlignment="DetectFromContent" TextWrapping="Wrap" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Replacement}" TextAlignment="DetectFromContent" TextWrapping="Wrap" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                            <Button HorizontalAlignment="Right" Click="RemoveWordButton_Click" Content="Remove selected" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SnippetsPage" AutomationProperties.Name="Snippets page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <StackPanel MaxWidth="820" Spacing="16">
                            <TextBlock Style="{StaticResource BrandPageTitleStyle}" Text="Snippets" />
                            <TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Keep reusable text beside your dictation settings. Snippets stay local and are included in portable profile exports." TextWrapping="Wrap" />
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="10"><TextBox x:Name="SnippetNameBox" Header="Name" MaxLength="128" PlaceholderText="Email sign-off" /><TextBox x:Name="SnippetBodyBox" AcceptsReturn="True" Header="Text" MaxLength="10000" MinHeight="100" PlaceholderText="Kind regards," TextWrapping="Wrap" /><Button HorizontalAlignment="Right" Click="AddSnippetButton_Click" Content="Add snippet" /></StackPanel></Border>
                            <ListView x:Name="SnippetList" AutomationProperties.Name="Saved snippets" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="6" Spacing="4"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextAlignment="DetectFromContent" /><TextBlock MaxLines="4" Text="{Binding Body}" TextAlignment="DetectFromContent" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                            <Button HorizontalAlignment="Right" Click="RemoveSnippetButton_Click" Content="Remove selected" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" AutomationProperties.Name="Settings page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <StackPanel MaxWidth="820" Spacing="18">
                            <TextBlock x:Name="SettingsPageTitle" Style="{StaticResource BrandPageTitleStyle}" Text="All Settings" />
                            <TextBlock x:Name="SettingsPageDescription" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Choose how EnviousWispr records, transcribes, cleans, and stores your dictation." TextWrapping="Wrap" />
                            <Border x:Name="RecordAndTranscribeSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="14"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Record and transcribe" /><ComboBox x:Name="MicrophoneComboBox" DisplayMemberPath="DisplayName" Header="Microphone" HorizontalAlignment="Stretch" /><Button AutomationProperties.HelpText="Opens the Windows microphone privacy controls." Click="OpenMicrophonePrivacyButton_Click" Content="Open microphone privacy settings" HorizontalAlignment="Left" /><ComboBox x:Name="EngineComboBox" Header="Final transcription engine" HorizontalAlignment="Stretch"><x:String>Automatic</x:String><x:String>Parakeet</x:String><x:String>Whisper</x:String></ComboBox><ComboBox x:Name="WhisperLanguageComboBox" x:Uid="WhisperLanguageComboBox" AutomationProperties.HelpText="Automatic detects the spoken language. A fixed language can improve recognition when automatic detection is unreliable." Header="Whisper language" HorizontalAlignment="Stretch"><x:String>Automatic detection</x:String><x:String>English</x:String><x:String>French</x:String><x:String>German (experimental)</x:String><x:String>Spanish</x:String></ComboBox><ComboBox x:Name="RecordingModeComboBox" Header="Recording mode" HorizontalAlignment="Stretch"><x:String>Push to Talk — hold to record, release to stop</x:String><x:String>Toggle — press once to start, press again to stop</x:String></ComboBox><TextBox x:Name="HotkeyTextBox" Header="Recording keybind" MaxLength="64" PlaceholderText="F8" /><TextBox x:Name="CancelHotkeyTextBox" Header="Cancel keybind" MaxLength="64" PlaceholderText="Escape" /><ToggleSwitch x:Name="EscapeRecoveryToggle" Header="Escape Recovery" /><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="When enabled, the cancel key finishes transcription and polishing instead of discarding the recording. The setting applies from the next recording." TextWrapping="Wrap" /><TextBox x:Name="QuickAddHotkeyTextBox" Header="Add-a-word keybind" MaxLength="64" PlaceholderText="Ctrl+Alt+W" /><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Select a misheard word anywhere, then press the Add-a-word shortcut to bring it into Your Words. Terminal windows do not expose their selection." TextWrapping="Wrap" /><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="English, French, and Spanish have trusted-fixture evidence. German remains experimental; see Help and Privacy for the measured support matrix." TextWrapping="Wrap" /><TextBlock x:Name="ModelInventoryText" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="EnviousWispr verifies and version-pins model packs before activation. Installed packs remain reusable offline and retain their license notices." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="SoundSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Sounds" /><ToggleSwitch x:Name="PlayRecordingSoundsToggle" Header="Play recording sounds" /><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Plays a short sound when recording starts and stops. People nearby may hear it." TextWrapping="Wrap" /><ComboBox x:Name="RecordingSoundComboBox" DisplayMemberPath="DisplayName" Header="Sound pairing" HorizontalAlignment="Stretch" SelectionChanged="RecordingSoundComboBox_SelectionChanged" /><TextBlock x:Name="RecordingSoundDescriptionText" Foreground="{ThemeResource BrandTextSecondaryBrush}" TextWrapping="Wrap" /><Button x:Name="PreviewRecordingSoundButton" AutomationProperties.HelpText="Plays the selected recording start and stop sound without changing the master toggle." Click="PreviewRecordingSoundButton_Click" Content="Preview selected sound" HorizontalAlignment="Left" /></StackPanel></Border>
                            <Border x:Name="DeterministicCleanupSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Deterministic cleanup" /><ToggleSwitch x:Name="WordCorrectionToggle" Header="Use dictionary corrections" /><ToggleSwitch x:Name="FillerRemovalToggle" Header="Remove filler words" /><ToggleSwitch x:Name="EmojiFormatterToggle" Header="Format spoken emoji" /><ToggleSwitch x:Name="SpokenPunctuationToggle" Header="Convert spoken punctuation" /></StackPanel></Border>
                            <Border x:Name="AiPolishSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="AI polish" />
                                    <ComboBox x:Name="PolishProviderComboBox" Header="Provider" HorizontalAlignment="Stretch" SelectionChanged="PolishProviderComboBox_SelectionChanged"><x:String>None</x:String><x:String>EG-1</x:String><x:String>Ollama</x:String><x:String>OpenAI</x:String><x:String>Anthropic</x:String><x:String>Gemini</x:String></ComboBox>
                                    <ComboBox x:Name="PolishModelPicker" AutomationProperties.HelpText="Lists the bundled EG-1 choice, locally installed Ollama chat models, or compatible models discovered from the selected direct-cloud account." Header="Available models" HorizontalAlignment="Stretch" SelectionChanged="PolishModelPicker_SelectionChanged" />
                                    <Button x:Name="RefreshPolishModelsButton" AutomationProperties.HelpText="Refreshes local Ollama models or fetches the selected provider's model catalog without sending transcript text." Click="RefreshPolishModelsButton_Click" Content="Refresh available models" HorizontalAlignment="Left" />
                                    <TextBox x:Name="PolishModelTextBox" Header="Model ID (selected above or enter a custom compatible ID)" MaxLength="256" />
                                    <TextBox x:Name="OllamaEndpointTextBox" Header="Ollama endpoint on this PC" MaxLength="2048" PlaceholderText="http://127.0.0.1:11434" />
                                    <PasswordBox x:Name="ApiKeyPasswordBox" AutomationProperties.HelpText="Write-only field for the selected direct cloud provider. Existing keys are never displayed." Header="API key for selected cloud provider" MaxLength="1280" />
                                    <StackPanel x:Name="ApiKeyButtonPanel" Orientation="Horizontal" Spacing="10"><Button x:Name="SaveApiKeyButton" Click="SaveApiKeyButton_Click" Content="Save API key" /><Button x:Name="RemoveApiKeyButton" Click="RemoveApiKeyButton_Click" Content="Remove stored key" /></StackPanel>
                                    <TextBlock x:Name="ApiKeyStatusText" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource BrandTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="API keys are stored separately in Windows Credential Manager and are never written to settings or exports. Model discovery sends only the stored credential to the selected provider; no transcript or generation request is sent. Provider and model selections apply after the next launch." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="HistorySettingsSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="History" /><ToggleSwitch x:Name="HistoryEnabledToggle" Header="Save dictation history on this PC" /><NumberBox x:Name="RetentionDaysBox" Header="Delete history after this many days (0 keeps it until you delete it)" Minimum="0" Maximum="3650" SpinButtonPlacementMode="Inline" /></StackPanel></Border>
                            <Border x:Name="AppearanceSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Appearance" />
                                    <ComboBox x:Name="ThemeComboBox" Header="Theme" HorizontalAlignment="Stretch" SelectionChanged="ThemeComboBox_SelectionChanged"><x:String>Use Windows setting</x:String><x:String>Light</x:String><x:String>Dark</x:String></ComboBox>
                                    <ToggleSwitch x:Name="LivePreviewToggle" AutomationProperties.HelpText="Shows a display-only rough transcript while recording. Final delivered text still comes from the selected final transcription engine." Header="Show Live Preview while speaking" Toggled="LivePreviewToggle_Toggled" />
                                    <ComboBox x:Name="OverlayPositionComboBox" Header="Recording pill position" HorizontalAlignment="Stretch"><x:String>Top</x:String><x:String>Bottom</x:String></ComboBox>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Recording Pill" />
                                    <TextBlock x:Name="WithoutWordsPillHeading" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Live Preview off · In use" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="CapsulePillButton" AutomationProperties.Name="Capsule. A small capsule with the rainbow mark and a timer." Click="CapsulePillButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="Capsule" TextAlignment="Center" />
                                                <Border Width="185" Height="58" Background="{ThemeResource BrandSidebarBgBrush}" CornerRadius="29" Padding="16,10">
                                                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="27" Height="16"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="{ThemeResource BrandSpectrumVioletColor}" Offset="0" /><GradientStop Color="{ThemeResource BrandSpectrumBlueColor}" Offset="0.35" /><GradientStop Color="{ThemeResource BrandSpectrumSpringColor}" Offset="0.7" /><GradientStop Color="{ThemeResource BrandSpectrumGoldColor}" Offset="1" /></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Grid.Column="1" Foreground="{ThemeResource BrandTextPrimaryBrush}" FontFamily="Consolas" FontWeight="SemiBold" Text="00:12" VerticalAlignment="Center" /></Grid>
                                                </Border>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="LevelRailPillButton" AutomationProperties.Name="Level Rail. A wider capsule with a live rainbow meter beside the timer." Click="LevelRailPillButton_Click" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="Level Rail" TextAlignment="Center" />
                                                <Border Width="288" Height="58" Background="{ThemeResource BrandSidebarBgBrush}" CornerRadius="29" Padding="16,10">
                                                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Foreground="{ThemeResource BrandTextPrimaryBrush}" FontFamily="Consolas" FontWeight="SemiBold" Text="00:12" VerticalAlignment="Center" /><ProgressBar Grid.Column="1" Foreground="{ThemeResource BrandSpectrumRoyalBrush}" Maximum="1" Value="0.62" VerticalAlignment="Center" /></Grid>
                                                </Border>
                                            </StackPanel>
                                        </ToggleButton>
                                    </Grid>
                                    <TextBlock x:Name="WithWordsPillHeading" Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Live Preview on" />
                                    <ToggleButton x:Name="ReadingWellPillButton" AutomationProperties.Name="Reading Well. A wide panel that shows your words as you speak." Click="ReadingWellPillButton_Click" HorizontalAlignment="Left" HorizontalContentAlignment="Center">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="Reading Well" TextAlignment="Center" />
                                            <Border Width="400" MinHeight="96" Background="{ThemeResource BrandSidebarBgBrush}" CornerRadius="18" Padding="14">
                                                <StackPanel Spacing="9"><Grid><TextBlock Foreground="{ThemeResource BrandTextPrimaryBrush}" FontWeight="SemiBold" Text="Listening" /><TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource BrandTextSecondaryBrush}" FontFamily="Consolas" Text="00:12" /></Grid><Border Background="{ThemeResource BrandCardBgBrush}" CornerRadius="10" Padding="12"><TextBlock Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="the quarterly numbers came in" TextWrapping="Wrap" /></Border></StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ToggleButton>
                                    <TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Live Preview is display-only and never replaces final transcription. Design and position changes apply the next time the pill appears." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ClipboardSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Clipboard" /><TextBlock Text="EnviousWispr preserves the existing Windows clipboard before paste and restores it only if no person or other app changed it in the meantime. Unsafe and elevated targets receive a copy-only fallback instead of a blind paste." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="DiagnosticsSection" AutomationProperties.Name="Privacy-safe diagnostics settings" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Privacy-safe diagnostics" /><TextBlock Text="Local diagnostics contain only timestamp, typed event and failure codes, bounded duration, approved provider or engine choice, and a coarse hardware class. They never contain dictated text, audio, keys, clipboard contents, surrounding context, file paths, model IDs, or stable device identifiers." TextWrapping="Wrap" /><ToggleSwitch x:Name="LocalDiagnosticsToggle" Header="Keep content-free diagnostics on this PC" /><NumberBox x:Name="DiagnosticRetentionDaysBox" Header="Delete local diagnostics after this many days" Minimum="1" Maximum="90" SpinButtonPlacementMode="Inline" /><ToggleSwitch x:Name="ShareTelemetryToggle" AutomationProperties.HelpText="Off by default. When available and enabled, sends only the listed content-free operational fields directly to the configured Envious Labs telemetry endpoint." Header="Share anonymous operational diagnostics" /><TextBlock x:Name="DiagnosticsStatusText" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource BrandTextSecondaryBrush}" TextWrapping="Wrap" /><Button Click="ExportDiagnosticsButton_Click" Content="Export privacy-safe diagnostics" HorizontalAlignment="Left" /></StackPanel></Border>
                            <Border x:Name="PortableProfileSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="12"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Portable profile" /><TextBlock Text="Export or import settings, dictionary entries, and snippets. Machine-specific microphone choices, API keys, history, audio, and lifecycle state are never included." TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Click="ExportProfileButton_Click" Content="Export profile" /><Button Click="ImportProfileButton_Click" Content="Import profile" /></StackPanel></StackPanel></Border>
                            <Button HorizontalAlignment="Right" Click="SaveSettingsButton_Click" Style="{StaticResource AccentButtonStyle}" Content="Save settings" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="HelpPage" AutomationProperties.Name="Help and privacy page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                        <StackPanel MaxWidth="820" Spacing="18">
                            <TextBlock Style="{StaticResource BrandPageTitleStyle}" Text="Help and privacy" />
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="10"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Keyboard guide" /><TextBlock Text="Choose Push to Talk or Toggle under Settings. Your recording, cancel, and Add-a-word keybinds are configurable. Escape Recovery can finish and preserve a cancelled dictation instead of discarding it." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="PermissionsSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="10"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Permissions and privacy" /><TextBlock Text="Audio, local models, dictionaries, snippets, and history stay on this PC. Optional cloud polish sends text directly to the selected provider. EnviousWispr diagnostics never include dictated text, audio, keys, clipboard contents, surrounding context, paths, model IDs, or stable device identifiers." TextWrapping="Wrap" /><Button AutomationProperties.HelpText="Opens the Windows microphone privacy controls." Click="OpenMicrophonePrivacyButton_Click" Content="Open microphone privacy settings" HorizontalAlignment="Left" /><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Local content-free diagnostics have a 1–90 day retention control and can be exported or disabled. Anonymous sharing is off by default, requires explicit consent, and is unavailable unless a vetted HTTPS telemetry endpoint is configured." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="10"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Language support" /><TextBlock Text="English final dictation and English UI are the supported baseline. French and Spanish Whisper have trusted-fixture evidence. German recognition remains experimental and below one per-row accuracy gate. Other Whisper languages, mixed-language speech, and translated UI are not advertised yet." TextWrapping="Wrap" /><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Unicode, emoji, and right-to-left text are preserved through local processing, history, clipboard, and safe delivery. English number and date normalization is skipped for detected non-English speech." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="UpdatesSection" AutomationProperties.Name="Signed updates" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="10"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Updates" /><TextBlock x:Name="UpdateStatusText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="CheckForUpdatesButton" AutomationProperties.HelpText="Checks only this build's isolated release channel. Checking is blocked while dictation is recording or processing." Click="CheckForUpdatesButton_Click" Content="Check for updates" /><Button x:Name="ApplyUpdateButton" AutomationProperties.HelpText="Restarts EnviousWispr and atomically applies the already downloaded and verified update." Click="ApplyUpdateButton_Click" Content="Apply verified update and restart" IsEnabled="False" /></StackPanel><TextBlock Foreground="{ThemeResource BrandTextSecondaryBrush}" Text="Installer and update files must be code-signed by Envious Labs. Velopack verifies release SHA-256 values; EnviousWispr separately verifies the trusted Windows publisher before apply. User data remains outside the replaceable install directory." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="LicensesSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="10"><TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Open source licenses" /><TextBlock Text="EnviousWispr is GPLv3 open-source software. Third-party model and runtime notices will ship beside each signed model pack." TextWrapping="Wrap" /><HyperlinkButton Content="View the EnviousWispr source" NavigateUri="https://github.com/Envious-Labs-LLC" /></StackPanel></Border>
                            <TextBlock x:Name="BuildInfoText" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
