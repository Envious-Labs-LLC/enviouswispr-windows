                            <Border Style="{StaticResource BrandHeaderCardStyle}"><Grid ColumnSpacing="{StaticResource BrandSpacingL}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="56" Height="56" Style="{StaticResource BrandIconTileStyle}"><FontIcon x:Name="HelpPageGlyph" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE897;" /></Border><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}"><TextBlock x:Name="HelpPageTitle" Style="{StaticResource BrandPageTitleStyle}" Text="Help and privacy" /><TextBlock x:Name="HelpPageDescription" Style="{StaticResource BrandBodyStyle}" Text="Find keyboard guidance, privacy details, updates, and licenses." TextWrapping="Wrap" /></StackPanel></Grid></Border>
                            <Border x:Name="KeyboardGuideSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><StackPanel x:Name="KeyboardguideEyebrow" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="KeyboardguideEyebrowGlyph" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind HelpNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Keyboard guide" /></StackPanel><TextBlock Text="Choose Push to Talk or Toggle under Keybinds, where the recording, cancel, and Add-a-word keys are set too. Paste last dictation (Alt+Shift+Z unless you change it) puts your last dictation where the cursor is; Copy last dictation puts it on the clipboard. Both are also in the tray menu, and either shortcut can be removed. Escape Recovery can finish and preserve a cancelled dictation instead of discarding it." TextWrapping="Wrap" /></StackPanel></Border>
                            <Border x:Name="LanguageSupportSection" Padding="20" Style="{StaticResource BrandSectionCardStyle}"><StackPanel Spacing="{StaticResource BrandSpacingS}"><StackPanel x:Name="LanguagesupportEyebrow" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="LanguagesupportEyebrowGlyph" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind HelpNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Language support" /></StackPanel><TextBlock Text="English final dictation and English UI are the supported baseline. French and Spanish Whisper have trusted-fixture evidence. German recognition remains experimental and below one per-row accuracy gate. Other Whisper languages, mixed-language speech, and translated UI are not advertised yet." TextWrapping="Wrap" /><TextBlock Style="{StaticResource BrandHelperStyle}" Text="Unicode, emoji, and right-to-left text are preserved through local processing, history, clipboard, and safe delivery. English number and date normalization is skipped for detected non-English speech." TextWrapping="Wrap" /></StackPanel></Border>
                            <TextBlock x:Name="BuildInfoText" Foreground="{ThemeResource BrandTextSecondaryBrush}" />
                        </StackPanel></Grid>
                    </ScrollViewer>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
