                                            <TextBox x:Name="CopyLastHotkeyTextBox" IsReadOnly="True" KeyDown="HotkeyBoxKeyDown" KeyUp="HotkeyBoxKeyUp" TextChanged="HotkeyBoxTextChanged" MaxLength="64" PlaceholderText="None" Width="100" TextAlignment="Center" CornerRadius="14" Padding="8,4,8,4" FontSize="14" Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandControlBorderBrush}" BorderThickness="1" />
