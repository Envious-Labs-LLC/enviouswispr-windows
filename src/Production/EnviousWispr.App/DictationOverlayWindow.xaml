<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EnviousWispr.App.DictationOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EnviousWispr dictation status">
    <Border
        x:Name="OverlayRoot"
        PointerEntered="OverlayRoot_PointerEntered"
        PointerExited="OverlayRoot_PointerExited"
        PointerPressed="OverlayRoot_PointerPressed"
        PointerMoved="OverlayRoot_PointerMoved"
        PointerReleased="OverlayRoot_PointerReleased"
        PointerCaptureLost="OverlayRoot_PointerReleased"
        Background="{ThemeResource PillSurfaceBrush}"
        BorderThickness="1"
        CornerRadius="29">
        <Grid>
            <!--
                THE SEVERITY WASH SITS BEHIND THE CONTENT AND IN FRONT OF THE PILL SURFACE.
                It cannot be the root's own Background: the surface is what keeps the pill legible
                over somebody else's document, and a soft tint at #1A painted straight onto the
                desktop would be no tint at all. Its Background is set from code beside the ink, so
                the pair can never disagree, and it carries no colour here for the same reason.

                THE PILL'S PADDING MOVED OFF THE ROOT AND ONTO THE CONTENT for this to be true. A
                Border lays its child out INSIDE its padding, so while the frame owned the padding
                the wash stopped short of the capsule edge and left an untinted band all the way
                round - a tint that shipped, built clean, passed every gate, and was not the thing
                the code said it was.
            -->
            <Border x:Name="SeverityWash" CornerRadius="29" />
            <!--
                CENTRED IN THE PILL, WHICH IT WAS NOT. A StackPanel stretches to fill its parent by
                default and stacks its children from the TOP, so a one-line recording pill drew
                "Listening 00:01" against the ceiling with two thirds of the capsule empty beneath
                it. Photographed on a real screen at 150% scale; no gate could see it, because the
                gates read markup and tokens and this is a property of the rendered layout.
            -->
            <StackPanel
                x:Name="ContentPanel"
                Margin="16,12"
                VerticalAlignment="Center"
                Spacing="{StaticResource BrandSpacingS}">
                <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image x:Name="RainbowMark" Width="31" Height="24" AutomationProperties.AccessibilityView="Raw" Source="Assets/Brand/EnviousWisprMark.svg" VerticalAlignment="Center" />
                    <FontIcon x:Name="StateIcon" AutomationProperties.AccessibilityView="Raw" FontSize="20" Glyph="&#xE720;" Visibility="Collapsed" />
                    <TextBlock x:Name="StateTitle" AutomationProperties.LiveSetting="Polite" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Style="{StaticResource PillModeQuietTextStyle}" Text="Listening" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock x:Name="ElapsedText" Grid.Column="2" Foreground="{ThemeResource PillTimerBrush}" FontFamily="Consolas" FontSize="14" Text="00:00" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="LevelBars" Height="25" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Width="4" Height="8" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="13" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="19" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="11" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="22" Background="{ThemeResource BrandSpectrumSpringBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="16" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="9" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="20" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="14" Background="{ThemeResource BrandSpectrumRedBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="7" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="17" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    <Border Width="4" Height="10" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="2" VerticalAlignment="Center" />
                </StackPanel>
                <Border x:Name="PreviewWell" Background="{ThemeResource PillSurfaceBrush}" CornerRadius="10" Padding="12,9" Visibility="Collapsed">
                    <TextBlock x:Name="PreviewText" AutomationProperties.Name="Live transcription preview" FontSize="14" MaxLines="5" Style="{StaticResource PillDimmedTextStyle}" Text="Listening…" TextAlignment="DetectFromContent" TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="StateDetail" AutomationProperties.AccessibilityView="Raw" FontSize="14" MaxLines="2" Style="{StaticResource PillNoticeTextStyle}" Text="Release your key to finish" TextWrapping="Wrap" Visibility="Collapsed" />
                <!--
                    THE ONE THING THE USER CAN DO ABOUT IT. Right-aligned rather than full width so
                    the pill still reads as a notice rather than a dialog, and 14px like everything
                    else here because the overlay has a floor and this is not an exception to it.
                -->
                <Button x:Name="ActionButton" Click="ActionButton_Click" FontSize="14" HorizontalAlignment="Right" Style="{StaticResource PillActionButtonStyle}" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
