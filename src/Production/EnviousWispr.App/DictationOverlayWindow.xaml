<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EnviousWispr.App.DictationOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EnviousWispr dictation status">
    <Border
        x:Name="OverlayRoot"
        PointerEntered="OverlayRoot_PointerEntered"
        PointerExited="OverlayRoot_PointerExited"
        PointerPressed="OverlayRoot_PointerPressed"
        PointerMoved="OverlayRoot_PointerMoved"
        PointerReleased="OverlayRoot_PointerReleased"
        PointerCaptureLost="OverlayRoot_PointerReleased"
        BorderThickness="0"
        CornerRadius="0"
        Style="{StaticResource PillCapsuleSurfaceStyle}">
        <!--
            A 2-UNIT BLEED AROUND THE TRUE PILL BOUNDS. SetWindowRgn clips 2 units in from the window
            rectangle so an antialiased corner never composites against black, keeping the 1px border
            and bottom rainbow hairline intact across DPI scales and themes.
        -->
        <Border
            x:Name="FrameBorder"
            Margin="2"
            BorderThickness="1"
            CornerRadius="22"
            Style="{StaticResource PillCapsuleEdgeStyle}">
            <Grid>
                <Border x:Name="SeverityWash" CornerRadius="22" />

                <!-- 4px left vertical rainbow stripe on rich actionable error capsules -->
                <Border
                    x:Name="LeftSpectrumStripe"
                    Width="4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0.0" Color="{ThemeResource BrandSpectrumRedColor}" />
                            <GradientStop Offset="0.25" Color="{ThemeResource BrandSpectrumOrangeColor}" />
                            <GradientStop Offset="0.5" Color="{ThemeResource BrandSpectrumSpringColor}" />
                            <GradientStop Offset="0.75" Color="{ThemeResource BrandSpectrumBlueColor}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource BrandSpectrumVioletColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 1px bottom rainbow hairline on capsules, notices, processing, and reading well -->
                <Border
                    x:Name="BottomRainbowHairline"
                    Height="1"
                    Margin="20,0,20,1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Opacity="0.5"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0" Color="{ThemeResource PillHairlineFadeStartColor}" />
                            <GradientStop Offset="0.1" Color="{ThemeResource BrandSpectrumRedColor}" />
                            <GradientStop Offset="0.2" Color="{ThemeResource BrandSpectrumOrangeColor}" />
                            <GradientStop Offset="0.3" Color="{ThemeResource BrandSpectrumGoldColor}" />
                            <GradientStop Offset="0.4" Color="{ThemeResource BrandSpectrumLimeColor}" />
                            <GradientStop Offset="0.5" Color="{ThemeResource BrandSpectrumSpringColor}" />
                            <GradientStop Offset="0.6" Color="{ThemeResource BrandSpectrumCyanColor}" />
                            <GradientStop Offset="0.7" Color="{ThemeResource BrandSpectrumBlueColor}" />
                            <GradientStop Offset="0.8" Color="{ThemeResource BrandSpectrumRoyalColor}" />
                            <GradientStop Offset="0.9" Color="{ThemeResource BrandSpectrumVioletColor}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource PillHairlineFadeEndColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 1px pulsing red bottom hairline on Distress / Interruption capsules -->
                <Border
                    x:Name="BottomDistressHairline"
                    Height="1"
                    Margin="20,0,20,1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Opacity="0.45"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0" Color="{ThemeResource PillDistressRedFadeColor}" />
                            <GradientStop Offset="0.2" Color="{ThemeResource PillDistressRedColor}" />
                            <GradientStop Offset="0.8" Color="{ThemeResource PillDistressRedColor}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource PillDistressRedFadeColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 2px full-bleed bottom rainbow bar on Bluetooth Awareness Card -->
                <Border
                    x:Name="CardBottomRainbowBar"
                    Height="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0" Color="{ThemeResource BrandSpectrumRedColor}" />
                            <GradientStop Offset="0.2" Color="{ThemeResource BrandSpectrumOrangeColor}" />
                            <GradientStop Offset="0.4" Color="{ThemeResource BrandSpectrumGoldColor}" />
                            <GradientStop Offset="0.55" Color="{ThemeResource BrandSpectrumSpringColor}" />
                            <GradientStop Offset="0.75" Color="{ThemeResource BrandSpectrumBlueColor}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource BrandSpectrumVioletColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Hidden theme-aware color probes resolved against OverlayRoot.RequestedTheme -->
                <Border x:Name="DistressRedProbe" Width="0" Height="0" Background="{ThemeResource PillDistressRedBrush}" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel x:Name="LipsSpectrumPalette" Width="0" Height="0" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw">
                    <Border Background="{ThemeResource BrandSpectrumRedBrush}" />
                    <Border Background="{ThemeResource BrandSpectrumOrangeBrush}" />
                    <Border Background="{ThemeResource BrandSpectrumGoldBrush}" />
                    <Border Background="{ThemeResource BrandSpectrumLimeBrush}" />
                    <Border Background="{ThemeResource BrandSpectrumSpringBrush}" />
                    <Border Background="{ThemeResource BrandSpectrumCyanBrush}" />
                    <Border Background="{ThemeResource BrandSpectrumBlueBrush}" />
                    <Border Background="{ThemeResource BrandSpectrumRoyalBrush}" />
                    <Border Background="{ThemeResource BrandSpectrumVioletBrush}" />
                </StackPanel>

                <!-- Live announcement target for cards and hands-free Classic recordings -->
                <TextBlock
                    x:Name="LiveAnnouncementText"
                    Width="1"
                    Height="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="14"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Text=" " />

                <!-- Recording pills, processing, readiness, notices, rich errors, escape recovery, save errors, language chip -->
                <StackPanel
                    x:Name="ContentPanel"
                    Margin="14,0"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource BrandSpacingS}">
                    <Grid x:Name="HeaderRow" ColumnSpacing="{StaticResource BrandSpacingS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="HeaderLeading" Orientation="Horizontal" Spacing="{StaticResource PillHeaderSpacing}" VerticalAlignment="Center">
                            <Canvas
                                x:Name="LipsMark"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                RenderTransformOrigin="0.5,0.5"
                                Visibility="Collapsed">
                                <Canvas.RenderTransform>
                                    <ScaleTransform x:Name="LipsMarkScale" ScaleX="1" ScaleY="1" />
                                </Canvas.RenderTransform>
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumRedBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumSpringBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumSpringBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumRedBrush}" CornerRadius="0.5625" />
                                <Border Width="1.6875" Height="2" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="0.5625" />
                            </Canvas>

                            <Grid
                                x:Name="SpectrumWheelIcon"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                AutomationProperties.AccessibilityView="Raw">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="SpectrumWheelTransform" CenterX="12" CenterY="12" Rotation="0" />
                                </Grid.RenderTransform>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="0" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="5.25" Margin="0,1.5,0,0" Background="{ThemeResource PillWheelRedBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="30" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="3.75" Margin="0,2.625,0,0" Background="{ThemeResource PillWheelOrangeBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="60" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="4.5" Margin="0,1.875,0,0" Background="{ThemeResource PillWheelYellowBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="90" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="3.375" Margin="0,3,0,0" Background="{ThemeResource PillWheelGreenBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="120" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="5.25" Margin="0,1.5,0,0" Background="{ThemeResource PillWheelLeafBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="150" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="4.125" Margin="0,2.25,0,0" Background="{ThemeResource PillWheelTealBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="180" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="4.875" Margin="0,1.875,0,0" Background="{ThemeResource PillWheelSkyBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="210" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="3.375" Margin="0,3,0,0" Background="{ThemeResource PillWheelBlueBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="240" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="5.25" Margin="0,1.5,0,0" Background="{ThemeResource PillWheelIndigoBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="270" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="4.5" Margin="0,2.25,0,0" Background="{ThemeResource PillWheelPurpleBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="300" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="3.75" Margin="0,2.625,0,0" Background="{ThemeResource PillWheelRedBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                                <Grid Width="24" Height="24"><Grid.RenderTransform><RotateTransform Angle="330" CenterX="12" CenterY="12" /></Grid.RenderTransform><Border Width="1.5" Height="4.875" Margin="0,1.875,0,0" Background="{ThemeResource PillWheelOrangeBrush}" CornerRadius="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" /></Grid>
                            </Grid>

                            <!-- Orange filled triangle warning glyph matching macOS notice-warning-polish-failed -->
                            <Grid
                                x:Name="WarningGlyphBadge"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                AutomationProperties.AccessibilityView="Raw">
                                <Path
                                    Data="M 10,1.5 L 18.8,17.2 A 1.2,1.2 0 0 1 17.7,19 L 2.3,19 A 1.2,1.2 0 0 1 1.2,17.2 Z"
                                    Fill="{ThemeResource PillWarningGlyphBrush}" />
                                <Border Width="2" Height="6" Margin="0,6.5,0,0" CornerRadius="1" Background="{ThemeResource PillWarningGlyphInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Border Width="2" Height="2" Margin="0,14,0,0" CornerRadius="1" Background="{ThemeResource PillWarningGlyphInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            </Grid>

                            <!-- Red circular x badge matching macOS notice-error-capture -->
                            <Border
                                x:Name="ErrorCircleBadge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="{ThemeResource PillErrorGlyphFillBrush}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                AutomationProperties.AccessibilityView="Raw">
                                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource PillErrorGlyphInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Green circular check badge matching macOS notice-engine-ready -->
                            <Border
                                x:Name="ReadyCircleBadge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="{ThemeResource PillReadyGlyphFillBrush}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                AutomationProperties.AccessibilityView="Raw">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource PillReadyGlyphInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- 40x40 soft-red badge for rich actionable errors -->
                            <Border
                                x:Name="RichErrorBadge"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                BorderThickness="1"
                                Background="{ThemeResource PillRichErrorBadgeFillBrush}"
                                BorderBrush="{ThemeResource PillRichErrorBadgeBorderBrush}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                AutomationProperties.AccessibilityView="Raw">
                                <FontIcon x:Name="RichErrorGlyph" Glyph="&#xF781;" FontSize="18" Foreground="{ThemeResource PillRichErrorIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <FontIcon x:Name="StateIcon" AutomationProperties.AccessibilityView="Raw" FontSize="18" Glyph="&#xE720;" Visibility="Collapsed" />

                            <TextBlock x:Name="ElapsedText" FontFamily="Consolas" FontSize="13" Style="{StaticResource PillCapsuleTimerTextStyle}" Text="0:00" VerticalAlignment="Center" Visibility="Collapsed" />

                            <StackPanel x:Name="LevelBars" Height="24" Orientation="Horizontal" Spacing="{StaticResource PillRailBarSpacing}" Visibility="Collapsed" VerticalAlignment="Center">
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumRedBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumRedBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumSpringBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumSpringBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                                <Border Width="3" Height="3.5" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="1.5" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel x:Name="WellMeter" Height="16" Orientation="Horizontal" Spacing="{StaticResource PillWellMeterSpacing}" Visibility="Collapsed" VerticalAlignment="Center">
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumRedBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumRedBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumSpringBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumSpringBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                <Border Width="2" Height="2.25" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="1" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border x:Name="RailHandsFreeBadge" Padding="9,3" CornerRadius="9" Style="{StaticResource PillCapsuleBadgeStyle}" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="RailHandsFreeText" FontSize="11" FontWeight="SemiBold" Style="{StaticResource PillCapsuleBadgeTextStyle}" Text="Hands-free" />
                            </Border>

                            <TextBlock x:Name="ProcessingLabel" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource PillCapsuleTextBrush}" MaxLines="1" Text="Transcribing..." VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel x:Name="NoticeCopyStack" Grid.Column="1" Spacing="{StaticResource PillLearnedTextSpacing}" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="StateTitle"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Style="{StaticResource PillNoticeTextStyle}"
                                Text="Ready"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="StateSubtitle"
                                FontSize="12"
                                Style="{StaticResource PillSubtitleTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock x:Name="ModeLabel" Grid.Column="2" FontSize="11" FontWeight="SemiBold" Style="{StaticResource PillWellModeTextStyle}" Text="LISTENING" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Border x:Name="WellHandsFreeBadge" Grid.Column="2" Padding="8,2" CornerRadius="9" Style="{StaticResource PillWellBadgeStyle}" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource PillBadgeDotSpacing}">
                                <Ellipse Width="5" Height="5" Style="{StaticResource PillWellBadgeDotStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="WellHandsFreeText" FontSize="11" FontWeight="SemiBold" Style="{StaticResource PillWellBadgeTextStyle}" Text="HANDS-FREE" />
                            </StackPanel>
                        </Border>

                        <StackPanel
                            x:Name="InlineActionRow"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="{StaticResource PillBadgeDotSpacing}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Button
                                x:Name="InlineActionButton"
                                Click="ActionButton_Click"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Style="{StaticResource PillInlineActionButtonStyle}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="InlineDismissButton"
                                Click="InlineDismissButton_Click"
                                Content="Dismiss"
                                FontSize="14"
                                Style="{StaticResource PillInlineActionButtonStyle}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="PreviewWell" BorderBrush="{ThemeResource PillWellDividerBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,15" Visibility="Collapsed">
                        <Canvas x:Name="PreviewViewport" Height="0">
                            <TextBlock x:Name="PreviewText" AutomationProperties.Name="Live transcription preview" FontSize="14" LineHeight="21" LineStackingStrategy="BlockLineHeight" Style="{StaticResource PillWellTextStyle}" TextAlignment="DetectFromContent" TextWrapping="Wrap" />
                            <Border x:Name="PreviewFade" IsHitTestVisible="False" Style="{StaticResource PillWellFadeStyle}" Visibility="Collapsed" />
                        </Canvas>
                    </Border>

                    <!-- Compact in-panel notice slot inside Capsule, Level Rail, or Reading Well -->
                    <Border
                        x:Name="InPanelNoticeRow"
                        Padding="10,4,10,6"
                        BorderBrush="{ThemeResource PillDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource PillBadgeDotSpacing}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon x:Name="InPanelNoticeIcon" Glyph="&#xE7BA;" FontSize="12" Style="{StaticResource PillWarningIconStyle}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock
                                x:Name="InPanelNoticeText"
                                FontSize="11"
                                FontWeight="Medium"
                                MaxWidth="{StaticResource PillInPanelNoticeMaxWidth}"
                                Style="{StaticResource PillNoticeTextStyle}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Self-Learning Dictionary Undo pill: theme-aware Light/Dark border + smooth countdown rail -->
                <Grid x:Name="LearnedPillPanel" Margin="14,9,12,11" VerticalAlignment="Center" ColumnSpacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center" Style="{StaticResource PillLearnedDiscStyle}">
                        <FontIcon Glyph="&#xE82D;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PillLearnedIconStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource PillLearnedTextSpacing}">
                        <TextBlock x:Name="LearnedPillTitle" FontSize="15" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="{StaticResource PillLearnedTitleMaxWidth}" AutomationProperties.LiveSetting="Polite" Style="{StaticResource PillLearnedTitleStyle}" />
                        <TextBlock x:Name="LearnedPillSubtitle" FontSize="14" MaxLines="1" Style="{StaticResource PillLearnedSubtitleStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="LearnedPillControls" Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource PillBadgeDotSpacing}" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Button x:Name="LearnedPillUndoButton" Content="Undo" Click="LearnedUndoButton_Click" FontSize="14" FontWeight="SemiBold" Style="{StaticResource PillLearnedUndoButtonStyle}" />
                        <Button x:Name="LearnedPillCloseButton" Width="28" Height="28" Click="LearnedCloseButton_Click" Style="{StaticResource PillLearnedCloseButtonStyle}" AutomationProperties.Name="Close and keep learned word">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Floating Bluetooth Mic Awareness Card (320px, Light/Dark theme-aware, 2px bottom rainbow bar) -->
                <StackPanel
                    x:Name="BluetoothAwarenessCardPanel"
                    Width="{StaticResource PillCardWidth}"
                    Padding="18,16,18,18"
                    Spacing="{StaticResource PillCardSpacing}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="BluetoothCardTitle"
                            Grid.Column="1"
                            FontSize="16"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Style="{StaticResource PillCardTitleTextStyle}"
                            Text="Bluetooth mic detected"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="BluetoothCloseButton"
                            Grid.Column="2"
                            Width="25"
                            Height="25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Close Bluetooth tips"
                            Click="CardDismissButton_Click"
                            Style="{StaticResource PillCardCloseButtonStyle}">
                            <FontIcon FontSize="11" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="BluetoothCardSubtitle"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        MaxWidth="{StaticResource PillCardInnerMaxWidth}"
                        Style="{StaticResource PillCardBodyTextStyle}"
                        Text="Bluetooth microphones can take a moment on a cold start."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel Spacing="{StaticResource PillCardTipSpacing}">
                        <Grid ColumnSpacing="{StaticResource PillCardTipSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource PillCardTipCircleBrush}" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE823;" FontSize="15" Foreground="{ThemeResource PillCardTipIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="14" Style="{StaticResource PillCardBodyTextStyle}" Text="After your mic has been idle, wait 1 to 2 seconds before speaking." TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource PillCardTipSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource PillCardTipCircleBrush}" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE916;" FontSize="15" Foreground="{ThemeResource PillCardTipIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="14" Style="{StaticResource PillCardBodyTextStyle}" Text="Microphone readiness keeps follow-up dictations ready for up to 30 seconds (on by default)." TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource PillCardTipSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource PillCardTipCircleBrush}" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE7F6;" FontSize="15" Foreground="{ThemeResource PillCardTipIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="14" Style="{StaticResource PillCardBodyTextStyle}" Text="Built-in or wired mics usually avoid this startup delay." TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        x:Name="BluetoothFooterText"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        MaxWidth="{StaticResource PillCardInnerMaxWidth}"
                        Style="{StaticResource PillCardFooterTextStyle}"
                        Text="Shown once per launch when Bluetooth is your mic"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel Spacing="{StaticResource PillCardTightSpacing}" HorizontalAlignment="Center">
                        <Button
                            x:Name="BluetoothGotItButton"
                            MinWidth="124"
                            Click="CardDismissButton_Click"
                            Content="Got it"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Style="{StaticResource PillCardPrimaryButtonStyle}" />
                        <Button
                            x:Name="BluetoothAdjustButton"
                            Click="ActionButton_Click"
                            Content="Adjust settings"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Style="{StaticResource PillCardLinkButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Floating AI Polish Setup Card (320px, Light/Dark theme-aware, no X button, no rainbow bar) -->
                <StackPanel
                    x:Name="PolishSetupCardPanel"
                    Width="{StaticResource PillCardWidth}"
                    Padding="20,18,20,16"
                    Spacing="{StaticResource PillCardSpacing}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="PolishSetupTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PillCardTitleTextStyle}"
                        Text="Polish needs setup."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PolishSetupSubtitle"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PillCardBodyTextStyle}"
                        Text="Pasted without AI polish."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="PolishSetupActionButton"
                        Click="ActionButton_Click"
                        Content="Set up AI polish"
                        FontSize="14"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource PillCardPrimaryButtonStyle}" />
                    <Button
                        x:Name="PolishSetupNotNowButton"
                        Click="CardDismissButton_Click"
                        Content="Not now"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PillCardLinkButtonStyle}" />
                </StackPanel>

                <!-- Animated bottom countdown rail for Self-Learning Dictionary Undo -->
                <Border
                    x:Name="LearnedCountdownRail"
                    Height="2"
                    Width="0"
                    Margin="20,0,20,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Style="{StaticResource PillLearnedRailStyle}"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0" Color="{ThemeResource PillLearnedRailStartColor}" />
                            <GradientStop Offset="0.5" Color="{ThemeResource PillLearnedRailMidColor}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource PillLearnedRailEndColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Animated bottom countdown rail for Escape Recovery (3s dwell, hover pauses/restarts) -->
                <Border
                    x:Name="EscapeCountdownRail"
                    Height="2"
                    Width="0"
                    Margin="20,0,20,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Style="{StaticResource PillLearnedRailStyle}"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0" Color="{ThemeResource PillLearnedRailStartColor}" />
                            <GradientStop Offset="0.5" Color="{ThemeResource PillLearnedRailMidColor}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource PillLearnedRailEndColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
