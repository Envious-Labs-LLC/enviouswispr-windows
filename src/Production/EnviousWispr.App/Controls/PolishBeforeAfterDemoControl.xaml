<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EnviousWispr.App.Controls.PolishBeforeAfterDemoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="DemoCardBorder"
        Padding="18"
        PointerEntered="DemoCardBorder_PointerEntered"
        PointerExited="DemoCardBorder_PointerExited"
        Style="{StaticResource BrandSettingsCardStyle}">
        <StackPanel Spacing="{StaticResource BrandSpacingM}">
            <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Padding="3"
                    Background="{ThemeResource BrandPageBgBrush}"
                    BorderBrush="{ThemeResource BrandDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                        <Button
                            x:Name="SpokenToggleButton"
                            AutomationProperties.AutomationId="PolishDemoSpokenButton"
                            AutomationProperties.Name="Show raw spoken dictation"
                            Click="SpokenToggleButton_Click"
                            Content="Spoken"
                            Style="{StaticResource BrandSegmentedButtonStyle}" />
                        <Button
                            x:Name="PolishedToggleButton"
                            AutomationProperties.AutomationId="PolishDemoPolishedButton"
                            AutomationProperties.Name="Show AI polished writing"
                            Click="PolishedToggleButton_Click"
                            Content="Polished"
                            Style="{StaticResource BrandSegmentedActiveButtonStyle}" />
                    </StackPanel>
                </Border>
                <Border
                    x:Name="ModeBadgeBorder"
                    Grid.Column="2"
                    Style="{StaticResource BrandAccentChipStyle}">
                    <TextBlock
                        x:Name="ModeBadgeText"
                        Style="{StaticResource BrandAccentChipTextStyle}"
                        Text="AI polished" />
                </Border>
            </Grid>

            <Border
                x:Name="StageSurfaceBorder"
                MinHeight="104"
                Padding="16,14,16,14"
                Background="{ThemeResource BrandPageBgBrush}"
                BorderBrush="{ThemeResource BrandDividerBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <StackPanel
                        x:Name="SpokenSamplePanel"
                        Opacity="0"
                        Spacing="{StaticResource BrandSpacingXs}"
                        VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="SpokenTranslate" Y="0" />
                        </StackPanel.RenderTransform>
                        <TextBlock
                            FontSize="15"
                            LineHeight="22"
                            Style="{StaticResource BrandBodyStyle}"
                            Text="&quot;Um, hey Sarah, uh, can we like move the, wait no, push the Thursday design review to Friday at two thirty? And, um, let's also add the Q3 budget slides.&quot;"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        x:Name="PolishedSamplePanel"
                        Opacity="1"
                        Spacing="{StaticResource BrandSpacingS}"
                        VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PolishedTranslate" Y="0" />
                        </StackPanel.RenderTransform>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource BrandTextPrimaryBrush}"
                            LineHeight="22"
                            Style="{StaticResource BrandBodyStyle}"
                            Text="Hi Sarah,"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="15"
                            Foreground="{ThemeResource BrandTextPrimaryBrush}"
                            LineHeight="22"
                            Style="{StaticResource BrandBodyStyle}"
                            Text="Can we move the Thursday design review to Friday at 2:30 PM and add the Q3 budget slides?"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center">
                <FontIcon
                    x:Name="CaptionIcon"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="14"
                    Foreground="{ThemeResource BrandSuccessBrush}"
                    Glyph="\uE73E" />
                <TextBlock
                    x:Name="DemoCaptionText"
                    Style="{StaticResource BrandHelperStyle}"
                    Text="Removed fillers, fixed a self-correction, and formatted the greeting and time."
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
