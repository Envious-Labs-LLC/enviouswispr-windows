<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EnviousWispr.App.Pages.OnboardingPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:EnviousWispr.Core.Settings"
    xmlns:local="using:EnviousWispr.App"
    xmlns:controls="using:EnviousWispr.App.Controls">
    <Grid x:Name="OnboardingView" x:FieldModifier="internal" Background="{ThemeResource BrandPageBgBrush}" Visibility="Collapsed" PreviewKeyDown="OnboardingView_PreviewKeyDown" PreviewKeyUp="OnboardingView_PreviewKeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
            WINDOW CHROME: Back navigation, segmented step progress bar (hidden on Welcome & Closing),
            and the subtle floating download pill once background model downloads begin.
        -->
        <Border x:Name="OnboardingChromeBar" x:FieldModifier="internal" Grid.Row="0" Padding="{StaticResource BrandOnboardingChromePadding}" MinHeight="{StaticResource BrandOnboardingChromeHeight}" Visibility="Collapsed">
            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OnboardingBackButton" x:FieldModifier="internal" Grid.Column="0" Click="OnboardingBackButton_Click" Style="{StaticResource BrandQuietButtonStyle}" AutomationProperties.Name="Go back to the previous setup step" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Back" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid x:Name="OnboardingProgressGrid" x:FieldModifier="internal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="{StaticResource BrandOnboardingKeycapMinWidth}" MaxWidth="{StaticResource BrandOnboardingHeroMaxWidth}" ColumnSpacing="{StaticResource BrandSpacingXs}" Visibility="Collapsed" />
                <Button x:Name="OnboardingDownloadPillButton" x:FieldModifier="internal" Grid.Column="2" Click="OnboardingDownloadPillButton_Click" Style="{StaticResource BrandQuietButtonStyle}" Padding="{StaticResource BrandOnboardingDownloadPillPadding}" AutomationProperties.Name="View background model downloads" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                        <Ellipse x:Name="OnboardingDownloadPillDot" x:FieldModifier="internal" Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandAccentBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="OnboardingDownloadPillText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Downloading models" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer x:Name="OnboardingScroll" x:FieldModifier="internal" Grid.Row="1" AutomationProperties.Name="EnviousWispr setup" HorizontalScrollMode="Disabled">
        <Grid x:Name="OnboardingContent" x:FieldModifier="internal" Padding="{StaticResource BrandOnboardingContentPadding}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100*" MaxWidth="{StaticResource BrandOnboardingContentColumnMaxWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSectionSpacing}">
                <InfoBar x:Name="OnboardingReliabilityInfoBar" x:FieldModifier="internal" IsClosable="False" IsOpen="False" Severity="Warning" />

                <StackPanel x:Name="OnboardingStepHeader" x:FieldModifier="internal" Spacing="{StaticResource BrandOnboardingTextSpacing}" Visibility="Collapsed">
                    <TextBlock x:Name="OnboardingStepText" x:FieldModifier="internal" Style="{StaticResource BrandSubsectionEyebrowStyle}" Text="STEP 2 OF 11" />
                    <TextBlock x:Name="OnboardingTitle" x:FieldModifier="internal" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource BrandPageTitleStyle}" Text="Your voice, instantly captured." TextWrapping="Wrap" />
                    <TextBlock x:Name="OnboardingSubtitle" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="The privacy-first dictation app built for Windows." TextWrapping="Wrap" />
                </StackPanel>

                <!-- 1. WELCOME -->
                <StackPanel x:Name="OnboardingWelcomePanel" x:FieldModifier="internal" MaxWidth="{StaticResource BrandOnboardingWelcomeMaxWidth}" HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingXl}">
                    <StackPanel.Resources>
                        <Storyboard x:Name="OnboardingLipsBreathStoryboard" x:FieldModifier="internal" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="OnboardingRainbowLipsContainer" Storyboard.TargetProperty="Opacity" From="0.82" To="1.0" Duration="0:0:2.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </StackPanel.Resources>
                    <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingL}">
                        <Border x:Name="OnboardingRainbowLipsContainer" x:FieldModifier="internal" Padding="24,18" Background="{ThemeResource BrandCardBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{ThemeResource BrandSectionRadius}" HorizontalAlignment="Center">
                            <StackPanel x:Name="OnboardingRainbowLipsBars" x:FieldModifier="internal" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" HorizontalAlignment="Center" VerticalAlignment="Center" Height="64" AutomationProperties.AccessibilityView="Raw">
                                <Border Width="{StaticResource BrandOnboardingLipBarWidth}" Height="20" Background="{ThemeResource BrandSpectrumRedBrush}" CornerRadius="{StaticResource BrandOnboardingLipBarRadius}" VerticalAlignment="Center" />
                                <Border Width="{StaticResource BrandOnboardingLipBarWidth}" Height="34" Background="{ThemeResource BrandSpectrumOrangeBrush}" CornerRadius="{StaticResource BrandOnboardingLipBarRadius}" VerticalAlignment="Center" />
                                <Border Width="{StaticResource BrandOnboardingLipBarWidth}" Height="48" Background="{ThemeResource BrandSpectrumGoldBrush}" CornerRadius="{StaticResource BrandOnboardingLipBarRadius}" VerticalAlignment="Center" />
                                <Border Width="{StaticResource BrandOnboardingLipBarWidth}" Height="40" Background="{ThemeResource BrandSpectrumLimeBrush}" CornerRadius="{StaticResource BrandOnboardingLipBarRadius}" VerticalAlignment="Center" />
                                <Border Width="{StaticResource BrandOnboardingLipBarWidth}" Height="26" Background="{ThemeResource BrandSpectrumSpringBrush}" CornerRadius="{StaticResource BrandOnboardingLipBarRadius}" VerticalAlignment="Center" />
                                <Border Width="{StaticResource BrandOnboardingLipBarWidth}" Height="40" Background="{ThemeResource BrandSpectrumCyanBrush}" CornerRadius="{StaticResource BrandOnboardingLipBarRadius}" VerticalAlignment="Center" />
                                <Border Width="{StaticResource BrandOnboardingLipBarWidth}" Height="48" Background="{ThemeResource BrandSpectrumBlueBrush}" CornerRadius="{StaticResource BrandOnboardingLipBarRadius}" VerticalAlignment="Center" />
                                <Border Width="{StaticResource BrandOnboardingLipBarWidth}" Height="34" Background="{ThemeResource BrandSpectrumRoyalBrush}" CornerRadius="{StaticResource BrandOnboardingLipBarRadius}" VerticalAlignment="Center" />
                                <Border Width="{StaticResource BrandOnboardingLipBarWidth}" Height="20" Background="{ThemeResource BrandSpectrumVioletBrush}" CornerRadius="{StaticResource BrandOnboardingLipBarRadius}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="OnboardingWelcomeHeadline" x:FieldModifier="internal" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource BrandHeroDisplayTitleStyle}" Text="Talk naturally. Capture perfectly." TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="OnboardingWelcomeSubtitle" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Fast, private voice dictation tailored to your language and PC hardware." TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource BrandSettingsCardStyle}" Padding="14">
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                <Border Width="32" Height="32" CornerRadius="8" Style="{StaticResource BrandIconTileStyle}" HorizontalAlignment="Left">
                                    <FontIcon FontSize="15" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE72E;" AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Private audio" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Speech stays on your PC." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource BrandSettingsCardStyle}" Padding="14">
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                <Border Width="32" Height="32" CornerRadius="8" Style="{StaticResource BrandIconTileStyle}" HorizontalAlignment="Left">
                                    <FontIcon FontSize="15" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE945;" AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Instant accuracy" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Runs fast on GPU or CPU." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource BrandSettingsCardStyle}" Padding="14">
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                <Border Width="32" Height="32" CornerRadius="8" Style="{StaticResource BrandIconTileStyle}" HorizontalAlignment="Left">
                                    <FontIcon FontSize="15" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE8A7;" AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Works anywhere" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Pastes where your cursor sits." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource BrandSettingsCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE77B;" AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingS}">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Privacy &amp; telemetry" />
                                <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Audio stays on this PC; dictated text stays local unless you turn on cloud polish. Anonymous usage metrics and crash reports are on by default to help us catch broken updates, and can be turned off anytime in Diagnostics." TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Uninstalling keeps your history and downloaded models. To remove them, use Delete all EnviousWispr data on the Your data page before you uninstall." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 2. LANGUAGE -->
                <StackPanel x:Name="OnboardingLanguagePanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Border x:Name="OnboardingLanguageGreetingCard" x:FieldModifier="internal" Style="{StaticResource BrandHeaderCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock x:Name="OnboardingLanguageGreetingText" x:FieldModifier="internal" FontSize="{StaticResource BrandOnboardingGreetingFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="Hello!" TextWrapping="Wrap" />
                                <TextBlock x:Name="OnboardingLanguageSelectedTitleText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Detect automatically" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="OnboardingLanguageEngineBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandAccentChipStyle}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                    <Ellipse x:Name="OnboardingLanguageEngineDot" x:FieldModifier="internal" Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandAccentBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Name="OnboardingLanguageEngineBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Parakeet · 25 languages" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Button x:Name="OnboardingSuggestedLanguageButton" x:FieldModifier="internal" Click="OnboardingSuggestedLanguageButton_Click" Style="{StaticResource BrandQuietButtonStyle}" HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                            <FontIcon FontSize="14" Glyph="&#xE774;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="OnboardingSuggestedLanguageText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Foreground="{ThemeResource BrandAccentBrush}" Text="Suggested from Windows: English" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <RadioButton x:Name="OnboardingDetectAutoCard" x:FieldModifier="internal" GroupName="OnboardingLanguageAuto" Checked="OnboardingDetectAutoCard_Checked" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Style="{StaticResource BrandSelectableCardStyle}" AutomationProperties.Name="Detect automatically">
                        <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Detect automatically" />
                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Recognizes spoken languages on the fly. You can lock a specific language anytime." TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <Border Style="{StaticResource BrandSettingsCardStyle}" Padding="14">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <TextBox x:Name="OnboardingLanguageSearchBox" x:FieldModifier="internal" PlaceholderText="Search 99+ languages" AutomationProperties.Name="Search 99+ languages" TextChanged="OnboardingLanguageSearchBox_TextChanged" KeyDown="OnboardingLanguageSearchBox_KeyDown" />
                            <Grid Height="{StaticResource BrandOnboardingLanguageListHeight}">
                                <ListView x:Name="OnboardingLanguageListView" x:FieldModifier="internal" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnboardingLanguageListView_ItemClick" AutomationProperties.Name="Available dictation languages">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,8" ColumnSpacing="{StaticResource BrandSpacingM}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="{StaticResource BrandSpacingXs}">
                                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource BrandNeutralChipStyle}" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource BrandNeutralChipTextStyle}" Text="{Binding EngineLabel}" />
                                                </Border>
                                                <FontIcon Grid.Column="2" FontSize="16" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE73E;" VerticalAlignment="Center" Visibility="{Binding SelectedVisibility}" AutomationProperties.AccessibilityView="Raw" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="OnboardingLanguageEmptyText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="No matching language found. Clear the filter or pick Detect automatically." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. SPEECH PICK -->
                <StackPanel x:Name="OnboardingSpeechPickPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Border x:Name="OnboardingSpeechPickCard" x:FieldModifier="internal" Style="{StaticResource BrandSettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                <Border Style="{StaticResource BrandAccentChipStyle}">
                                    <TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended for your PC" />
                                </Border>
                                <Border x:Name="OnboardingSpeechInstallBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}">
                                    <TextBlock x:Name="OnboardingSpeechInstallBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="~470 MB download" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="OnboardingSpeechPickTitle" x:FieldModifier="internal" Style="{StaticResource BrandPageTitleStyle}" Text="Meet Parakeet" TextWrapping="Wrap" />
                            <TextBlock x:Name="OnboardingSpeechPickDescription" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Fast, accurate local speech recognition tailored to your PC and language." TextWrapping="Wrap" />
                            <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingS}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon Grid.Row="0" Grid.Column="0" Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE896;" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="OnboardingSpeechPickSizeText" x:FieldModifier="internal" Grid.Row="0" Grid.Column="1" Style="{StaticResource BrandBodyStyle}" Text="Download size: ~470 MB" TextWrapping="Wrap" />
                                <FontIcon Grid.Row="1" Grid.Column="0" Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE945;" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="OnboardingSpeechPickSpeedText" x:FieldModifier="internal" Grid.Row="1" Grid.Column="1" Style="{StaticResource BrandBodyStyle}" Text="Runs fast on your processor" TextWrapping="Wrap" />
                                <FontIcon Grid.Row="2" Grid.Column="0" Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE774;" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="OnboardingSpeechPickLanguageNoteText" x:FieldModifier="internal" Grid.Row="2" Grid.Column="1" Style="{StaticResource BrandHelperStyle}" Text="Supports 25 European languages" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button x:Name="OnboardingOpenSpeechCompareButton" x:FieldModifier="internal" Click="OnboardingOpenSpeechCompareButton_Click" Content="Compare speech models" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" />
                </StackPanel>

                <!-- 4. SPEECH COMPARE -->
                <StackPanel x:Name="OnboardingSpeechComparePanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Grid x:Name="OnboardingSpeechCompareGrid" x:FieldModifier="internal" ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingM}" SizeChanged="OnboardingSpeechCompareGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OnboardingSpeechCompareCol0" x:FieldModifier="internal" Width="*" />
                            <ColumnDefinition x:Name="OnboardingSpeechCompareCol1" x:FieldModifier="internal" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <RadioButton x:Name="OnboardingParakeetCompareCard" x:FieldModifier="internal" Grid.Row="0" Grid.Column="0" Tag="Parakeet" GroupName="OnboardingSpeechCompare" Checked="OnboardingSpeechCompareCard_Checked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="18" Style="{StaticResource BrandSelectableCardStyle}" AutomationProperties.Name="Parakeet speech model">
                            <StackPanel Margin="0,0,28,0" Spacing="{StaticResource BrandSpacingS}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Parakeet" />
                                    <Border x:Name="OnboardingParakeetCompareRecommendedBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended" />
                                    </Border>
                                </StackPanel>
                                <Border x:Name="OnboardingParakeetCompareStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}" HorizontalAlignment="Left">
                                    <TextBlock x:Name="OnboardingParakeetCompareStatusBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="25 European languages" />
                                </Border>
                                <TextBlock x:Name="OnboardingParakeetCompareSizeText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Download: ~470 MB" TextWrapping="Wrap" />
                                <TextBlock x:Name="OnboardingParakeetCompareSpeedText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Fast on CPU and GPU. Ideal for everyday dictation in 25 European languages." TextWrapping="Wrap" />
                                <TextBlock x:Name="OnboardingParakeetCompareDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Fastest turnaround on this PC." TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OnboardingWhisperCompareCard" x:FieldModifier="internal" Grid.Row="0" Grid.Column="1" Tag="Whisper" GroupName="OnboardingSpeechCompare" Checked="OnboardingSpeechCompareCard_Checked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="18" Style="{StaticResource BrandSelectableCardStyle}" AutomationProperties.Name="Whisper speech model">
                            <StackPanel Margin="0,0,28,0" Spacing="{StaticResource BrandSpacingS}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Whisper" />
                                    <Border x:Name="OnboardingWhisperCompareRecommendedBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended" />
                                    </Border>
                                </StackPanel>
                                <Border x:Name="OnboardingWhisperCompareStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" HorizontalAlignment="Left">
                                    <TextBlock x:Name="OnboardingWhisperCompareStatusBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="99+ languages" />
                                </Border>
                                <TextBlock x:Name="OnboardingWhisperCompareSizeText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Download: ~530 MB" TextWrapping="Wrap" />
                                <TextBlock x:Name="OnboardingWhisperCompareSpeedText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Covers 99+ languages and mixed-script dictation with high accuracy." TextWrapping="Wrap" />
                                <TextBlock x:Name="OnboardingWhisperCompareDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Best with NVIDIA GPU; runs slightly slower on CPU." TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>

                <!-- 5. POLISH INTRO -->
                <StackPanel x:Name="OnboardingPolishIntroPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Border Style="{StaticResource BrandSettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BrandBodyStyle}" Text="Fixes grammar, capitalization, and punctuation cleanly without changing your voice." TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BrandBodyStyle}" Text="Strips out filler words such as um, uh, and false starts as you speak." TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BrandBodyStyle}" Text="Formats spoken bullet lists and natural paragraphs automatically." TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BrandBodyStyle}" Text="Respects your personal vocabulary and custom snippet expansions." TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BrandBodyStyle}" Text="Runs offline on your PC with EG-1, with zero per-use fees or account sign-in." TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BrandBodyStyle}" Text="Optional: connect your own OpenAI, Gemini, or Claude key instead, or skip anytime." TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6. POLISH PICK -->
                <StackPanel x:Name="OnboardingPolishPickPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Border Style="{StaticResource BrandAccentChipStyle}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                            <FontIcon FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE7F4;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
