                        </StackPanel>
                    </Border>

                    <Border x:Name="OnboardingPolishLowSpecCard" x:FieldModifier="internal" Background="{ThemeResource BrandWarningSoftBrush}" BorderBrush="{ThemeResource BrandWarningBrush}" BorderThickness="1" CornerRadius="{ThemeResource BrandSectionRadius}" Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="{StaticResource BrandSpacingS}">
                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Local AI polish may be heavy on this PC" />
                            <TextBlock x:Name="OnboardingPolishLowSpecDetailText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Running local AI polish alongside speech recognition needs extra memory on this PC. Using your own cloud key or skipping AI polish keeps dictation snappy." TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                <Button x:Name="OnboardingPolishLowSpecCloudButton" x:FieldModifier="internal" Click="OnboardingPolishLowSpecCloudButton_Click" Content="Use Cloud" Style="{StaticResource BrandQuietButtonStyle}" />
                                <Button x:Name="OnboardingPolishLowSpecSkipButton" x:FieldModifier="internal" Click="OnboardingSkipPolish_Click" Content="Skip AI polish" Style="{StaticResource BrandQuietButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="OnboardingPolishPickGrid" x:FieldModifier="internal" ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingM}" SizeChanged="OnboardingPolishPickGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OnboardingPolishPickCol0" x:FieldModifier="internal" Width="*" />
                            <ColumnDefinition x:Name="OnboardingPolishPickCol1" x:FieldModifier="internal" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <RadioButton x:Name="OnboardingPolishPrimaryCard" x:FieldModifier="internal" Grid.Row="0" Grid.Column="0" GroupName="OnboardingPolishPrimary" Checked="OnboardingPolishPrimaryCard_Checked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="18" Style="{StaticResource BrandSelectableCardStyle}">
                            <StackPanel Margin="0,0,28,0" Spacing="{StaticResource BrandSpacingS}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <TextBlock x:Name="OnboardingPolishPrimaryTitleText" x:FieldModifier="internal" Style="{StaticResource BrandRowTitleStyle}" Text="EG-1 Mini" />
                                    <Border x:Name="OnboardingPolishPrimaryTagBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}">
                                        <TextBlock x:Name="OnboardingPolishPrimaryTagText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended for your PC" />
                                    </Border>
                                </StackPanel>
                                <Border x:Name="OnboardingPolishPrimaryStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}" HorizontalAlignment="Left">
                                    <TextBlock x:Name="OnboardingPolishPrimaryStatusText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="~1.4 GB download" />
                                </Border>
                                <TextBlock x:Name="OnboardingPolishPrimaryDescText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="High accuracy at half the memory footprint." TextWrapping="Wrap" />
                                <TextBlock x:Name="OnboardingPolishPrimarySpecsText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="High accuracy · Fast · ~1.6 GB memory" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OnboardingPolishSecondaryCard" x:FieldModifier="internal" Grid.Row="0" Grid.Column="1" GroupName="OnboardingPolishPrimary" Checked="OnboardingPolishPrimaryCard_Checked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="18" Style="{StaticResource BrandSelectableCardStyle}">
                            <StackPanel Margin="0,0,28,0" Spacing="{StaticResource BrandSpacingS}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <TextBlock x:Name="OnboardingPolishSecondaryTitleText" x:FieldModifier="internal" Style="{StaticResource BrandRowTitleStyle}" Text="EG-1 Micro" />
                                    <Border x:Name="OnboardingPolishSecondaryTagBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}">
                                        <TextBlock x:Name="OnboardingPolishSecondaryTagText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Smaller download" />
                                    </Border>
                                </StackPanel>
                                <Border x:Name="OnboardingPolishSecondaryStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}" HorizontalAlignment="Left">
                                    <TextBlock x:Name="OnboardingPolishSecondaryStatusText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="~520 MB download" />
                                </Border>
                                <TextBlock x:Name="OnboardingPolishSecondaryDescText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Ultra-lightweight model built for fast local polish." TextWrapping="Wrap" />
                                <TextBlock x:Name="OnboardingPolishSecondarySpecsText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Lightweight · Fastest · ~1.0 GB memory" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingM}">
                        <Button x:Name="OnboardingOpenPolishSeeAllButton" x:FieldModifier="internal" Click="OnboardingOpenPolishSeeAllButton_Click" Content="See all options" Style="{StaticResource BrandQuietButtonStyle}" />
                        <HyperlinkButton x:Name="OnboardingPolishPickSkipButton" x:FieldModifier="internal" Click="OnboardingSkipPolish_Click" Content="Skip AI polish" Style="{StaticResource BrandHyperlinkButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- 7. POLISH SEE ALL (On this PC + Cloud) -->
                <StackPanel x:Name="OnboardingPolishSeeAllPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="9" Background="{ThemeResource BrandAccentLightBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <Button x:Name="OnboardingPolishTabLocalButton" x:FieldModifier="internal" Click="OnboardingPolishTabLocalButton_Click" Content="On this PC" Style="{StaticResource BrandSegmentedActiveButtonStyle}" />
                                <Button x:Name="OnboardingPolishTabCloudButton" x:FieldModifier="internal" Click="OnboardingPolishTabCloudButton_Click" Content="Cloud" Style="{StaticResource BrandSegmentedButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource BrandAccentChipStyle}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="OnboardingSeeAllHardwareBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="This PC" />
                        </Border>
                    </Grid>

                    <StackPanel x:Name="OnboardingSeeAllLocalPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}">
                        <Grid x:Name="OnboardingSeeAllEgOneGrid" x:FieldModifier="internal" ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingM}" SizeChanged="OnboardingSeeAllEgOneGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="OnboardingSeeAllCol0" x:FieldModifier="internal" Width="*" />
                                <ColumnDefinition x:Name="OnboardingSeeAllCol1" x:FieldModifier="internal" Width="*" />
                                <ColumnDefinition x:Name="OnboardingSeeAllCol2" x:FieldModifier="internal" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="OnboardingSeeAllEgOneFullCard" x:FieldModifier="internal" Grid.Row="0" Grid.Column="0" Tag="eg-1" GroupName="OnboardingPolishSeeAll" Checked="OnboardingSeeAllEgOneCard_Checked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="16" Style="{StaticResource BrandSelectableCardStyle}">
                                <StackPanel Margin="0,0,28,0" Spacing="{StaticResource BrandSpacingXs}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="EG-1" />
                                        <Border x:Name="OnboardingSeeAllFullRecBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" Visibility="Collapsed"><TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended" /></Border>
                                    </StackPanel>
                                    <Border x:Name="OnboardingSeeAllFullStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}" HorizontalAlignment="Left"><TextBlock x:Name="OnboardingSeeAllFullStatusText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="~3.0 GB" /></Border>
                                    <TextBlock x:Name="OnboardingSeeAllFullTaglineText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Foreground="{ThemeResource BrandAccentBrush}" Text="Best quality" />
                                    <TextBlock x:Name="OnboardingSeeAllFullDescText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="The most accurate offline model for long dictations and multilingual cleanup." TextWrapping="Wrap" />
                                    <TextBlock x:Name="OnboardingSeeAllFullSpecsText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="Best accuracy · Standard speed · ~3.4 GB memory" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="OnboardingSeeAllEgOneMiniCard" x:FieldModifier="internal" Grid.Row="0" Grid.Column="1" Tag="eg-1-mini" GroupName="OnboardingPolishSeeAll" Checked="OnboardingSeeAllEgOneCard_Checked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="16" Style="{StaticResource BrandSelectableCardStyle}">
                                <StackPanel Margin="0,0,28,0" Spacing="{StaticResource BrandSpacingXs}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="EG-1 Mini" />
                                        <Border x:Name="OnboardingSeeAllMiniRecBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" Visibility="Collapsed"><TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended" /></Border>
                                    </StackPanel>
                                    <Border x:Name="OnboardingSeeAllMiniStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}" HorizontalAlignment="Left"><TextBlock x:Name="OnboardingSeeAllMiniStatusText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="~1.4 GB" /></Border>
                                    <TextBlock x:Name="OnboardingSeeAllMiniTaglineText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Foreground="{ThemeResource BrandAccentBrush}" Text="Fast all-rounder" />
                                    <TextBlock x:Name="OnboardingSeeAllMiniDescText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="High accuracy at roughly half the size of EG-1." TextWrapping="Wrap" />
                                    <TextBlock x:Name="OnboardingSeeAllMiniSpecsText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="High accuracy · Fast · ~1.6 GB memory" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="OnboardingSeeAllEgOneMicroCard" x:FieldModifier="internal" Grid.Row="0" Grid.Column="2" Tag="eg-1-micro" GroupName="OnboardingPolishSeeAll" Checked="OnboardingSeeAllEgOneCard_Checked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="16" Style="{StaticResource BrandSelectableCardStyle}">
                                <StackPanel Margin="0,0,28,0" Spacing="{StaticResource BrandSpacingXs}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="EG-1 Micro" />
                                        <Border x:Name="OnboardingSeeAllMicroRecBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" Visibility="Collapsed"><TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended" /></Border>
                                    </StackPanel>
                                    <Border x:Name="OnboardingSeeAllMicroStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}" HorizontalAlignment="Left"><TextBlock x:Name="OnboardingSeeAllMicroStatusText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="~520 MB" /></Border>
                                    <TextBlock x:Name="OnboardingSeeAllMicroTaglineText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Foreground="{ThemeResource BrandAccentBrush}" Text="Smallest and fastest" />
                                    <TextBlock x:Name="OnboardingSeeAllMicroDescText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Ultra-lightweight model built for CPU laptops and tighter memory." TextWrapping="Wrap" />
                                    <TextBlock x:Name="OnboardingSeeAllMicroSpecsText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="Lightweight · Fastest · ~1.0 GB memory" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>

                    <Border x:Name="OnboardingSeeAllCloudPanel" x:FieldModifier="internal" Style="{StaticResource BrandSettingsCardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Choose your cloud provider" />
                                <Border CornerRadius="9" Background="{ThemeResource BrandAccentLightBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                        <Button x:Name="OnboardingCloudOpenAiButton" x:FieldModifier="internal" Click="OnboardingCloudProviderButton_Click" Tag="OpenAI" Content="OpenAI" Style="{StaticResource BrandSegmentedActiveButtonStyle}" />
                                        <Button x:Name="OnboardingCloudGeminiButton" x:FieldModifier="internal" Click="OnboardingCloudProviderButton_Click" Tag="Gemini" Content="Gemini" Style="{StaticResource BrandSegmentedButtonStyle}" />
                                        <Button x:Name="OnboardingCloudClaudeButton" x:FieldModifier="internal" Click="OnboardingCloudProviderButton_Click" Tag="Claude" Content="Claude" Style="{StaticResource BrandSegmentedButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock x:Name="OnboardingCloudApiKeyLabel" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="API key" />
                                <PasswordBox x:Name="OnboardingCloudApiKeyBox" x:FieldModifier="internal" AutomationProperties.LabeledBy="{x:Bind OnboardingCloudApiKeyLabel, Mode=OneTime}" PlaceholderText="Enter API key" MaxLength="1280" PasswordChanged="OnboardingCloudApiKeyBox_PasswordChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <Button x:Name="OnboardingCloudCheckKeyButton" x:FieldModifier="internal" Click="OnboardingCloudCheckKeyButton_Click" Content="Check my key" Style="{StaticResource BrandQuietButtonStyle}" />
                                    <Button x:Name="OnboardingCloudClearKeyButton" x:FieldModifier="internal" Click="OnboardingCloudClearKeyButton_Click" Content="Clear" Style="{StaticResource BrandQuietButtonStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="OnboardingCloudKeyStatusText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock x:Name="OnboardingCloudModelLabel" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Model" />
                                <ComboBox x:Name="OnboardingCloudModelComboBox" x:FieldModifier="internal" AutomationProperties.LabeledBy="{x:Bind OnboardingCloudModelLabel, Mode=OneTime}" HorizontalAlignment="Stretch" PlaceholderText="Recommended default" SelectionChanged="OnboardingCloudModelComboBox_SelectionChanged" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="API keys stay in Windows Credential Manager and are never saved in onboarding checkpoints or exports. Dictated audio always stays on this PC." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <HyperlinkButton x:Name="OnboardingSeeAllSkipButton" x:FieldModifier="internal" Click="OnboardingSkipPolish_Click" Content="Skip AI polish" HorizontalAlignment="Left" Style="{StaticResource BrandHyperlinkButtonStyle}" />
                </StackPanel>

                <!-- 8. DOWNLOADS -->
                <StackPanel x:Name="OnboardingDownloadsPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Border x:Name="OnboardingSpeechDownloadCard" x:FieldModifier="internal" Style="{StaticResource BrandSettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource BrandSpacingS}">
                            <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="OnboardingSpeechDownloadNameText" x:FieldModifier="internal" Grid.Column="0" Style="{StaticResource BrandRowLabelStyle}" Text="Parakeet speech model" />
                                <Border x:Name="OnboardingSpeechDownloadBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandAccentChipStyle}"><TextBlock x:Name="OnboardingSpeechDownloadBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Preparing" /></Border>
                            </Grid>
                            <ProgressBar x:Name="OnboardingSpeechDownloadProgress" x:FieldModifier="internal" AutomationProperties.Name="Speech model download progress" Background="{ThemeResource BrandDividerBrush}" Foreground="{ThemeResource BrandAccentSolidBrush}" Maximum="100" Minimum="0" Value="0" />
                            <TextBlock x:Name="OnboardingSpeechDownloadDetailText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" Text="Starting speech model download..." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="OnboardingPolishDownloadCard" x:FieldModifier="internal" Style="{StaticResource BrandSettingsCardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="{StaticResource BrandSpacingS}">
                            <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="OnboardingPolishDownloadNameText" x:FieldModifier="internal" Grid.Column="0" Style="{StaticResource BrandRowLabelStyle}" Text="EG-1 Mini AI polish" />
                                <Border x:Name="OnboardingPolishDownloadBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandAccentChipStyle}"><TextBlock x:Name="OnboardingPolishDownloadBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Queued" /></Border>
                            </Grid>
                            <ProgressBar x:Name="OnboardingPolishDownloadProgress" x:FieldModifier="internal" AutomationProperties.Name="AI polish model download progress" Background="{ThemeResource BrandDividerBrush}" Foreground="{ThemeResource BrandAccentSolidBrush}" Maximum="100" Minimum="0" Value="0" />
                            <TextBlock x:Name="OnboardingPolishDownloadDetailText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" Text="Waiting to start..." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                        <Button x:Name="OnboardingDownloadCancelButton" x:FieldModifier="internal" Click="OnboardingDownloadCancelButton_Click" Content="Pause download" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                        <Button x:Name="OnboardingDownloadRetryButton" x:FieldModifier="internal" Click="OnboardingDownloadRetryButton_Click" Content="Retry download" Style="{StaticResource BrandPrimaryButtonStyle}" Visibility="Collapsed" />
                        <Button x:Name="OnboardingDownloadSkipPolishButton" x:FieldModifier="internal" Click="OnboardingSkipPolishAndAdvance_Click" Content="Continue without AI polish" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="You can click Continue right now to finish microphone and shortcut setup while your models finish downloading in the background." TextWrapping="Wrap" />
                </StackPanel>

                <!-- 9. PERMISSIONS -->
                <StackPanel x:Name="OnboardingPermissionsPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Border Style="{StaticResource BrandSettingsCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Top">
                                <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE720;" AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Allow microphone access" />
                                <TextBlock Style="{StaticResource BrandBodyStyle}" Text="EnviousWispr listens only while you hold or toggle your dictation key." TextWrapping="Wrap" />
