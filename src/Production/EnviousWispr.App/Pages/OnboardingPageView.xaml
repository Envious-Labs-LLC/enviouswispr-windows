                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                        <Ellipse Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandSuccessBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Style="{StaticResource BrandSuccessChipTextStyle}" Text="Allowed" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OnboardingMicNeedsAttentionBadge" x:FieldModifier="internal" Style="{StaticResource BrandWarningChipStyle}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                        <Ellipse Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandWarningBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Style="{StaticResource BrandWarningChipTextStyle}" Text="Needs attention" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BrandSettingsCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="No Accessibility permission needed on Windows" />
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Windows lets EnviousWispr paste into your apps directly using native input APIs, so microphone access is the only permission required." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 10. KEY -->
                <StackPanel x:Name="OnboardingKeyPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Border Style="{StaticResource BrandSettingsCardStyle}">
                        <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingM}">
                            <Button x:Name="OnboardingKeycapButton" x:FieldModifier="internal" Click="OnboardingKeycapButton_Click" MinWidth="{StaticResource BrandOnboardingKeycapMinWidth}" MinHeight="{StaticResource BrandOnboardingKeycapMinHeight}" Padding="{StaticResource BrandOnboardingKeycapPadding}" CornerRadius="{StaticResource BrandOnboardingKeycapRadius}" Style="{StaticResource BrandQuietButtonStyle}" HorizontalAlignment="Center" AutomationProperties.Name="Current dictation shortcut. Click to set a custom keybind.">
                                <TextBlock x:Name="OnboardingKeycapText" x:FieldModifier="internal" FontSize="{StaticResource BrandOnboardingKeycapFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource BrandAccentBrush}" Text="Ctrl+Win" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock x:Name="OnboardingKeycapHintText" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Click the keycap to capture a custom key, or pick a preset below." TextAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" HorizontalAlignment="Center">
                                <Button x:Name="OnboardingPresetCtrlWinButton" x:FieldModifier="internal" Click="OnboardingPresetHotkeyButton_Click" Tag="Ctrl+Win" Content="Ctrl+Win" Style="{StaticResource BrandQuietActiveButtonStyle}" />
                                <Button x:Name="OnboardingPresetRightCtrlButton" x:FieldModifier="internal" Click="OnboardingPresetHotkeyButton_Click" Tag="RightCtrl" Content="RightCtrl" Style="{StaticResource BrandQuietButtonStyle}" />
                                <Button x:Name="OnboardingPresetF8Button" x:FieldModifier="internal" Click="OnboardingPresetHotkeyButton_Click" Tag="F8" Content="F8" Style="{StaticResource BrandQuietButtonStyle}" />
                                <Button x:Name="OnboardingPresetAltSpaceButton" x:FieldModifier="internal" Click="OnboardingPresetHotkeyButton_Click" Tag="Alt+Space" Content="Alt+Space" Style="{StaticResource BrandQuietButtonStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="OnboardingKeyStatusText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Polite" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource BrandSettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Try your key right now" />
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="OnboardingRehearsalHoldCard" x:FieldModifier="internal" Grid.Column="0" Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{ThemeResource BrandSectionRadius}" Padding="14">
                                    <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Hold to dictate" />
                                            <Border x:Name="OnboardingRehearsalHoldBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}">
                                                <TextBlock x:Name="OnboardingRehearsalHoldBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Try holding" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="OnboardingRehearsalHoldDescText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Hold down your key while you speak, then let go." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OnboardingRehearsalDoubleTapCard" x:FieldModifier="internal" Grid.Column="1" Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{ThemeResource BrandSectionRadius}" Padding="14">
                                    <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Double-press hands-free" />
                                            <Border x:Name="OnboardingRehearsalDoubleTapBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}">
                                                <TextBlock x:Name="OnboardingRehearsalDoubleTapBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Tap twice" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="OnboardingRehearsalDoubleTapDescText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Double-press to keep recording without holding." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="OnboardingKeyFooterNoteText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Your chosen key applies immediately for practice and everyday dictation. Change it any time on the Keybinds page." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 11. GETTING READY (GATE) -->
                <StackPanel x:Name="OnboardingGettingReadyPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                    <Border Style="{StaticResource BrandSettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BrandRowLabelStyle}" Text="Speech model" />
                                    <Border x:Name="OnboardingGateSpeechBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandNeutralChipStyle}"><TextBlock x:Name="OnboardingGateSpeechBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Checking" /></Border>
                                </Grid>
                                <TextBlock x:Name="OnboardingGateSpeechDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Preparing your speech engine..." TextWrapping="Wrap" />
                                <ProgressBar x:Name="OnboardingGateSpeechProgress" x:FieldModifier="internal" Maximum="100" Minimum="0" Visibility="Collapsed" />
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />
                            <StackPanel x:Name="OnboardingGatePolishRow" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingXs}">
                                <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BrandRowLabelStyle}" Text="AI polish" />
                                    <Border x:Name="OnboardingGatePolishBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandNeutralChipStyle}"><TextBlock x:Name="OnboardingGatePolishBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Checking" /></Border>
                                </Grid>
                                <TextBlock x:Name="OnboardingGatePolishDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Preparing local polish..." TextWrapping="Wrap" />
                                <ProgressBar x:Name="OnboardingGatePolishProgress" x:FieldModifier="internal" Maximum="100" Minimum="0" Visibility="Collapsed" />
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />
                            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BrandRowLabelStyle}" Text="Microphone" />
                                    <Border x:Name="OnboardingGateMicBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandSuccessChipStyle}"><TextBlock x:Name="OnboardingGateMicBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandSuccessChipTextStyle}" Text="Allowed" /></Border>
                                </Grid>
                                <TextBlock x:Name="OnboardingGateMicDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Microphone access verified." TextWrapping="Wrap" />
                                <Button x:Name="OnboardingGateMicSettingsButton" x:FieldModifier="internal" Click="OpenMicrophonePrivacyButton_Click" Content="Open Microphone Settings" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                        <Button x:Name="OnboardingGateRetryButton" x:FieldModifier="internal" Click="OnboardingDownloadRetryButton_Click" Content="Retry downloads" Style="{StaticResource BrandPrimaryButtonStyle}" Visibility="Collapsed" />
                        <Button x:Name="OnboardingGateSkipPolishButton" x:FieldModifier="internal" Click="OnboardingGateSkipPolishButton_Click" Content="Continue without AI polish" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <!-- 12. PRACTICE -->
                <StackPanel x:Name="OnboardingPracticePanel" x:FieldModifier="internal" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                    <Border Style="{StaticResource BrandSettingsCardStyle}" Padding="14">
                        <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                            <Border Style="{StaticResource BrandAccentChipStyle}" HorizontalAlignment="Left">
                                <TextBlock x:Name="OnboardingPracticeKeyChipText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Key: Ctrl+Win" />
                            </Border>
                            <TextBlock x:Name="OnboardingPracticePromptText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Try saying: Meet me at 3 PM to review the quarterly plan." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBox x:Name="OnboardingPracticeBox" x:FieldModifier="internal" AcceptsReturn="True" AutomationProperties.Name="Your first dictation" MinHeight="{StaticResource BrandOnboardingPracticeBoxHeight}" PlaceholderText="Click here, hold your key, speak naturally, then release..." TextChanged="OnboardingPracticeBox_TextChanged" TextWrapping="Wrap" />
                    <TextBlock x:Name="OnboardingPracticeFootnote" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Your recording indicator appears while you hold the key." TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="OnboardingPracticeMicrophoneButton" x:FieldModifier="internal" AutomationProperties.HelpText="Opens the Windows microphone privacy page, where the switch for desktop apps is turned on." Click="OpenMicrophonePrivacyButton_Click" Content="Turn on the microphone" HorizontalAlignment="Center" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                </StackPanel>

                <!-- 13. CLOSING WALKTHROUGH -->
                <StackPanel x:Name="OnboardingClosingPanel" x:FieldModifier="internal" MaxWidth="{StaticResource BrandOnboardingHeroMaxWidth}" HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingL}" Visibility="Collapsed">
                    <Border x:Name="OnboardingClosingCard" x:FieldModifier="internal" Style="{StaticResource BrandHeaderCardStyle}" MinHeight="{StaticResource BrandOnboardingFilmCardMinHeight}" PointerEntered="OnboardingClosingCard_PointerEntered" PointerExited="OnboardingClosingCard_PointerExited">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Top">
                                    <FontIcon x:Name="OnboardingClosingBeatIcon" x:FieldModifier="internal" FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                    <TextBlock x:Name="OnboardingClosingBeatStepText" x:FieldModifier="internal" Style="{StaticResource BrandSubsectionEyebrowStyle}" Text="1 OF 7" />
                                    <TextBlock x:Name="OnboardingClosingBeatTitle" x:FieldModifier="internal" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource BrandPageTitleStyle}" Text="Congratulations! You are all set." TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="OnboardingClosingWatchAgainButton" x:FieldModifier="internal" Grid.Column="2" Click="OnboardingClosingWatchAgainButton_Click" Content="Watch again" Style="{StaticResource BrandQuietButtonStyle}" VerticalAlignment="Top" />
                            </Grid>
                            <TextBlock x:Name="OnboardingClosingBeatSubtitle" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Here is a quick refresher." TextWrapping="Wrap" />
                            <Border Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{ThemeResource BrandSectionRadius}" Padding="14">
                                <TextBlock x:Name="OnboardingClosingSummaryText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Everything is ready on this PC." TextWrapping="Wrap" />
                            </Border>
                            <StackPanel x:Name="OnboardingClosingDotsPanel" x:FieldModifier="internal" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource BrandSettingsCardStyle}" Padding="16">
                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Language" />
                                <TextBlock x:Name="OnboardingClosingLanguageSummaryText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Detect automatically" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Speech model" />
                                <TextBlock x:Name="OnboardingClosingSpeechSummaryText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Parakeet" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="AI polish" />
                                <TextBlock x:Name="OnboardingClosingPolishSummaryText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="EG-1 Mini" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Dictation key" />
                                <TextBlock x:Name="OnboardingClosingKeySummaryText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Ctrl+Win" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <Border x:Name="OnboardingFooter" x:FieldModifier="internal" Grid.Row="2" Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="0,1,0,0">
            <Grid MaxWidth="{StaticResource BrandOnboardingContentMaxWidth}" Padding="{StaticResource BrandOnboardingFooterPadding}">
            <StackPanel Spacing="{StaticResource BrandSpacingS}">
                <Button x:Name="FinishOnboardingButton" x:FieldModifier="internal" AccessKey="G" AutomationProperties.HelpText="Moves to the next setup step. Press Control plus Enter from anywhere on this screen." Click="FinishOnboardingButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource BrandPrimaryButtonStyle}" Content="Set up dictation">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
                <HyperlinkButton x:Name="OnboardingSkipButton" x:FieldModifier="internal" Click="OnboardingSkipButton_Click" Content="Skip this step" HorizontalAlignment="Center" Style="{StaticResource BrandHyperlinkButtonStyle}" Visibility="Collapsed" />
                <TextBlock x:Name="OnboardingFooterText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="You can change every choice later in Settings. No account is required." TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
