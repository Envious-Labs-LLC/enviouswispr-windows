<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EnviousWispr.App.Pages.OnboardingPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:EnviousWispr.Core.Settings"
    xmlns:local="using:EnviousWispr.App"
    xmlns:controls="using:EnviousWispr.App.Controls">
    <Grid
        x:Name="OnboardingView"
        x:FieldModifier="internal"
        Background="{ThemeResource BrandOnboardingCanvasBgBrush}"
        Visibility="Collapsed"
        SizeChanged="OnboardingView_SizeChanged"
        PreviewKeyDown="OnboardingView_PreviewKeyDown"
        PreviewKeyUp="OnboardingView_PreviewKeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            WINDOW CHROME: Back navigation (left), independently centered 6-segment milestone strip
            (hidden on Welcome & Closing so Back/Download Pill never shifts it sideways), and background
            download pill (right, hidden on Welcome, Downloads, and Closing).
        -->
        <Border
            x:Name="OnboardingChromeBar"
            x:FieldModifier="internal"
            Grid.Row="0"
            Padding="{StaticResource BrandOnboardingChromePadding}"
            MinHeight="{StaticResource BrandOnboardingChromeHeight}"
            Visibility="Collapsed">
            <Grid>
                <Button
                    x:Name="OnboardingBackButton"
                    x:FieldModifier="internal"
                    Click="OnboardingBackButton_Click"
                    Style="{StaticResource BrandQuietButtonStyle}"
                    AutomationProperties.Name="Go back to the previous setup step"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Back" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid
                    x:Name="OnboardingProgressGrid"
                    x:FieldModifier="internal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ColumnSpacing="{StaticResource BrandSpacingXs}"
                    Visibility="Collapsed" />

                <Button
                    x:Name="OnboardingDownloadPillButton"
                    x:FieldModifier="internal"
                    Click="OnboardingDownloadPillButton_Click"
                    Style="{StaticResource BrandQuietButtonStyle}"
                    Padding="{StaticResource BrandOnboardingDownloadPillPadding}"
                    AutomationProperties.Name="View background model downloads"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                        <Ellipse x:Name="OnboardingDownloadPillDot" x:FieldModifier="internal" Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandAccentBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="OnboardingDownloadPillText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Downloading models" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="OnboardingScroll"
            x:FieldModifier="internal"
            Grid.Row="1"
            AutomationProperties.Name="EnviousWispr setup"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid x:Name="OnboardingContent" x:FieldModifier="internal" Padding="{StaticResource BrandOnboardingContentPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100*" MaxWidth="{StaticResource BrandOnboardingStageMaxWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="OnboardingStageHost" x:FieldModifier="internal" Grid.Column="1" Spacing="{StaticResource BrandSpacingL}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="OnboardingStageTranslate" x:FieldModifier="internal" X="0" />
                    </StackPanel.RenderTransform>

                    <InfoBar x:Name="OnboardingReliabilityInfoBar" x:FieldModifier="internal" IsClosable="False" IsOpen="False" Severity="Warning" />

                    <!-- Shared Rainbow Lips hero + optional native greeting speech bubble (hidden on Closing, where the film hosts its own 72 DIP lips). -->
                    <Border
                        x:Name="OnboardingRainbowLipsContainer"
                        x:FieldModifier="internal"
                        Background="{ThemeResource BrandHitTestBrush}"
                        BorderThickness="0"
                        HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingM}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:RainbowLipsControl
                                x:Name="OnboardingRainbowLips"
                                x:FieldModifier="internal"
                                Width="{StaticResource BrandOnboardingLipsHeroSize}"
                                Height="{StaticResource BrandOnboardingLipsHeroSize}"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="OnboardingGreetingBubble"
                                x:FieldModifier="internal"
                                MaxWidth="{StaticResource BrandOnboardingGreetingBubbleMaxWidth}"
                                Padding="{StaticResource BrandOnboardingCompactCardPadding}"
                                Background="{ThemeResource BrandOnboardingSurfaceBgBrush}"
                                BorderBrush="{ThemeResource BrandDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource BrandSectionRadius}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="OnboardingGreetingBubbleText"
                                    x:FieldModifier="internal"
                                    Style="{StaticResource BrandRowLabelStyle}"
                                    Foreground="{ThemeResource BrandAccentBrush}"
                                    Text="Hello!"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Centered step header (hidden on Welcome & Closing) -->
                    <StackPanel x:Name="OnboardingStepHeader" x:FieldModifier="internal" HorizontalAlignment="Center" Spacing="{StaticResource BrandOnboardingTextSpacing}" Visibility="Collapsed">
                        <TextBlock x:Name="OnboardingStepText" x:FieldModifier="internal" Style="{StaticResource BrandSubsectionEyebrowStyle}" Text="STEP 1 OF 6" TextAlignment="Center" />
                        <TextBlock x:Name="OnboardingTitle" x:FieldModifier="internal" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource BrandOnboardingStepTitleStyle}" Text="Which language do you dictate in?" />
                        <TextBlock x:Name="OnboardingSubtitle" x:FieldModifier="internal" Style="{StaticResource BrandOnboardingSubtitleStyle}" Text="Pick automatic detection or lock a language." />
                    </StackPanel>

                    <!-- 1. WELCOME -->
                    <StackPanel x:Name="OnboardingWelcomePanel" x:FieldModifier="internal" MaxWidth="{StaticResource BrandOnboardingStageMaxWidth}" HorizontalAlignment="Stretch" Spacing="{StaticResource BrandSpacingL}">
                        <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingS}">
                            <TextBlock
                                x:Name="OnboardingWelcomeHeadline"
                                x:FieldModifier="internal"
                                AutomationProperties.HeadingLevel="Level1"
                                Style="{StaticResource BrandHeroDisplayTitleStyle}"
                                Text="Talk naturally.&#x0A;Capture perfectly."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="OnboardingWelcomeSubtitle"
                                x:FieldModifier="internal"
                                Style="{StaticResource BrandOnboardingSubtitleStyle}"
                                Text="Turn spoken thoughts into polished text in the apps you use." />
                        </StackPanel>

                        <Border Style="{StaticResource BrandOnboardingSurfaceCardStyle}" Padding="{StaticResource BrandOnboardingCompactCardPadding}">
                            <StackPanel Spacing="{StaticResource BrandSpacingM}">
                                <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource BrandOnboardingValueIconSize}" Height="{StaticResource BrandOnboardingValueIconSize}" CornerRadius="{StaticResource BrandOnboardingValueIconRadius}" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Center">
                                        <FontIcon FontSize="16" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xEA18;" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Private" />
                                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Your voice stays on this PC." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />

                                <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource BrandOnboardingValueIconSize}" Height="{StaticResource BrandOnboardingValueIconSize}" CornerRadius="{StaticResource BrandOnboardingValueIconRadius}" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Center">
                                        <FontIcon FontSize="16" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE945;" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Fast, even offline" />
                                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Runs locally on GPU or CPU. Works offline once models download." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />

                                <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource BrandOnboardingValueIconSize}" Height="{StaticResource BrandOnboardingValueIconSize}" CornerRadius="{StaticResource BrandOnboardingValueIconRadius}" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Center">
                                        <FontIcon FontSize="16" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE734;" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Polished for you" />
                                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Filler words, grammar, and formatting get fixed." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />

                                <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource BrandOnboardingValueIconSize}" Height="{StaticResource BrandOnboardingValueIconSize}" CornerRadius="{StaticResource BrandOnboardingValueIconRadius}" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Center">
                                        <FontIcon FontSize="16" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE77B;" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Free and open source" />
                                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="No account. No subscription. Anonymous stats only." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BrandOnboardingSurfaceCardStyle}" Padding="{StaticResource BrandOnboardingCompactCardPadding}">
                            <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE72E;" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                                    <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Privacy &amp; data" />
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Audio stays on this PC; dictated text stays local unless you turn on cloud polish. Anonymous usage metrics and crash reports are on by default to help us catch broken updates, and can be turned off anytime in Diagnostics." TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Uninstalling keeps your history and downloaded models. To remove them, use Delete all EnviousWispr data on the Your data page before you uninstall." TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 2. LANGUAGE -->
                    <StackPanel x:Name="OnboardingLanguagePanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                        <Border x:Name="OnboardingLanguageGreetingCard" x:FieldModifier="internal" Style="{StaticResource BrandOnboardingSurfaceCardStyle}" Padding="{StaticResource BrandOnboardingCompactCardPadding}">
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                    <TextBlock x:Name="OnboardingLanguageGreetingText" x:FieldModifier="internal" Style="{StaticResource BrandRowTitleStyle}" Text="Hello!" TextWrapping="Wrap" />
                                    <TextBlock x:Name="OnboardingLanguageSelectedTitleText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Detect automatically" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border x:Name="OnboardingLanguageEngineBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandAccentChipStyle}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                        <Ellipse x:Name="OnboardingLanguageEngineDot" x:FieldModifier="internal" Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandAccentBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="OnboardingLanguageEngineBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Parakeet · 25 languages" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Button x:Name="OnboardingSuggestedLanguageButton" x:FieldModifier="internal" Click="OnboardingSuggestedLanguageButton_Click" Style="{StaticResource BrandQuietButtonStyle}" HorizontalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon FontSize="14" Glyph="&#xE774;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="OnboardingSuggestedLanguageText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Foreground="{ThemeResource BrandAccentBrush}" Text="Suggested from Windows: English" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <RadioButton x:Name="OnboardingDetectAutoCard" x:FieldModifier="internal" GroupName="OnboardingLanguageAuto" Checked="OnboardingDetectAutoCard_Checked" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Padding="14,10,14,10" Style="{StaticResource BrandSelectableCardStyle}" AutomationProperties.Name="Detect automatically">
                            <StackPanel Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Detect automatically" />
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Recognizes spoken languages on the fly. You can lock a specific language anytime." TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>

                        <Border x:Name="OnboardingLanguageAdviceCard" x:FieldModifier="internal" Background="{ThemeResource BrandAccentLightBrush}" BorderBrush="{ThemeResource BrandAccentBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}" Padding="{StaticResource BrandOnboardingCompactCardPadding}" Visibility="Collapsed">
                            <TextBlock x:Name="OnboardingLanguageAdviceText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Whisper is recommended for this language for best accuracy." TextWrapping="Wrap" />
                        </Border>

                        <Border Style="{StaticResource BrandOnboardingSurfaceCardStyle}" Padding="{StaticResource BrandOnboardingCompactCardPadding}">
                            <StackPanel Spacing="{StaticResource BrandSpacingS}">
                                <TextBox x:Name="OnboardingLanguageSearchBox" x:FieldModifier="internal" PlaceholderText="Search 99+ languages" AutomationProperties.Name="Search 99+ languages" TextChanged="OnboardingLanguageSearchBox_TextChanged" KeyDown="OnboardingLanguageSearchBox_KeyDown" />
                                <Grid Height="{StaticResource BrandOnboardingLanguageListHeight}">
                                    <ListView x:Name="OnboardingLanguageListView" x:FieldModifier="internal" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnboardingLanguageListView_ItemClick" AutomationProperties.Name="Available dictation languages">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="MinHeight" Value="48" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="6,6" ColumnSpacing="{StaticResource BrandSpacingS}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                                        <TextBlock Style="{StaticResource BrandBodyStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource BrandNeutralChipStyle}" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource BrandNeutralChipTextStyle}" Text="{Binding EngineLabel}" />
                                                    </Border>
                                                    <FontIcon Grid.Column="2" FontSize="16" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE73E;" VerticalAlignment="Center" Visibility="{Binding SelectedVisibility}" AutomationProperties.AccessibilityView="Raw" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="OnboardingLanguageEmptyText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="No matching language found. Clear the filter or pick Detect automatically." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. SPEECH PICK -->
                    <StackPanel x:Name="OnboardingSpeechPickPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                        <Border x:Name="OnboardingSpeechPickCard" x:FieldModifier="internal" Style="{StaticResource BrandOnboardingSurfaceCardStyle}" Padding="{StaticResource BrandOnboardingHeroCardPadding}">
                            <StackPanel Spacing="{StaticResource BrandSpacingM}">
                                <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                    <TextBlock Style="{StaticResource BrandSubsectionEyebrowStyle}" Text="YOUR WORDS, TRANSCRIBED IN ABOUT" TextAlignment="Center" />
                                    <TextBlock x:Name="OnboardingSpeechHeroTimeText" x:FieldModifier="internal" Style="{StaticResource BrandOnboardingMetricHeroStyle}" Text="&lt; 0.5 sec" />
                                    <TextBlock x:Name="OnboardingSpeechHeroSubtext" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="For 30 seconds of speech on this PC." TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />

                                <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingXs}">
                                    <TextBlock x:Name="OnboardingSpeechPickTitle" x:FieldModifier="internal" Style="{StaticResource BrandRowTitleStyle}" Text="Meet Parakeet" TextAlignment="Center" />
                                    <TextBlock x:Name="OnboardingSpeechPickDescription" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Fast local speech recognition tuned for 25 European languages." TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnSpacing="{StaticResource BrandSpacingS}" RowSpacing="{StaticResource BrandSpacingS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource BrandCardBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}" Padding="12,10,12,10">
                                        <StackPanel Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                                <FontIcon FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE945;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="On this PC" />
                                            </StackPanel>
                                            <TextBlock x:Name="OnboardingSpeechHardwareBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Runs locally on your PC" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{ThemeResource BrandCardBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}" Padding="12,10,12,10">
                                        <StackPanel Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                                <FontIcon FontSize="14" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE72E;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="100% offline" />
                                            </StackPanel>
                                            <TextBlock x:Name="OnboardingSpeechPickLanguageNoteText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Configured for Automatic detection." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <Border x:Name="OnboardingSpeechInstallBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}">
                                        <TextBlock x:Name="OnboardingSpeechInstallBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="638 MB download" />
                                    </Border>
                                    <TextBlock x:Name="OnboardingSpeechPickSizeText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" VerticalAlignment="Center" Text="One-time download: 638 MB." TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock x:Name="OnboardingSpeechPickSpeedText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" TextAlignment="Center" Text="Fast local transcription on this PC." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <HyperlinkButton x:Name="OnboardingOpenSpeechCompareButton" x:FieldModifier="internal" Click="OnboardingOpenSpeechCompareButton_Click" Content="Compare speech models" HorizontalAlignment="Center" Style="{StaticResource BrandHyperlinkButtonStyle}" />
                    </StackPanel>

                    <!-- 4. SPEECH COMPARE -->
                    <StackPanel x:Name="OnboardingSpeechComparePanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                        <Grid x:Name="OnboardingSpeechCompareGrid" x:FieldModifier="internal" ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingM}" SizeChanged="OnboardingSpeechCompareGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="OnboardingSpeechCompareCol0" x:FieldModifier="internal" Width="*" />
                                <ColumnDefinition x:Name="OnboardingSpeechCompareCol1" x:FieldModifier="internal" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="OnboardingParakeetCompareCard" x:FieldModifier="internal" Grid.Row="0" Grid.Column="0" Tag="Parakeet" GroupName="OnboardingSpeechCompare" Checked="OnboardingSpeechCompareCard_Checked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="16" Style="{StaticResource BrandSelectableCardStyle}" AutomationProperties.Name="Parakeet speech model">
                                <StackPanel Margin="0,0,24,0" Spacing="{StaticResource BrandSpacingS}">
                                    <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                        <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Parakeet" />
                                        <Border x:Name="OnboardingParakeetCompareRecommendedBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" HorizontalAlignment="Left" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="OnboardingParakeetCompareTimeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentTitleStyle}" Text="&lt; 0.5 sec" />
                                    <Border x:Name="OnboardingParakeetCompareStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="OnboardingParakeetCompareStatusBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="25 European languages" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock x:Name="OnboardingParakeetCompareSizeText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Download: 638 MB" TextWrapping="Wrap" />
                                    <TextBlock x:Name="OnboardingParakeetCompareSpeedText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Fast on CPU and GPU for everyday dictation." TextWrapping="Wrap" />
                                    <TextBlock x:Name="OnboardingParakeetCompareDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Fastest turnaround on this PC." TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="OnboardingWhisperCompareCard" x:FieldModifier="internal" Grid.Row="0" Grid.Column="1" Tag="Whisper" GroupName="OnboardingSpeechCompare" Checked="OnboardingSpeechCompareCard_Checked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="16" Style="{StaticResource BrandSelectableCardStyle}" AutomationProperties.Name="Whisper speech model">
                                <StackPanel Margin="0,0,24,0" Spacing="{StaticResource BrandSpacingS}">
                                    <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                        <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Whisper" />
                                        <Border x:Name="OnboardingWhisperCompareRecommendedBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" HorizontalAlignment="Left" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="OnboardingWhisperCompareTimeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentTitleStyle}" Text="~0.8 sec" />
                                    <Border x:Name="OnboardingWhisperCompareStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="OnboardingWhisperCompareStatusBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="99+ languages" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock x:Name="OnboardingWhisperCompareSizeText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Download: 548 MB" TextWrapping="Wrap" />
