                                        </Border>
                                        <Border x:Name="OnboardingMicNeedsAttentionBadge" x:FieldModifier="internal" Style="{StaticResource BrandWarningChipStyle}" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                                <Ellipse Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandWarningBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock Style="{StaticResource BrandWarningChipTextStyle}" Text="Needs attention" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="OnboardingMicStatusText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" Text="Checking Windows microphone permissions..." TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <Button x:Name="OnboardingOpenMicSettingsButton" x:FieldModifier="internal" Click="OpenMicrophonePrivacyButton_Click" Content="Open Microphone Settings" Style="{StaticResource BrandQuietButtonStyle}" />
                                    <Button x:Name="OnboardingRefreshMicButton" x:FieldModifier="internal" Click="OnboardingRefreshMicButton_Click" Content="Refresh check" Style="{StaticResource BrandQuietButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Microphone access is the only permission Windows needs." TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 10. KEY -->
                    <StackPanel x:Name="OnboardingKeyPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                        <Border Style="{StaticResource BrandOnboardingSurfaceCardStyle}">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource BrandSpacingM}">
                                <Button
                                    x:Name="OnboardingKeycapButton"
                                    x:FieldModifier="internal"
                                    Click="OnboardingKeycapButton_Click"
                                    MinWidth="{StaticResource BrandOnboardingKeycapMinWidth}"
                                    MinHeight="{StaticResource BrandOnboardingKeycapMinHeight}"
                                    Padding="{StaticResource BrandOnboardingKeycapPadding}"
                                    CornerRadius="{StaticResource BrandOnboardingKeycapRadius}"
                                    Background="{ThemeResource BrandCardBgBrush}"
                                    BorderBrush="{ThemeResource BrandOnboardingKeycapBevelBrush}"
                                    BorderThickness="1,1,1,4"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Current dictation shortcut. Click to set a custom keybind.">
                                    <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                        <TextBlock Style="{StaticResource BrandSubsectionEyebrowStyle}" Text="CHANGE" TextAlignment="Center" />
                                        <TextBlock x:Name="OnboardingKeycapText" x:FieldModifier="internal" FontSize="{StaticResource BrandOnboardingKeycapFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="Ctrl+Win" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <controls:OnboardingKeyboardVisualControl x:Name="OnboardingKeyboardVisual" x:FieldModifier="internal" />

                                <TextBlock x:Name="OnboardingKeycapHintText" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Click the keycap to capture a custom key, or pick a preset below." TextAlignment="Center" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" HorizontalAlignment="Center">
                                    <Button x:Name="OnboardingPresetCtrlWinButton" x:FieldModifier="internal" Click="OnboardingPresetHotkeyButton_Click" Tag="Ctrl+Win" Content="Ctrl+Win" Style="{StaticResource BrandQuietActiveButtonStyle}" />
                                    <Button x:Name="OnboardingPresetRightCtrlButton" x:FieldModifier="internal" Click="OnboardingPresetHotkeyButton_Click" Tag="RightCtrl" Content="RightCtrl" Style="{StaticResource BrandQuietButtonStyle}" />
                                    <Button x:Name="OnboardingPresetF8Button" x:FieldModifier="internal" Click="OnboardingPresetHotkeyButton_Click" Tag="F8" Content="F8" Style="{StaticResource BrandQuietButtonStyle}" />
                                    <Button x:Name="OnboardingPresetAltSpaceButton" x:FieldModifier="internal" Click="OnboardingPresetHotkeyButton_Click" Tag="Alt+Space" Content="Alt+Space" Style="{StaticResource BrandQuietButtonStyle}" />
                                </StackPanel>

                                <TextBlock x:Name="OnboardingKeyStatusText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Polite" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BrandOnboardingSurfaceCardStyle}" Padding="{StaticResource BrandOnboardingCompactCardPadding}">
                            <StackPanel Spacing="{StaticResource BrandSpacingS}">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Try your key right now" />
                                <Grid ColumnSpacing="{StaticResource BrandSpacingS}" RowSpacing="{StaticResource BrandSpacingS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="OnboardingRehearsalHoldCard" x:FieldModifier="internal" Grid.Column="0" Background="{ThemeResource BrandCardBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}" Padding="12">
                                        <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Hold to dictate" />
                                            <Border x:Name="OnboardingRehearsalHoldBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="OnboardingRehearsalHoldBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Try holding" />
                                            </Border>
                                            <TextBlock x:Name="OnboardingRehearsalHoldDescText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Hold while you speak, then let go." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="OnboardingRehearsalDoubleTapCard" x:FieldModifier="internal" Grid.Column="1" Background="{ThemeResource BrandCardBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}" Padding="12">
                                        <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Double-press" />
                                            <Border x:Name="OnboardingRehearsalDoubleTapBadge" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipStyle}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="OnboardingRehearsalDoubleTapBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Tap twice" />
                                            </Border>
                                            <TextBlock x:Name="OnboardingRehearsalDoubleTapDescText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Keep recording hands-free." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="OnboardingKeyFooterNoteText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Your chosen key applies immediately for practice and everyday dictation. Change it any time on the Keybinds page." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 11. GETTING READY (GATE) -->
                    <StackPanel x:Name="OnboardingGettingReadyPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                        <Border Style="{StaticResource BrandOnboardingSurfaceCardStyle}">
                            <StackPanel Spacing="{StaticResource BrandSpacingM}">
                                <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BrandRowLabelStyle}" Text="Speech model" />
                                        <Border x:Name="OnboardingGateSpeechBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandNeutralChipStyle}"><TextBlock x:Name="OnboardingGateSpeechBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Checking" /></Border>
                                    </Grid>
                                    <TextBlock x:Name="OnboardingGateSpeechDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Preparing your speech engine..." TextWrapping="Wrap" />
                                    <ProgressBar x:Name="OnboardingGateSpeechProgress" x:FieldModifier="internal" Maximum="100" Minimum="0" Visibility="Collapsed" />
                                </StackPanel>
                                <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />
                                <StackPanel x:Name="OnboardingGatePolishRow" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingXs}">
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BrandRowLabelStyle}" Text="AI polish" />
                                        <Border x:Name="OnboardingGatePolishBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandNeutralChipStyle}"><TextBlock x:Name="OnboardingGatePolishBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="Checking" /></Border>
                                    </Grid>
                                    <TextBlock x:Name="OnboardingGatePolishDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Preparing local polish..." TextWrapping="Wrap" />
                                    <ProgressBar x:Name="OnboardingGatePolishProgress" x:FieldModifier="internal" Maximum="100" Minimum="0" Visibility="Collapsed" />
                                </StackPanel>
                                <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />
                                <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                    <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BrandRowLabelStyle}" Text="Microphone" />
                                        <Border x:Name="OnboardingGateMicBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandSuccessChipStyle}"><TextBlock x:Name="OnboardingGateMicBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandSuccessChipTextStyle}" Text="Ready" /></Border>
                                    </Grid>
                                    <TextBlock x:Name="OnboardingGateMicDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Microphone access verified." TextWrapping="Wrap" />
                                    <Button x:Name="OnboardingGateMicSettingsButton" x:FieldModifier="internal" Click="OpenMicrophonePrivacyButton_Click" Content="Open Microphone Settings" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 60s slow-polish skip-ahead card (honest deferred background polish copy) -->
                        <Border x:Name="OnboardingGateSlowPolishCard" x:FieldModifier="internal" Background="{ThemeResource BrandWarningSoftBrush}" BorderBrush="{ThemeResource BrandWarningBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}" Padding="{StaticResource BrandOnboardingCompactCardPadding}" Visibility="Collapsed">
                            <StackPanel Spacing="{StaticResource BrandSpacingS}">
                                <TextBlock x:Name="OnboardingGateSlowPolishTitleText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="This download is taking longer than expected." TextWrapping="Wrap" />
                                <TextBlock x:Name="OnboardingGateSlowPolishBodyText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="You can skip ahead and start dictating now. AI polish keeps downloading while EnviousWispr is open and turns on by itself when it is done." TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <Button x:Name="OnboardingGateSlowSkipButton" x:FieldModifier="internal" Click="OnboardingGateSlowSkipButton_Click" Content="Skip ahead" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                    <Button x:Name="OnboardingGateSlowWaitButton" x:FieldModifier="internal" Click="OnboardingGateSlowWaitButton_Click" Content="Keep waiting" Style="{StaticResource BrandQuietButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingS}">
                            <Button x:Name="OnboardingGateRetryButton" x:FieldModifier="internal" Click="OnboardingDownloadRetryButton_Click" Content="Retry downloads" Style="{StaticResource BrandPrimaryButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="OnboardingGateSkipPolishButton" x:FieldModifier="internal" Click="OnboardingGateSkipPolishButton_Click" Content="Continue without AI polish" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 12. PRACTICE -->
                    <StackPanel x:Name="OnboardingPracticePanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                        <Border Style="{StaticResource BrandOnboardingSurfaceCardStyle}" Padding="{StaticResource BrandOnboardingCompactCardPadding}">
                            <StackPanel Spacing="{StaticResource BrandSpacingS}">
                                <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BrandSubsectionEyebrowStyle}" VerticalAlignment="Center" Text="TRY SAYING" />
                                    <Border Grid.Column="1" Style="{StaticResource BrandAccentChipStyle}">
                                        <TextBlock x:Name="OnboardingPracticeKeyChipText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Hold: Ctrl+Win" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="OnboardingPracticePromptText" x:FieldModifier="internal" Style="{StaticResource BrandRowTitleStyle}" Text="Um, I think we should, uh, meet tomorrow morning." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="OnboardingPracticeBoxFrame" x:FieldModifier="internal" Background="{ThemeResource BrandCardBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="2" CornerRadius="{StaticResource BrandSectionRadius}" Padding="2">
                            <TextBox
                                x:Name="OnboardingPracticeBox"
                                x:FieldModifier="internal"
                                AcceptsReturn="True"
                                AutomationProperties.Name="Your first dictation"
                                BorderThickness="0"
                                MinHeight="{StaticResource BrandOnboardingPracticeBoxHeight}"
                                PlaceholderText="Click here, hold your key, speak naturally, then release..."
                                TextChanged="OnboardingPracticeBox_TextChanged"
                                TextWrapping="Wrap" />
                        </Border>

                        <Border x:Name="OnboardingPracticeDeferredPolishCard" x:FieldModifier="internal" Background="{ThemeResource BrandAccentLightBrush}" BorderBrush="{ThemeResource BrandAccentBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}" Padding="{StaticResource BrandOnboardingCompactCardPadding}" Visibility="Collapsed">
                            <StackPanel Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Basic cleanup for now" />
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="AI polish keeps downloading while EnviousWispr is open and turns on by itself when it is done." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="OnboardingPracticeMicRow" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingXs}" Visibility="Collapsed">
                            <TextBlock x:Name="OnboardingPracticeMicLabel" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Microphone" />
                            <ComboBox
                                x:Name="OnboardingPracticeMicComboBox"
                                x:FieldModifier="internal"
                                AutomationProperties.LabeledBy="{x:Bind OnboardingPracticeMicLabel, Mode=OneTime}"
                                DisplayMemberPath="DisplayName"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnboardingPracticeMicComboBox_SelectionChanged" />
                        </StackPanel>

                        <TextBlock x:Name="OnboardingPracticeFootnote" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Your recording indicator appears while you hold the key." TextAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="OnboardingPracticeMicrophoneButton" x:FieldModifier="internal" AutomationProperties.HelpText="Opens the Windows microphone privacy page, where the switch for desktop apps is turned on." Click="OpenMicrophonePrivacyButton_Click" Content="Turn on the microphone" HorizontalAlignment="Center" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- 13. CLOSING FILM -->
                    <StackPanel x:Name="OnboardingClosingPanel" x:FieldModifier="internal" MaxWidth="{StaticResource BrandOnboardingStageMaxWidth}" HorizontalAlignment="Stretch" Spacing="{StaticResource BrandSpacingM}" Visibility="Collapsed">
                        <controls:OnboardingClosingFilmControl
                            x:Name="OnboardingClosingFilm"
                            x:FieldModifier="internal"
                            ShowBuiltInControls="False" />

                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                x:Name="OnboardingClosingDotsPanel"
                                x:FieldModifier="internal"
                                Grid.Column="0"
                                ColumnSpacing="{StaticResource BrandSpacingXs}"
                                VerticalAlignment="Center" />

                            <Button
                                x:Name="OnboardingClosingPausePlayButton"
                                x:FieldModifier="internal"
                                Grid.Column="1"
                                AutomationProperties.Name="Pause closing film"
                                Click="OnboardingClosingPausePlayButton_Click"
                                Content="Pause"
                                Padding="12,5,12,5"
                                Style="{StaticResource BrandQuietButtonStyle}" />

                            <Button
                                x:Name="OnboardingClosingWatchAgainButton"
                                x:FieldModifier="internal"
                                Grid.Column="2"
                                AutomationProperties.Name="Watch closing film again"
                                Click="OnboardingClosingWatchAgainButton_Click"
                                Content="Watch again"
                                Padding="12,5,12,5"
                                Style="{StaticResource BrandQuietButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="OnboardingFooter"
            x:FieldModifier="internal"
            Grid.Row="2"
            Background="{ThemeResource BrandOnboardingCanvasBgBrush}"
            BorderBrush="{ThemeResource BrandDividerBrush}"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="{StaticResource BrandOnboardingStageMaxWidth}" Padding="{StaticResource BrandOnboardingFooterPadding}">
                <StackPanel Spacing="{StaticResource BrandSpacingS}" HorizontalAlignment="Stretch">
                    <Button
                        x:Name="FinishOnboardingButton"
                        x:FieldModifier="internal"
                        AccessKey="G"
                        AutomationProperties.HelpText="Moves to the next setup step. Press Control plus Enter from anywhere on this screen."
                        Click="FinishOnboardingButton_Click"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BrandOnboardingPrimaryButtonStyle}"
                        Content="Set up dictation">
                        <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control" /></Button.KeyboardAccelerators>
                    </Button>
                    <HyperlinkButton
                        x:Name="OnboardingSkipButton"
                        x:FieldModifier="internal"
                        Click="OnboardingSkipButton_Click"
                        Content="Skip this step"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BrandHyperlinkButtonStyle}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="OnboardingFooterText"
                        x:FieldModifier="internal"
                        Style="{StaticResource BrandHelperStyle}"
                        Text="Six short steps to your first dictation."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
