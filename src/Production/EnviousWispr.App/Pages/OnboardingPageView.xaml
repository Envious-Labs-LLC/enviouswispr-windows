<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EnviousWispr.App.Pages.OnboardingPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:EnviousWispr.Core.Settings"
    xmlns:local="using:EnviousWispr.App"
    xmlns:controls="using:EnviousWispr.App.Controls">
    <Grid x:Name="OnboardingView" x:FieldModifier="internal" Background="{ThemeResource BrandPageBgBrush}" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
            FIVE SCREENS IN ONE VIEW, IN THE macOS ORDER: welcome, setting up (the speech model, then
            the one Windows permission), ready, warming up, and a practice box. One header card
            carries every screen's title so the heading a screen reader lands on is always in the
            same place; each screen's content is a panel below it, and exactly one is visible. What
            moves the flow on is OnboardingFlow in Presentation, where the gates and every Windows
            difference are decided and tested.
        -->
        <ScrollViewer x:Name="OnboardingScroll" x:FieldModifier="internal" AutomationProperties.Name="EnviousWispr setup" HorizontalScrollMode="Disabled">
        <!--
            ONE MEASURE FOR EVERY SCREEN, CENTRED. A capped element centred by its own alignment is
            only as wide as its content, so the column changed width from screen to screen - the
            welcome's long lines filled it and the warm-up's short ones did not - and the frame
            appeared to jump as the flow moved on. Capping a star column between two star gutters
            keeps the same width on every screen and still centres it, the way the settings pages
            cap theirs.
        -->
        <Grid x:Name="OnboardingContent" x:FieldModifier="internal" Padding="{StaticResource BrandOnboardingContentPadding}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100*" MaxWidth="{StaticResource BrandOnboardingContentColumnMaxWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSectionSpacing}">
                <Border Style="{StaticResource BrandHeaderCardStyle}">
                    <Grid ColumnSpacing="{StaticResource BrandOnboardingWideSpacing}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Width="{StaticResource BrandOnboardingMarkSize}" Height="{StaticResource BrandOnboardingMarkSize}" AutomationProperties.AccessibilityView="Raw" Source="Assets/Brand/EnviousWisprMark.svg" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                            <TextBlock x:Name="OnboardingStepText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Step 1 of 5" />
                            <TextBlock x:Name="OnboardingTitle" x:FieldModifier="internal" x:Uid="OnboardingTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource BrandPageTitleStyle}" Text="Your voice, instantly captured." TextWrapping="Wrap" />
                            <TextBlock x:Name="OnboardingSubtitle" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="The privacy-first dictation app built for Windows." TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="OnboardingReliabilityInfoBar" x:FieldModifier="internal" IsClosable="False" IsOpen="False" Severity="Warning" />

                <!-- 1. WELCOME. macOS's four feature cards, in its order and words where they are true here. -->
                <StackPanel x:Name="OnboardingWelcomePanel" x:FieldModifier="internal" Spacing="{StaticResource BrandOnboardingCardSpacing}">
                    <Border Style="{StaticResource BrandHeaderCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE72E;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="On-Device" />
                                <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Your voice never leaves your PC." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BrandHeaderCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE709;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Offline-Ready" />
                                <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Works without internet." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BrandHeaderCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE945;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Native Speed" />
                                <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Built for Windows, on your graphics card or processor." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource BrandHeaderCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}">
                                <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE77B;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Free &amp; Private" />
                                <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Audio stays on this PC; dictated text stays local unless you turn on cloud polish. Anonymous usage metrics and crash reports are on by default to help us catch broken updates, and can be turned off anytime in Diagnostics." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- SAID AT THE FIRST RUN BECAUSE UNINSTALLING CANNOT SAY IT. The Store package has no uninstall hook and the data folder survives it (#42), so this is the one moment the app is sure to be heard before it matters. -->
                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Uninstalling keeps your history and downloaded models. To remove them, use Delete all EnviousWispr data on the Backup page before you uninstall." TextWrapping="Wrap" />
                </StackPanel>

                <!-- 2a. SETTING UP: the speech model, which is the gate, and the recording key, which is reported. -->
                <StackPanel x:Name="OnboardingChecklistPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                    <Border Padding="{StaticResource BrandOnboardingCardPadding}" Style="{StaticResource BrandSectionCardStyle}">
                        <StackPanel Spacing="{StaticResource BrandSectionSpacing}">
                            <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid Width="{StaticResource BrandOnboardingStatusSize}" Height="{StaticResource BrandOnboardingStatusSize}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                                    <TextBlock x:Name="OnboardingModelPendingMark" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource BrandRowLabelStyle}" Text="1" VerticalAlignment="Center" />
                                    <ProgressRing x:Name="OnboardingModelWorkingMark" x:FieldModifier="internal" Foreground="{ThemeResource BrandAccentBrush}" IsActive="False" Visibility="Collapsed" />
                                    <FontIcon x:Name="OnboardingModelDoneMark" x:FieldModifier="internal" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" />
                                    <FontIcon x:Name="OnboardingModelErrorMark" x:FieldModifier="internal" Foreground="{ThemeResource BrandErrorBrush}" Glyph="&#xE711;" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                    <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Setting up speech model" />
                                    <TextBlock x:Name="OnboardingModelText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="One-time setup" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="OnboardingModelProgress" x:FieldModifier="internal" AutomationProperties.Name="Speech model download" Background="{ThemeResource BrandDividerBrush}" Foreground="{ThemeResource BrandAccentSolidBrush}" Maximum="100" Minimum="0" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid Width="{StaticResource BrandOnboardingStatusSize}" Height="{StaticResource BrandOnboardingStatusSize}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                                    <TextBlock x:Name="OnboardingKeyPendingMark" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource BrandRowLabelStyle}" Text="2" VerticalAlignment="Center" />
                                    <FontIcon x:Name="OnboardingKeyDoneMark" x:FieldModifier="internal" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" />
                                    <FontIcon x:Name="OnboardingKeyErrorMark" x:FieldModifier="internal" Foreground="{ThemeResource BrandErrorBrush}" Glyph="&#xE711;" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                    <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Setting your keybind" />
                                    <TextBlock x:Name="OnboardingHotkeyText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Getting your keybind ready…" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="OnboardingSetupNote" x:FieldModifier="internal" AutomationProperties.LiveSetting="Assertive" Style="{StaticResource BrandBodyStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingM}">
                        <Button x:Name="OnboardingRetryButton" x:FieldModifier="internal" Click="OnboardingRetryButton_Click" Content="Retry" Style="{StaticResource BrandPrimaryButtonStyle}" Visibility="Collapsed" />
                        <Button x:Name="OnboardingCancelSetupButton" x:FieldModifier="internal" AutomationProperties.HelpText="Pauses the speech model download. It resumes from where it stopped when you start it again." Click="OnboardingCancelSetupButton_Click" Content="Cancel" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <!-- 2b. THE ONE PERMISSION. macOS asks for two; Windows has only the microphone switch. -->
                <StackPanel x:Name="OnboardingPermissionPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                    <Border Padding="{StaticResource BrandOnboardingCardPadding}" Style="{StaticResource BrandSectionCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandOnboardingCardSpacing}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="{StaticResource BrandOnboardingIconTileSize}" Height="{StaticResource BrandOnboardingIconTileSize}" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Top">
                                <FontIcon FontSize="{StaticResource BrandOnboardingIconGlyphSize}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE720;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandOnboardingTextSpacing}">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Microphone" />
                                <TextBlock Style="{StaticResource BrandBodyStyle}" Text="To hear your voice for transcription." TextWrapping="Wrap" />
                                <TextBlock x:Name="OnboardingMicrophoneText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" Text="Checking Windows audio devices…" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border x:Name="OnboardingMicrophoneAllowedBadge" x:FieldModifier="internal" Style="{StaticResource BrandSuccessChipStyle}" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}"><Ellipse Width="{StaticResource BrandStatusDotSize}" Height="{StaticResource BrandStatusDotSize}" Fill="{ThemeResource BrandSuccessBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" /><TextBlock Style="{StaticResource BrandStatusChipTextStyle}" Foreground="{ThemeResource BrandSuccessBrush}" Text="Allowed" /></StackPanel></Border>

                                <Button x:Name="OnboardingMicrophonePrivacyButton" x:FieldModifier="internal" AutomationProperties.HelpText="Opens the Windows microphone privacy page, where the switch for desktop apps is turned on." Click="OpenMicrophonePrivacyButton_Click" Content="Turn on" Style="{StaticResource BrandPrimaryButtonStyle}" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Windows lets EnviousWispr paste into other apps without a separate permission, so this is the only one." TextWrapping="Wrap" />
                </StackPanel>

                <!-- 3. READY. The key the app is listening for, shown the way macOS shows its keycap. -->
                <StackPanel x:Name="OnboardingReadyPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                    <Border Padding="{StaticResource BrandOnboardingCardPadding}" Style="{StaticResource BrandSectionCardStyle}">
                        <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingM}">
                            <Border x:Name="OnboardingKeycap" x:FieldModifier="internal" HorizontalAlignment="Center" Padding="{StaticResource BrandOnboardingKeycapPadding}" Background="{ThemeResource BrandAccentLightBrush}" BorderBrush="{ThemeResource BrandAccentBrush}" BorderThickness="1" CornerRadius="{StaticResource BrandSectionRadius}">
                                <TextBlock x:Name="OnboardingKeycapText" x:FieldModifier="internal" Foreground="{ThemeResource BrandAccentBrush}" HorizontalAlignment="Center" Style="{StaticResource BrandPageTitleStyle}" Text="Ctrl+Win" />
                            </Border>
                            <TextBlock x:Name="OnboardingKeyUsageText" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource BrandBodyStyle}" Text="Hold to dictate. Release to transcribe." TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="OnboardingHandsFreeText" x:FieldModifier="internal" HorizontalAlignment="Center" Foreground="{ThemeResource BrandAccentBrush}" Style="{StaticResource BrandBodyStyle}" Text="Double-press to go hands-free." TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Change it any time on the Keybinds page. A new key starts working the next time EnviousWispr opens." TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingXs}">
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource BrandRowLabelStyle}" Text="POWER USER?" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Change your AI model, keybind, and more in Settings." TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- 4. WARMING UP. Opens only on an engine that says it is ready. -->
                <StackPanel x:Name="OnboardingWarmingPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                    <StackPanel x:Name="OnboardingWarmingActivity" x:FieldModifier="internal" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                        <ProgressRing x:Name="OnboardingWarmingRing" x:FieldModifier="internal" Foreground="{ThemeResource BrandAccentBrush}" IsActive="False" Width="{StaticResource BrandOnboardingStatusSize}" Height="{StaticResource BrandOnboardingStatusSize}" />
                        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Loading the speech model" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="OnboardingWarmingFailure" x:FieldModifier="internal" Padding="{StaticResource BrandOnboardingCardPadding}" Background="{ThemeResource BrandErrorSoftBrush}" CornerRadius="{StaticResource BrandSectionRadius}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingM}">
                            <TextBlock x:Name="OnboardingWarmingFailureText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Assertive" HorizontalAlignment="Center" Style="{StaticResource BrandBodyStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="OnboardingWarmingRetryButton" x:FieldModifier="internal" Click="OnboardingRetryButton_Click" Content="TRY AGAIN" HorizontalAlignment="Center" Style="{StaticResource BrandPrimaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="{StaticResource BrandOnboardingCardPadding}" Style="{StaticResource BrandSectionCardStyle}">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                <Grid Width="{StaticResource BrandOnboardingStatusSize}" AutomationProperties.AccessibilityView="Raw"><FontIcon x:Name="OnboardingWarmMicMark" x:FieldModifier="internal" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" /><FontIcon x:Name="OnboardingWarmMicPending" x:FieldModifier="internal" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xEA3A;" /></Grid>
                                <TextBlock x:Name="OnboardingWarmMicText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Microphone ready" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                <Grid Width="{StaticResource BrandOnboardingStatusSize}" AutomationProperties.AccessibilityView="Raw"><FontIcon x:Name="OnboardingWarmKeyMark" x:FieldModifier="internal" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" /><FontIcon x:Name="OnboardingWarmKeyPending" x:FieldModifier="internal" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xEA3A;" /></Grid>
                                <TextBlock x:Name="OnboardingWarmKeyText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Your shortcut is set" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                <Grid Width="{StaticResource BrandOnboardingStatusSize}" AutomationProperties.AccessibilityView="Raw"><FontIcon x:Name="OnboardingWarmEngineMark" x:FieldModifier="internal" Foreground="{ThemeResource BrandSuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" /><FontIcon x:Name="OnboardingWarmEnginePending" x:FieldModifier="internal" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xEA3A;" /></Grid>
                                <TextBlock x:Name="OnboardingWarmEngineText" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Speech engine" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="OnboardingWarmingCaption" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="This usually takes a moment. Nothing else is needed from you." TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 5. PRACTICE. EnviousWispr's own text box, which ordinary delivery writes into like any other. -->
                <StackPanel x:Name="OnboardingPracticePanel" x:FieldModifier="internal" Spacing="{StaticResource BrandOnboardingCardSpacing}" Visibility="Collapsed">
                    <TextBox x:Name="OnboardingPracticeBox" x:FieldModifier="internal" AcceptsReturn="True" AutomationProperties.Name="Your first dictation" MinHeight="{StaticResource BrandOnboardingPracticeBoxHeight}" TextChanged="OnboardingPracticeBox_TextChanged" TextWrapping="Wrap" />
                    <TextBlock x:Name="OnboardingPracticeFootnote" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource BrandHelperStyle}" Text="Your recording indicator appears while you hold the key." TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="OnboardingPracticeMicrophoneButton" x:FieldModifier="internal" AutomationProperties.HelpText="Opens the Windows microphone privacy page, where the switch for desktop apps is turned on." Click="OpenMicrophonePrivacyButton_Click" Content="Turn on the microphone" HorizontalAlignment="Center" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Grid>
        </ScrollViewer>
        <!--
            THE CAP AND THE PADDING SIT ON THE SAME ELEMENT, WHICH IS WHAT KEEPS THE BUTTON
            LINED UP WITH THE CARDS. The scrolling content caps at 1040 and pads 40 a side,
            so a card is 960 wide. Padding the Border and capping its child instead let the
            button reach the full 1040 and hang 40 pixels past the cards on a wide window.

            THE PRIMARY ACTION IS PINNED, NOT SCROLLED: on a 768-pixel laptop a first-run
            screen whose only way forward is below the fold reads as a screen with no way
            forward. Its words change with the screen; its place does not.
        -->
        <Border x:Name="OnboardingFooter" x:FieldModifier="internal" Grid.Row="1" Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="0,1,0,0">
            <Grid MaxWidth="{StaticResource BrandOnboardingContentMaxWidth}" Padding="{StaticResource BrandOnboardingFooterPadding}">
            <StackPanel Spacing="{StaticResource BrandSpacingS}">
                <Button x:Name="FinishOnboardingButton" x:FieldModifier="internal" AccessKey="G" AutomationProperties.HelpText="Moves to the next setup step. Press Control plus Enter from anywhere on this screen." Click="FinishOnboardingButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource BrandPrimaryButtonStyle}" Content="Get Started">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
                <HyperlinkButton x:Name="OnboardingSkipButton" x:FieldModifier="internal" Click="OnboardingSkipButton_Click" Content="Skip this step" HorizontalAlignment="Center" Style="{StaticResource BrandHyperlinkButtonStyle}" Visibility="Collapsed" />
                <TextBlock x:Name="OnboardingFooterText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="You can change every choice later in Settings. No account is required." TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
