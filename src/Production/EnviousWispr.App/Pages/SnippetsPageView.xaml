<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EnviousWispr.App.Pages.SnippetsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:EnviousWispr.Core.Settings"
    xmlns:local="using:EnviousWispr.App"
    xmlns:controls="using:EnviousWispr.App.Controls">
    <Grid x:Name="SnippetsPage" x:FieldModifier="internal" AutomationProperties.Name="Snippets page" Visibility="Collapsed">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource BrandFluentPageMaxWidth}" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0" RowSpacing="{StaticResource BrandSpacingL}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="{StaticResource BrandSpacingL}">
                    <StackPanel Spacing="{StaticResource BrandSpacingXs}" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource BrandPageTitleStyle}" Text="Snippets" />
                        <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Say your keyword, then a snippet. The saved text lands for you. Snippets stay on this PC and travel in a portable profile export." TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Padding="16,12" Style="{StaticResource BrandSettingsCardStyle}">
                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Center">
                                <FontIcon FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE8B5;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource BrandSpacingXs}">
                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Switching from another dictation app?" />
                                <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Bring your snippets over from Wispr Flow, CSV, exported JSON, or a pasted list." TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Import" Style="{StaticResource BrandQuietButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Import snippets from another app or file">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="From another app" Click="SnippetsFromAnotherAppMenuItem_Click" />
                                        <MenuFlyoutItem Text="Open a file" Click="OpenSnippetsFileMenuItem_Click" />
                                        <MenuFlyoutItem Text="Paste snippets" Click="PasteSnippetsMenuItem_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>
                    <Border Padding="20" Style="{StaticResource BrandSettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Style="{StaticResource BrandIconTileStyle}" VerticalAlignment="Top">
                                    <TextBlock Text="{}{}" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource BrandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="Paste the text you type over and over, by voice" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Say your keyword followed by a trigger phrase anywhere you dictate. AI Polish never rewrites snippets." TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Border Background="{ThemeResource BrandPageBgBrush}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" CornerRadius="{ThemeResource BrandButtonRadius}" Padding="12,10">
                                <Grid ColumnSpacing="{StaticResource BrandSpacingS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Say" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource BrandAccentChipStyle}">
                                            <TextBlock x:Name="SnippetFlowKeywordChipText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="backslash" />
                                        </Border>
                                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="+" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource BrandNeutralChipStyle}">
                                            <TextBlock x:Name="SnippetFlowTriggerChipText" x:FieldModifier="internal" Style="{StaticResource BrandNeutralChipTextStyle}" Text="my email" />
                                        </Border>
                                        <TextBlock Style="{StaticResource BrandHelperStyle}" Text="&#x2192;" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="SnippetFlowExpansionText" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandRowLabelStyle}" Text="john.doe@example.com" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE720;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource BrandSpacingXs}">
                                    <Grid HorizontalAlignment="Left" ColumnSpacing="{StaticResource BrandSpacingXs}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SnippetKeywordLabel" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Keyword" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource BrandHelpButtonStyle}" AutomationProperties.Name="About snippet keyword" ToolTipService.ToolTip="What is this?">
                                            <FontIcon FontSize="{StaticResource BrandHelpGlyphSize}" Glyph="&#xE9CE;" />
                                            <Button.Flyout>
                                                <Flyout FlyoutPresenterStyle="{StaticResource BrandHelpFlyoutPresenterStyle}">
                                                    <TextBlock x:Name="SnippetKeywordExample" x:FieldModifier="internal" MaxWidth="{StaticResource BrandHelpFlyoutMaxWidth}" Style="{StaticResource BrandBodyStyle}" TextWrapping="Wrap" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <TextBlock Style="{StaticResource BrandHelperStyle}" Text="Say this first, then your trigger. One word." TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="SnippetKeywordBox" x:FieldModifier="internal" Grid.Column="2" AutomationProperties.LabeledBy="{x:Bind SnippetKeywordLabel, Mode=OneTime}" AutomationProperties.HelpText="A snippet only fires when you say this word first." MinWidth="180" MaxLength="64" VerticalAlignment="Center" KeyDown="SnippetKeywordBox_KeyDown" LostFocus="SnippetKeywordBox_LostFocus" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1" RowSpacing="{StaticResource BrandSpacingS}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="{StaticResource BrandSpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BrandSubsectionEyebrowStyle}" Text="YOUR SNIPPETS" VerticalAlignment="Center" />
                        <TextBlock x:Name="SnippetCountText" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandHelperStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="1" Padding="0" Style="{StaticResource BrandSettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="SnippetsToolbarGrid" x:FieldModifier="internal" Grid.Row="0" Padding="16,12" ColumnSpacing="{StaticResource BrandSpacingS}" SizeChanged="SnippetsToolbarGrid_SizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="SnippetSearchContainer" x:FieldModifier="internal">
                                    <TextBox x:Name="SnippetSearchBox" x:FieldModifier="internal" AutomationProperties.Name="Search snippets" Padding="36,6,36,6" PlaceholderText="Search snippets" TextChanged="SnippetSearchBox_TextChanged" />
                                    <Button x:Name="SnippetSearchClearButton" x:FieldModifier="internal" Click="ClearSnippetSearchButton_Click" AutomationProperties.Name="Clear snippet search" ToolTipService.ToolTip="Clear search" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Padding="6,4" Style="{StaticResource BrandHelpButtonStyle}" Visibility="Collapsed">
                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                    </Button>
                                    <FontIcon FontSize="14" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xE721;" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                                <StackPanel x:Name="SnippetsToolbarActionsPanel" x:FieldModifier="internal" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <Button Content="Import" AutomationProperties.Name="Import snippets" AutomationProperties.HelpText="Bring your snippets in from anywhere. Nothing is added until you review it." Style="{StaticResource BrandQuietButtonStyle}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Paste snippets" Click="PasteSnippetsMenuItem_Click" AutomationProperties.HelpText="Paste a list from anywhere: plain lines, CSV, or exported JSON." />
                                                <MenuFlyoutItem Text="Open a file" Click="OpenSnippetsFileMenuItem_Click" AutomationProperties.HelpText="Pick the EnviousWispr Snippets.json you exported, a CSV, or a plain list. Snippets you already have are left as they are." />
                                                <MenuFlyoutItem Text="From another app" Click="SnippetsFromAnotherAppMenuItem_Click" AutomationProperties.HelpText="Bring your snippets over from another dictation app." />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Name="ExportSnippetsButton" x:FieldModifier="internal" Click="ExportSnippetsButton_Click" Content="Export" AutomationProperties.Name="Export snippets" AutomationProperties.HelpText="Saves your snippets and your keyword to a file you can import on another PC or Mac." Style="{StaticResource BrandQuietButtonStyle}" />
                                    <Button x:Name="AddSnippetToolbarButton" x:FieldModifier="internal" Click="AddSnippetToolbarButton_Click" Content="+ Add snippet" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Height="1" Background="{ThemeResource BrandDividerBrush}" />
                            <ListView x:Name="SnippetList" x:FieldModifier="internal" Grid.Row="2" Padding="4" SelectionChanged="ListSelectionChanged" ItemClick="SnippetList_ItemClick" IsItemClickEnabled="True" AutomationProperties.Name="Saved snippets" SelectionMode="None">
                                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="2.0" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,10" ColumnSpacing="{StaticResource BrandSpacingM}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="{Binding Name}" TextAlignment="DetectFromContent" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource BrandNeutralChipStyle}" Padding="8,2" Visibility="{Binding ExampleVisibility}" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource BrandNeutralChipTextStyle}" Text="Example" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource BrandHelperStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" Text="{Binding BodyPreview}" TextAlignment="DetectFromContent" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                                <Button Click="EditSnippetRowButton_Click" Content="Edit" Tag="{Binding}" Style="{StaticResource BrandQuietButtonStyle}" Padding="10,4,10,4" VerticalAlignment="Center" AutomationProperties.HelpText="Edit this snippet" />
                                                <FontIcon FontSize="12" Foreground="{ThemeResource BrandTextTertiaryBrush}" Glyph="&#xE76C;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border x:Name="SnippetNoMatchState" x:FieldModifier="internal" Grid.Row="2" VerticalAlignment="Top" Padding="24" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingS}">
                                    <TextBlock x:Name="SnippetNoMatchText" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <Button HorizontalAlignment="Center" Click="ClearSnippetSearchButton_Click" Content="Clear search" Style="{StaticResource BrandQuietButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SnippetEmptyState" x:FieldModifier="internal" Grid.Row="2" VerticalAlignment="Top" AutomationProperties.Name="No snippets yet" Padding="24" Visibility="Collapsed">
                                <StackPanel MaxWidth="{StaticResource BrandInlineContentMaxWidth}" HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingS}">
                                    <Border Width="56" Height="56" HorizontalAlignment="Center" Style="{StaticResource BrandIconTileStyle}"><FontIcon Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE70B;" /></Border>
                                    <TextBlock Style="{StaticResource BrandRowTitleStyle}" Text="No snippets yet" TextAlignment="Center" />
                                    <TextBlock Style="{StaticResource BrandBodyStyle}" Text="Save the text you type over and over. An email address, a signature, a link you always paste." TextAlignment="Center" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource BrandSpacingS}">
                                        <Button Click="OpenNewSnippetDialogButton_Click" Content="Add your first snippet" Style="{StaticResource BrandQuietButtonStyle}" />
                                        <Button x:Name="LoadExampleSnippetsButton" x:FieldModifier="internal" Click="LoadExampleSnippetsButton_Click" Content="Load example snippets" Style="{StaticResource BrandQuietButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
