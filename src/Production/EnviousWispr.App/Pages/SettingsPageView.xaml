<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EnviousWispr.App.Pages.SettingsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:EnviousWispr.Core.Settings"
    xmlns:local="using:EnviousWispr.App"
    xmlns:controls="using:EnviousWispr.App.Controls">
    <ScrollViewer x:Name="SettingsPage" x:FieldModifier="internal" AutomationProperties.Name="Settings page" HorizontalScrollMode="Disabled" Visibility="Collapsed">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource BrandFluentPageMaxWidth}" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" Spacing="{StaticResource BrandSpacingL}">
            <StackPanel Spacing="{StaticResource BrandSpacingXs}" Margin="0,0,0,8">
                <TextBlock x:Name="SettingsPageTitle" x:FieldModifier="internal" Style="{StaticResource BrandPageTitleStyle}" Text="All Settings" />
                <TextBlock x:Name="SettingsPageDescription" x:FieldModifier="internal" Style="{StaticResource BrandBodyStyle}" Text="Choose how EnviousWispr records, transcribes, cleans, and stores your dictation." TextWrapping="Wrap" />
            </StackPanel>
            <!--
                THE RULE IS PAGE-WIDE, SO IT IS SAID ONCE PER PAGE. macOS made this a
                founder decision in 2026-07-03 and its source says why: repeating it
                in every card that freezes turns a standing fact about the page into
                noise, and a user reads it as being about the one control it sits
                under. Accent-tinted so it reads as a notice ABOVE the cards rather
                than part of any of them.
            -->
            <Border x:Name="FrozenPerRecordingBanner" x:FieldModifier="internal" Background="{ThemeResource BrandAccentLightBrush}" BorderBrush="{ThemeResource BrandAccentBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11" Visibility="Collapsed"><Grid ColumnSpacing="{StaticResource BrandSpacingS}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" Foreground="{ThemeResource BrandAccentBrush}" Glyph="&#xE946;" VerticalAlignment="Top" /><TextBlock x:Name="FrozenPerRecordingText" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandBodyStyle}" TextWrapping="Wrap" /></Grid></Border>
            <Border x:Name="SettingsTabStrip" x:FieldModifier="internal" Style="{StaticResource BrandTabStripContainerStyle}" Visibility="Collapsed">
                <Grid>
                    <Grid x:Name="DictationTabStrip" x:FieldModifier="internal" SizeChanged="SettingsTabStrip_SizeChanged" Visibility="Collapsed">
                        <Button x:Name="DictationTabEngine" x:FieldModifier="internal" Click="DictationTab_Click" Tag="engine" Style="{StaticResource BrandTopTabActiveButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="SettingsTranscriptionNavGlyph" x:FieldModifier="internal" Glyph="&#xE8BD;" FontSize="14" />
                                <TextBlock Text="Engine" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DictationTabMicrophone" x:FieldModifier="internal" Click="DictationTab_Click" Tag="microphone" Style="{StaticResource BrandTopTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="SettingsMicrophoneNavGlyph" x:FieldModifier="internal" Glyph="&#xE720;" FontSize="14" />
                                <TextBlock Text="Microphone" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DictationTabLivePreview" x:FieldModifier="internal" Click="DictationTab_Click" Tag="live-preview" Style="{StaticResource BrandTopTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="SettingsLivePreviewNavGlyph" x:FieldModifier="internal" Glyph="&#xE890;" FontSize="14" />
                                <TextBlock Text="Live Preview" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DictationTabPill" x:FieldModifier="internal" Click="DictationTab_Click" Tag="pill" Style="{StaticResource BrandTopTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="SettingsPillNavGlyph" x:FieldModifier="internal" Glyph="&#xE790;" FontSize="14" />
                                <TextBlock Text="Recording Pill" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DictationTabSounds" x:FieldModifier="internal" Click="DictationTab_Click" Tag="sounds" Style="{StaticResource BrandTopTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="SettingsSoundsNavGlyph" x:FieldModifier="internal" Glyph="&#xE767;" FontSize="14" />
                                <TextBlock Text="Sounds" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DictationTabClipboard" x:FieldModifier="internal" Click="DictationTab_Click" Tag="clipboard" Style="{StaticResource BrandTopTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="SettingsClipboardNavGlyph" x:FieldModifier="internal" Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="Clipboard" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid x:Name="AppTabStrip" x:FieldModifier="internal" SizeChanged="SettingsTabStrip_SizeChanged" Visibility="Collapsed">
                        <Button x:Name="AppTabAppearance" x:FieldModifier="internal" Click="AppTab_Click" Tag="appearance" Style="{StaticResource BrandTopTabActiveButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="SettingsAppearanceNavGlyph" x:FieldModifier="internal" Glyph="&#xE790;" FontSize="14" />
                                <TextBlock Text="Appearance" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AppTabPermissions" x:FieldModifier="internal" Click="AppTab_Click" Tag="permissions" Style="{StaticResource BrandTopTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="HelpPermissionsNavGlyph" x:FieldModifier="internal" Glyph="&#xE72E;" FontSize="14" />
                                <TextBlock Text="Permissions" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AppTabPrivacy" x:FieldModifier="internal" Click="AppTab_Click" Tag="privacy" Style="{StaticResource BrandTopTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="HelpPrivacyNavGlyph" x:FieldModifier="internal" Glyph="&#xE897;" FontSize="14" />
                                <TextBlock Text="Privacy" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AppTabBackup" x:FieldModifier="internal" Click="AppTab_Click" Tag="backup" Style="{StaticResource BrandTopTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="SettingsProfileNavGlyph" x:FieldModifier="internal" Glyph="&#xE78C;" FontSize="14" />
                                <TextBlock Text="Backup" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AppTabUpdatesLicenses" x:FieldModifier="internal" Click="AppTab_Click" Tag="updates-licenses" Style="{StaticResource BrandTopTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}">
                                <FontIcon x:Name="HelpUpdatesNavGlyph" x:FieldModifier="internal" Glyph="&#xE895;" FontSize="14" />
                                <FontIcon x:Name="HelpLicensesNavGlyph" x:FieldModifier="internal" Glyph="&#xEB95;" Visibility="Collapsed" />
                                <FontIcon x:Name="SettingsHistoryNavGlyph" x:FieldModifier="internal" Glyph="&#xE81C;" Visibility="Collapsed" />
                                <TextBlock Text="Updates &amp; Licenses" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="MicrophoneSection" x:FieldModifier="internal" Style="{StaticResource BrandSettingsSectionStyle}">
                <StackPanel Spacing="{StaticResource BrandSpacingM}">
                    <StackPanel x:Name="MicrophoneEyebrow" x:FieldModifier="internal" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="MicrophoneEyebrowGlyph" x:FieldModifier="internal" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind SettingsMicrophoneNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Microphone" /></StackPanel>
                    <Border Style="{StaticResource BrandSettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource BrandSpacingM}">
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE720;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}"><Grid HorizontalAlignment="Left" ColumnSpacing="{StaticResource BrandSpacingXs}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="MicrophoneLabel" x:FieldModifier="internal" Style="{StaticResource BrandRowLabelStyle}" Text="Microphone" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Style="{StaticResource BrandHelpButtonStyle}" AutomationProperties.Name="About Microphone" ToolTipService.ToolTip="What is this?"><FontIcon FontSize="{StaticResource BrandHelpGlyphSize}" Glyph="&#xE9CE;" /><Button.Flyout><Flyout FlyoutPresenterStyle="{StaticResource BrandHelpFlyoutPresenterStyle}"><TextBlock MaxWidth="{StaticResource BrandHelpFlyoutMaxWidth}" Style="{StaticResource BrandBodyStyle}" Text="Chooses which microphone EnviousWispr listens to. Leave it on Auto to follow your active physical Windows default, or fall back automatically to a physical microphone (built-in, USB, then Bluetooth) and skip virtual loopback cables." TextWrapping="Wrap" /></Flyout></Button.Flyout></Button></Grid><ComboBox x:Name="MicrophoneComboBox" x:FieldModifier="internal" AutomationProperties.LabeledBy="{x:Bind MicrophoneLabel, Mode=OneTime}" ItemTemplate="{StaticResource BrandTrimmedDisplayNameTemplate}" HorizontalAlignment="Stretch" /></StackPanel></Grid><!--
                                THE ONE PLACE SOMEBODY CHECKS THEIR MICROPHONE WORKS, AND IT
                                COULD NOT TELL THEM. This page named a device and stopped
                                there, so an app that was hearing pure silence looked exactly
                                like one that was working - which is what happened, and cost a
                                day. A meter here answers it in the three seconds it takes to
                                say a word.
                            -->
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE9A9;" /><StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingS}"><Grid HorizontalAlignment="Left" ColumnSpacing="{StaticResource BrandSpacingXs}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Check it can hear you" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Style="{StaticResource BrandHelpButtonStyle}" AutomationProperties.Name="About microphone check" ToolTipService.ToolTip="What is this?"><FontIcon FontSize="{StaticResource BrandHelpGlyphSize}" Glyph="&#xE9CE;" /><Button.Flyout><Flyout FlyoutPresenterStyle="{StaticResource BrandHelpFlyoutPresenterStyle}"><TextBlock MaxWidth="{StaticResource BrandHelpFlyoutMaxWidth}" Style="{StaticResource BrandBodyStyle}" Text="Records for a few seconds and monitors live audio packets to verify the selected microphone is active and receiving your voice rather than silence." TextWrapping="Wrap" /></Flyout></Button.Flyout></Button></Grid><StackPanel x:Name="MicrophoneTestBars" x:FieldModifier="internal" Height="22" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center"><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /><Border Width="6" Height="6" Background="{ThemeResource BrandTextSecondaryBrush}" CornerRadius="3" Opacity="0.25" VerticalAlignment="Center" /></StackPanel><TextBlock x:Name="MicrophoneTestResultText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandHelperStyle}" Text="Press Test and say a few words. The bars follow your voice." TextWrapping="Wrap" /><Button x:Name="MicrophoneTestButton" x:FieldModifier="internal" Click="MicrophoneTestButton_Click" Content="Test microphone" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" /></StackPanel></Grid>
                            <Grid ColumnSpacing="{StaticResource BrandSpacingM}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Width="{StaticResource BrandRowIconColumnWidth}" Margin="{StaticResource BrandRowIconInset}" VerticalAlignment="Top" Foreground="{ThemeResource BrandTextSecondaryBrush}" Glyph="&#xE72E;" /><Button Grid.Column="1" AutomationProperties.HelpText="Opens the Windows microphone privacy controls." Click="OpenMicrophonePrivacyButton_Click" Content="Open microphone privacy settings" HorizontalAlignment="Left" Style="{StaticResource BrandQuietButtonStyle}" /></Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border x:Name="TranscriptionEngineSection" x:FieldModifier="internal" Tag="settings-transcription" Style="{StaticResource BrandSettingsSectionStyle}">
                <StackPanel Spacing="{StaticResource BrandSpacingM}">
                    <StackPanel x:Name="TranscriptionengineEyebrow" x:FieldModifier="internal" Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}" VerticalAlignment="Center"><FontIcon x:Name="TranscriptionengineEyebrowGlyph" x:FieldModifier="internal" Style="{StaticResource BrandSectionEyebrowGlyphStyle}" Glyph="{x:Bind SettingsTranscriptionNavGlyph.Glyph, Mode=OneTime}" /><TextBlock Style="{StaticResource BrandSectionEyebrowStyle}" Text="Transcription engine" /></StackPanel>
                    <Border x:Name="ActiveEngineSummaryCard" x:FieldModifier="internal" Style="{StaticResource BrandSectionCardStyle}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" Padding="16,14">
                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="10" Style="{StaticResource BrandIconTileStyle}">
                                <FontIcon x:Name="ActiveEngineIcon" x:FieldModifier="internal" Glyph="&#xE945;" FontSize="20" Foreground="{ThemeResource BrandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                    <TextBlock x:Name="ActiveEngineNameText" x:FieldModifier="internal" Style="{StaticResource BrandRowTitleStyle}" Text="Parakeet" />
                                    <Border x:Name="ActiveEngineBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}" Padding="8,2">
                                        <TextBlock x:Name="ActiveEngineBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ActiveEngineDescriptionText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Fast local speech recognition for 25 languages (640 MB) that runs smoothly on most PCs." TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" x:Name="ActiveEngineStatusBadge" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipStyle}">
                                <TextBlock x:Name="ActiveEngineStatusText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Checking..." />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="EngineChooserPanel" x:FieldModifier="internal" Spacing="{StaticResource BrandSpacingS}">
                        <Grid HorizontalAlignment="Left" ColumnSpacing="{StaticResource BrandSpacingXs}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="Final transcription engine" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Style="{StaticResource BrandHelpButtonStyle}" AutomationProperties.Name="About Final transcription engine" ToolTipService.ToolTip="What is this?"><FontIcon FontSize="{StaticResource BrandHelpGlyphSize}" Glyph="&#xE9CE;" /><Button.Flyout><Flyout FlyoutPresenterStyle="{StaticResource BrandHelpFlyoutPresenterStyle}"><TextBlock MaxWidth="{StaticResource BrandHelpFlyoutMaxWidth}" Style="{StaticResource BrandBodyStyle}" Text="Chooses the local speech-to-text model on this PC that turns each finished recording into delivered text." TextWrapping="Wrap" /></Flyout></Button.Flyout></Button></Grid>
                        <Grid x:Name="EngineCardsGrid" x:FieldModifier="internal" ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingM}" SizeChanged="EngineCardsGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ParakeetCardColumn" x:FieldModifier="internal" Width="*" />
                                <ColumnDefinition x:Name="WhisperCardColumn" x:FieldModifier="internal" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="ParakeetEngineCardContainer" x:FieldModifier="internal" Grid.Row="0" Grid.Column="0" Style="{StaticResource BrandSectionCardStyle}" BorderBrush="{ThemeResource BrandAccentBrush}" BorderThickness="2" Padding="16,14" VerticalAlignment="Stretch" Tapped="ParakeetEngineCardContainer_Tapped">
                                <Grid RowSpacing="{StaticResource BrandSpacingS}" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" ColumnSpacing="{StaticResource BrandSpacingS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="ParakeetEngineCard" x:FieldModifier="internal" Grid.Column="0" GroupName="FinalTranscriptionEngine" Checked="EngineCardChecked" Click="EngineCardClicked" Content="Parakeet" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource BrandTextPrimaryBrush}" Padding="4,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Parakeet speech engine" AutomationProperties.HelpText="Fast local speech recognition for 25 languages, 640 MB." />
                                        <Border x:Name="ParakeetEngineBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandAccentChipStyle}" Padding="8,2">
                                            <TextBlock x:Name="ParakeetEngineBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="Recommended" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Spacing="{StaticResource BrandSpacingS}">
                                        <TextBlock x:Name="ParakeetCardTaglineText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Fast local accuracy" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingXs}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BrandHelperStyle}" Text="Model" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="parakeet-tdt-0.6b-v3" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource BrandHelperStyle}" Text="Languages" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="25 languages" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BrandHelperStyle}" Text="Download size" />
                                            <TextBlock x:Name="ParakeetCardSizeText" x:FieldModifier="internal" Grid.Row="2" Grid.Column="1" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="640 MB" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource BrandHelperStyle}" Text="Hardware" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="Runs fast on CPU" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="{StaticResource BrandSpacingS}">
                                        <Border Height="1" Background="{ThemeResource BrandDividerBrush}" />
                                        <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                                            <TextBlock x:Name="ParakeetCardStatusText" x:FieldModifier="internal" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BrandRowLabelStyle}" Text="Checking..." TextWrapping="Wrap" />
                                            <TextBlock x:Name="ParakeetCardDetailText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Checking installed files..." TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ProgressBar x:Name="ParakeetCardProgress" x:FieldModifier="internal" AutomationProperties.Name="Parakeet speech model download" Background="{ThemeResource BrandDividerBrush}" Foreground="{ThemeResource BrandAccentSolidBrush}" Maximum="100" Minimum="0" Visibility="Collapsed" />
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                                            <Button x:Name="ParakeetDownloadButton" x:FieldModifier="internal" AutomationProperties.Name="Download Parakeet speech model" Click="ParakeetDownloadButton_Click" Content="Download (640 MB)" Style="{StaticResource BrandPrimaryButtonStyle}" Visibility="Collapsed" />
                                            <Button x:Name="ParakeetCancelButton" x:FieldModifier="internal" AutomationProperties.Name="Cancel Parakeet download" Click="CancelModelDownloadButton_Click" Content="Cancel" Style="{StaticResource BrandQuietButtonStyle}" Visibility="Collapsed" />
                                            <Button x:Name="ParakeetRemoveButton" x:FieldModifier="internal" AutomationProperties.Name="Remove Parakeet speech model" Click="ParakeetRemoveButton_Click" Content="Remove" Style="{StaticResource BrandDestructiveButtonStyle}" Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="WhisperEngineCardContainer" x:FieldModifier="internal" Grid.Row="0" Grid.Column="1" Style="{StaticResource BrandSectionCardStyle}" BorderBrush="{ThemeResource BrandDividerBrush}" BorderThickness="1" Padding="16,14" VerticalAlignment="Stretch" Tapped="WhisperEngineCardContainer_Tapped">
                                <Grid RowSpacing="{StaticResource BrandSpacingS}" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" ColumnSpacing="{StaticResource BrandSpacingS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="WhisperEngineCard" x:FieldModifier="internal" Grid.Column="0" GroupName="FinalTranscriptionEngine" Checked="EngineCardChecked" Click="EngineCardClicked" Content="Whisper" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource BrandTextPrimaryBrush}" Padding="4,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Whisper speech engine" AutomationProperties.HelpText="Multilingual speech recognition for 99+ languages, 548 MB." />
                                        <Border x:Name="WhisperEngineBadge" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource BrandAccentChipStyle}" Padding="8,2">
                                            <TextBlock x:Name="WhisperEngineBadgeText" x:FieldModifier="internal" Style="{StaticResource BrandAccentChipTextStyle}" Text="99+ languages" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Spacing="{StaticResource BrandSpacingS}">
                                        <TextBlock x:Name="WhisperCardTaglineText" x:FieldModifier="internal" Style="{StaticResource BrandHelperStyle}" Text="Broad multilingual" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="{StaticResource BrandSpacingM}" RowSpacing="{StaticResource BrandSpacingXs}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BrandHelperStyle}" Text="Model" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BrandHelperStyle}" Foreground="{ThemeResource BrandTextPrimaryBrush}" Text="whisper-large-v3-turbo" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource BrandHelperStyle}" Text="Languages" />
