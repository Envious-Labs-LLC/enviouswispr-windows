<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="EnviousWispr.App.FeedbackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Send feedback"
    CloseButtonText="Close"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonStyle="{StaticResource BrandPrimaryButtonStyle}"
    PrimaryButtonClick="FeedbackDialog_PrimaryButtonClick"
    CloseButtonClick="FeedbackDialog_CloseButtonClick">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="0,0,4,0">
        <StackPanel Spacing="{StaticResource BrandSpacingM}" MinWidth="440">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource BrandSpacingM}">
                <Border
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Style="{StaticResource BrandIconTileStyle}">
                    <FontIcon
                        Glyph="&#xED15;"
                        FontSize="18"
                        Foreground="{ThemeResource BrandAccentBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="{StaticResource BrandSpacingXs}">
                    <TextBlock
                        Text="Send Feedback"
                        Style="{StaticResource BrandRowTitleStyle}" />
                    <TextBlock
                        Text="Tell us what happened or suggest an improvement."
                        Style="{StaticResource BrandHelperStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Category segmented pill bar -->
            <Border
                Background="{ThemeResource BrandPageBgBrush}"
                BorderBrush="{ThemeResource BrandDividerBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource BrandSectionRadius}"
                Padding="4">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource BrandSpacingXs}">
                    <Button
                        x:Name="BugCategoryButton"
                        Grid.Column="0"
                        Content="Bug report"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource BrandSegmentedActiveButtonStyle}"
                        AutomationProperties.Name="Bug report"
                        Click="CategoryButton_Click" />
                    <Button
                        x:Name="FeatureCategoryButton"
                        Grid.Column="1"
                        Content="Feature idea"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource BrandSegmentedButtonStyle}"
                        AutomationProperties.Name="Feature idea"
                        Click="CategoryButton_Click" />
                    <Button
                        x:Name="GeneralCategoryButton"
                        Grid.Column="2"
                        Content="General"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource BrandSegmentedButtonStyle}"
                        AutomationProperties.Name="General"
                        Click="CategoryButton_Click" />
                </Grid>
            </Border>

            <!-- Feedback message -->
            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                <TextBox
                    x:Name="MessageTextBox"
                    AcceptsReturn="True"
                    MinHeight="110"
                    MaxHeight="180"
                    MaxLength="4000"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    PlaceholderText="What happened, or what would you like to see?"
                    AutomationProperties.Name="Feedback message"
                    TextChanged="MessageTextBox_TextChanged" />
                <TextBlock
                    x:Name="CharacterCountText"
                    Text="0 / 4000"
                    Style="{StaticResource BrandHelperStyle}"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Character count" />
            </StackPanel>

            <!-- Optional contact email -->
            <StackPanel Spacing="{StaticResource BrandSpacingXs}">
                <TextBox
                    x:Name="EmailTextBox"
                    MaxLength="254"
                    PlaceholderText="Email (optional, if you'd like a reply)"
                    AutomationProperties.Name="Contact email"
                    TextChanged="EmailTextBox_TextChanged" />
                <TextBlock
                    x:Name="EmailValidationText"
                    Visibility="Collapsed"
                    Style="{StaticResource BrandHelperStyle}"
                    Foreground="{ThemeResource BrandErrorBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Privacy-safe diagnostics toggle & preview -->
            <Border
                Background="{ThemeResource BrandCardBgBrush}"
                BorderBrush="{ThemeResource BrandDividerBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource BrandSectionRadius}"
                Padding="14,12">
                <StackPanel Spacing="{StaticResource BrandSpacingS}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource BrandSpacingM}">
                        <StackPanel Grid.Column="0" Spacing="{StaticResource BrandSpacingXs}">
                            <TextBlock
                                Text="Include privacy-safe diagnostics"
                                Style="{StaticResource BrandRowLabelStyle}" />
                            <TextBlock
                                Text="App version, OS, engine, hardware class, and recent event codes. No dictated text, audio, API keys, or paths."
                                Style="{StaticResource BrandHelperStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="IncludeDiagnosticsToggle"
                            Grid.Column="1"
                            Style="{StaticResource BrandToggleSwitchStyle}"
                            IsOn="True"
                            OnContent=""
                            OffContent=""
                            MinWidth="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Include privacy-safe diagnostics"
                            Toggled="IncludeDiagnosticsToggle_Toggled" />
                    </Grid>

                    <Expander
                        x:Name="DiagnosticsPreviewExpander"
                        Header="Preview diagnostics"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="False"
                        AutomationProperties.Name="Preview diagnostics">
                        <ScrollViewer
                            MaxHeight="150"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Background="{ThemeResource BrandPageBgBrush}"
                            BorderBrush="{ThemeResource BrandDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource BrandSectionRadius}"
                            Padding="10">
                            <TextBlock
                                x:Name="DiagnosticsPreviewTextBlock"
                                FontFamily="Consolas"
                                FontSize="14"
                                Foreground="{ThemeResource BrandTextBodyBrush}"
                                IsTextSelectionEnabled="True"
                                TextWrapping="NoWrap"
                                AutomationProperties.Name="Diagnostics preview" />
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Inline status / progress banner -->
            <Border
                x:Name="FeedbackStatusBorder"
                Visibility="Collapsed"
                Background="{ThemeResource BrandAccentLightBrush}"
                BorderBrush="{ThemeResource BrandDividerBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource BrandSectionRadius}"
                Padding="12,10">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource BrandSpacingS}">
                    <ProgressRing
                        x:Name="SubmittingProgressRing"
                        Width="18"
                        Height="18"
                        IsActive="False"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="FeedbackStatusText"
                        Style="{StaticResource BrandBodyStyle}"
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Fallback link -->
            <HyperlinkButton
                x:Name="GitHubIssuesLink"
                Content="Or open GitHub Issues"
                Style="{StaticResource BrandHyperlinkButtonStyle}"
                AutomationProperties.Name="Or open GitHub Issues"
                Padding="0,2,0,2"
                Click="GitHubIssuesLink_Click" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
