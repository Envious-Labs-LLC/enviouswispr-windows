    </Style>

    <!--
        macOS overlay-local gaps, kept here rather than in Layout.xaml so the main window's 4px
        spacing scale stays untouched while the floating pill matches the atlas geometry.
    -->
    <x:Double x:Key="PillHeaderSpacing">10</x:Double>
    <x:Double x:Key="PillRailBarSpacing">2</x:Double>
    <x:Double x:Key="PillWellMeterSpacing">1.5</x:Double>
    <x:Double x:Key="PillBadgeDotSpacing">6</x:Double>

    <!--
        THE RECORDING DESIGNS' LOOKS, AS STYLES FOR THE SAME REASON AS THE SEVERITY SET BELOW. The
        Reading Well follows the pill's own theme, and a brush read from the application dictionary in
        code resolves against the machine's theme instead. A style's ThemeResource setters resolve
        against the element they land on, so a Light pill on a Dark machine still draws Light.

        Surface styles set Background ONLY (applied to OverlayRoot, including its 2px bleed zone);
        edge styles set BorderBrush ONLY (applied to FrameBorder inside that bleed). Keeping the two
        separate stops the semi-transparent fill from painting twice over the visible pill.
    -->
    <Style x:Key="PillNoticeSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillSurfaceBrush}" />
    </Style>
    <Style x:Key="PillCapsuleSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillCapsuleSurfaceBrush}" />
    </Style>
    <Style x:Key="PillWellSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillWellSurfaceBrush}" />
    </Style>
    <Style x:Key="PillWellFadeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillWellFadeBrush}" />
    </Style>
    <Style x:Key="PillCapsuleEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillCapsuleBorderBrush}" />
    </Style>
    <Style x:Key="PillWellEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillWellBorderBrush}" />
    </Style>
    <Style x:Key="PillCapsuleTimerTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillCapsuleTextBrush}" />
    </Style>
    <Style x:Key="PillWellTimerTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillWellTimerBrush}" />
    </Style>
    <Style x:Key="PillWellModeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillWellModeQuietBrush}" />
    </Style>
    <Style x:Key="PillWellTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillWellTextBrush}" />
    </Style>
    <Style x:Key="PillCapsuleBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillCapsuleBadgeFillBrush}" />
    </Style>
    <Style x:Key="PillCapsuleBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillCapsuleBadgeTextBrush}" />
    </Style>
    <Style x:Key="PillWellBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillWellBadgeFillBrush}" />
    </Style>
    <Style x:Key="PillWellBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillWellBadgeTextBrush}" />
    </Style>
    <Style x:Key="PillWellBadgeDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource PillWellBadgeTextBrush}" />
    </Style>

    <!--
        The pill's own button. It borrows the notice ink rather than the accent, because the pill
        already carries a severity colour on its edge and its glyph, and a third colour on the one
        control the user is meant to press would compete with the thing telling them why.
    -->
    <Style x:Key="PillActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PillBadgeFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--
            THE PLATFORM'S OWN CONTROL RADIUS, NOT A BRAND NUMBER. This was BrandPillRadius, which
            is 100 - far larger than the button is tall, so it rendered as a full ellipse. A
            lozenge is an iOS and macOS shape; every button in Windows 11 is a rounded rectangle,
            and photographed beside the system's own chrome the ellipse was the single most
            obviously foreign thing on the screen. ControlCornerRadius is the value Windows itself
            uses, so the button matches whatever the platform decides, now and after an update.
        -->
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <!--
            THE BADGE INK, NOT THE NOTICE INK, AND THE PAIRING IS THE WHOLE REASON. The fill is
            PillBadgeFill, which High Contrast resolves to SystemColorHighlight; the notice ink
            resolves to SystemColorWindowText. Those two are not a pair, and a High Contrast theme
            is free to make them the same colour - black text on a black button. PillBadgeText
            resolves to SystemColorHighlightText, which is the colour the system guarantees is
            legible ON that highlight.
        -->
        <Setter Property="Foreground" Value="{ThemeResource PillBadgeTextBrush}" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Compact single-line inline button for the 44-tall Escape Recovery capsule. -->
    <Style x:Key="PillInlineActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PillBadgeFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Foreground" Value="{ThemeResource PillBadgeTextBrush}" />
        <Setter Property="Padding" Value="12,3" />
    </Style>

    <!--
        ONE STYLE FAMILY PER SEVERITY, AND A STYLE RATHER THAN A BRUSH SET FROM CODE.
        The pill is a separate top-level window whose theme is set on its root, so a brush pulled
        out of the application dictionary resolves against the MACHINE's theme while everything
        around it follows the app's. Invisible while the two agree, wrong the moment somebody runs
        the app in Light on a Dark machine. A style's ThemeResource setters resolve against the
        element they land on, which is the property that makes them correct here, and it is why the
        pill's text already works this way.

        Neutral is a member of the set rather than the absence of one: recording and processing are
        states the pill can be in, and naming them here is what stops a future state rendering as a
        plain capsule and looking like somebody meant it.
    -->
    <Style x:Key="PillNeutralIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PillNoticeBrush}" />
    </Style>
    <Style x:Key="PillNeutralEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillBorderBrush}" />
    </Style>
    <Style x:Key="PillNeutralWashStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="PillSuccessIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PillSuccessInkBrush}" />
    </Style>
    <Style x:Key="PillSuccessEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillSuccessInkBrush}" />
    </Style>
    <Style x:Key="PillSuccessWashStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillSuccessWashBrush}" />
    </Style>
    <Style x:Key="PillAdvisoryIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PillAdvisoryInkBrush}" />
    </Style>
    <Style x:Key="PillAdvisoryEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillAdvisoryInkBrush}" />
    </Style>
    <Style x:Key="PillAdvisoryWashStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillAdvisoryWashBrush}" />
    </Style>
    <Style x:Key="PillWarningIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PillWarningInkBrush}" />
    </Style>
    <Style x:Key="PillWarningEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillWarningInkBrush}" />
    </Style>
    <Style x:Key="PillWarningWashStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillWarningWashBrush}" />
    </Style>
    <Style x:Key="PillErrorIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PillErrorInkBrush}" />
    </Style>
    <Style x:Key="PillErrorEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillErrorInkBrush}" />
    </Style>
    <Style x:Key="PillErrorWashStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillErrorWashBrush}" />
    </Style>
    <Style x:Key="PillDistressIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PillErrorInkBrush}" />
    </Style>
    <Style x:Key="PillDistressEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillErrorInkBrush}" />
    </Style>
    <Style x:Key="PillDistressWashStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillDistressWashBrush}" />
    </Style>
</ResourceDictionary>
