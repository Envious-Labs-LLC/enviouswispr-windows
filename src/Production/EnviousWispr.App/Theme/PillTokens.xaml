    <Style x:Key="PillModeQuietTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillModeQuietBrush}" />
    </Style>
    <Style x:Key="PillNoticeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillNoticeBrush}" />
    </Style>
    <Style x:Key="PillLiveTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillTextBrush}" />
    </Style>
    <Style x:Key="PillDimmedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PillTextDimmedBrush}" />
    </Style>

    <!--
        ONE STYLE FAMILY PER SEVERITY, AND A STYLE RATHER THAN A BRUSH SET FROM CODE.
        The pill is a separate top-level window whose theme is set on its root, so a brush pulled
        out of the application dictionary resolves against the MACHINE's theme while everything
        around it follows the app's. Invisible while the two agree, wrong the moment somebody runs
        the app in Light on a Dark machine. A style's ThemeResource setters resolve against the
        element they land on, which is the property that makes them correct here, and it is why the
        pill's text already works this way.

        Neutral is a member of the set rather than the absence of one: recording and processing are
        states the pill can be in, and naming them here is what stops a future state rendering as a
        plain capsule and looking like somebody meant it.
    -->
    <Style x:Key="PillNeutralIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PillNoticeBrush}" />
    </Style>
    <Style x:Key="PillNeutralEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillBorderBrush}" />
    </Style>
    <Style x:Key="PillNeutralWashStyle" TargetType="Border">
        <!-- No wash. The neutral pill is the surface itself. -->
    </Style>
    <Style x:Key="PillSuccessIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource PillSuccessInkBrush}" />
    </Style>
    <Style x:Key="PillSuccessEdgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PillSuccessInkBrush}" />
    </Style>
    <Style x:Key="PillSuccessWashStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PillSuccessWashBrush}" />
    </Style>
    <Style x:Key="PillAdvisoryIconStyle" TargetType="FontIcon">
