            <SolidColorBrush x:Key="PillNoticeBrush" Color="#F2FFFFFF" />
            <Color x:Key="PillSuccessInkColor">#FF5CC99A</Color>
            <SolidColorBrush x:Key="PillSuccessInkBrush" Color="#FF5CC99A" />
            <Color x:Key="PillSuccessWashColor">#245CC99A</Color>
            <SolidColorBrush x:Key="PillSuccessWashBrush" Color="#245CC99A" />
            <Color x:Key="PillWarningInkColor">#FFE6B766</Color>
            <SolidColorBrush x:Key="PillWarningInkBrush" Color="#FFE6B766" />
            <Color x:Key="PillWarningWashColor">#24E6B766</Color>
            <SolidColorBrush x:Key="PillWarningWashBrush" Color="#24E6B766" />
            <Color x:Key="PillErrorInkColor">#FFEF7C89</Color>
            <SolidColorBrush x:Key="PillErrorInkBrush" Color="#FFEF7C89" />
            <Color x:Key="PillErrorWashColor">#24EF7C89</Color>
            <SolidColorBrush x:Key="PillErrorWashBrush" Color="#24EF7C89" />
            <Color x:Key="PillAdvisoryInkColor">#FFA78BFA</Color>
            <SolidColorBrush x:Key="PillAdvisoryInkBrush" Color="#FFA78BFA" />
            <Color x:Key="PillAdvisoryWashColor">#24A78BFA</Color>
            <SolidColorBrush x:Key="PillAdvisoryWashBrush" Color="#24A78BFA" />
            <Color x:Key="PillDistressWashColor">#4AEF7C89</Color>
            <SolidColorBrush x:Key="PillDistressWashBrush" Color="#4AEF7C89" />

            <!--
                THE RECORDING CAPSULE IS CHARCOAL IN BOTH THEMES, as macOS draws it: Classic, Level
                Rail and Processing float over somebody else's document and carry white ink, so they
                never follow the app's theme. OverlayCapsuleBackground.swift: #14141C at 0.82.
            -->
            <Color x:Key="PillCapsuleSurfaceColor">#D114141C</Color>
            <SolidColorBrush x:Key="PillCapsuleSurfaceBrush" Color="#D114141C" />
            <Color x:Key="PillCapsuleBorderColor">#1AFFFFFF</Color>
            <SolidColorBrush x:Key="PillCapsuleBorderBrush" Color="#1AFFFFFF" />
            <Color x:Key="PillCapsuleTextColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="PillCapsuleTextBrush" Color="#FFFFFFFF" />
            <Color x:Key="PillCapsuleBadgeFillColor">#21FFFFFF</Color>
            <SolidColorBrush x:Key="PillCapsuleBadgeFillBrush" Color="#21FFFFFF" />
            <Color x:Key="PillCapsuleBadgeTextColor">#E0FFFFFF</Color>
            <SolidColorBrush x:Key="PillCapsuleBadgeTextBrush" Color="#E0FFFFFF" />

            <!--
                THE READING WELL FOLLOWS THE APP'S THEME, and Light is not an inversion of Dark.
                PreviewPillPalette.swift, light column: a warm near-white surface with violet-black ink.
                The quiet ink is 0.60 rather than the 0.45 that would mirror Dark, because 0.45 measured
                3.10:1 on this surface and 0.60 measures 5.09:1.
            -->
            <Color x:Key="PillWellSurfaceColor">#F0FCFAFF</Color>
            <SolidColorBrush x:Key="PillWellSurfaceBrush" Color="#F0FCFAFF" />
            <Color x:Key="PillWellSurfaceClearColor">#00FCFAFF</Color>
            <SolidColorBrush x:Key="PillWellSurfaceClearBrush" Color="#00FCFAFF" />
            <LinearGradientBrush x:Key="PillWellFadeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#F0FCFAFF" />
                <GradientStop Offset="1" Color="#00FCFAFF" />
            </LinearGradientBrush>
            <Color x:Key="PillWellBorderColor">#240F0A1A</Color>
            <SolidColorBrush x:Key="PillWellBorderBrush" Color="#240F0A1A" />
            <Color x:Key="PillWellDividerColor">#1A0F0A1A</Color>
            <SolidColorBrush x:Key="PillWellDividerBrush" Color="#1A0F0A1A" />
            <Color x:Key="PillWellTimerColor">#FF221B33</Color>
            <SolidColorBrush x:Key="PillWellTimerBrush" Color="#FF221B33" />
            <Color x:Key="PillWellModeQuietColor">#990F0A1A</Color>
            <SolidColorBrush x:Key="PillWellModeQuietBrush" Color="#990F0A1A" />
            <Color x:Key="PillWellBadgeFillColor">#170F0A1A</Color>
            <SolidColorBrush x:Key="PillWellBadgeFillBrush" Color="#170F0A1A" />
            <Color x:Key="PillWellBadgeTextColor">#B80F0A1A</Color>
            <SolidColorBrush x:Key="PillWellBadgeTextBrush" Color="#B80F0A1A" />
            <Color x:Key="PillWellTextColor">#FF0F0A1A</Color>
            <SolidColorBrush x:Key="PillWellTextBrush" Color="#FF0F0A1A" />

            <!-- The hairline fades out through a TRANSPARENT red and violet, never through transparent white. -->
            <Color x:Key="PillHairlineFadeStartColor">#00FF2A40</Color>
            <Color x:Key="PillHairlineFadeEndColor">#008A2BE2</Color>

            <!-- The processing wheel's twelve bars. SpectrumWheelIcon.swift draws these, not the brand spectrum. -->
            <SolidColorBrush x:Key="PillWheelRedBrush" Color="#FFFF2D55" />
            <SolidColorBrush x:Key="PillWheelOrangeBrush" Color="#FFFF9F0A" />
            <SolidColorBrush x:Key="PillWheelYellowBrush" Color="#FFFFD60A" />
            <SolidColorBrush x:Key="PillWheelGreenBrush" Color="#FF30D158" />
            <SolidColorBrush x:Key="PillWheelLeafBrush" Color="#FF34C759" />
            <SolidColorBrush x:Key="PillWheelTealBrush" Color="#FF32D8BE" />
            <SolidColorBrush x:Key="PillWheelSkyBrush" Color="#FF64D2FF" />
            <SolidColorBrush x:Key="PillWheelBlueBrush" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="PillWheelIndigoBrush" Color="#FF5E5CE6" />
            <SolidColorBrush x:Key="PillWheelPurpleBrush" Color="#FFBF5AF2" />
        </ResourceDictionary>

