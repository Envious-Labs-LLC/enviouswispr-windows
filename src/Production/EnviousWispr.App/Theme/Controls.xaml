<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="BrandWindowCardStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource BrandDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource BrandWindowCardRadius}" />
    </Style>
    <Style x:Key="BrandSectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BrandCardBgBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource BrandSectionRadius}" />
    </Style>
    <Style x:Key="BrandIconTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BrandAccentLightBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource BrandSectionRadius}" />
    </Style>
    <Style x:Key="BrandHeaderCardStyle" TargetType="Border" BasedOn="{StaticResource BrandSectionCardStyle}">
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="BrandPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource BrandAccentSolidBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandAccentSolidBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource BrandSectionRadius}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BrandAccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource BrandOnAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BrandOnAccentBrush}" />
    </Style>
    <Style x:Key="BrandQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource BrandAccentLightBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandDividerBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource BrandSectionRadius}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BrandAccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource BrandCardBgBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BrandAccentBrush}" />
    </Style>
    <Style x:Key="BrandHyperlinkButtonStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BrandAccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource BrandCardBgBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BrandAccentBrush}" />
    </Style>
    <Style x:Key="BrandToggleSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BrandAccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource BrandCardBgBrush}" />
    </Style>
    <!-- A dropdown whose selected text is wider than the control clips mid-word with no
         ellipsis, which reads as a rendering fault rather than as a shortened label. Measured at
         the app's own default window size: "Push to Talk - hold to record, release to stop" came
         out as "Push to Talk - hold to reco". -->
    <!-- For dropdowns whose items ARE strings. Binding the item itself is correct here and
         wrong for object-backed lists, where it renders the type name. -->
    <DataTemplate x:Key="BrandTrimmedChoiceTemplate">
        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </DataTemplate>
    <!-- For dropdowns whose items are OBJECTS carrying a DisplayName. These previously used
         DisplayMemberPath, which cannot coexist with an ItemTemplate: setting both throws when
         the item containers are REALIZED, so the app starts cleanly and then dies the moment the
         page holding that dropdown is opened. -->
    <DataTemplate x:Key="BrandTrimmedDisplayNameTemplate">
        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </DataTemplate>
    <DataTemplate x:Key="BrandControlHeaderTemplate">
        <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="{Binding}" TextWrapping="Wrap" />
    </DataTemplate>
    <DataTemplate x:Key="BrandSelectableChoiceTemplate">
        <StackPanel Margin="0,0,28,0" Spacing="{StaticResource BrandSpacingXs}">
            <TextBlock Style="{StaticResource BrandRowLabelStyle}" Text="{Binding Name}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource BrandHelperStyle}" Text="{Binding Description}" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>
    <Style x:Key="BrandSelectableCardStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="{ThemeResource BrandCardBgBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BrandTextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Background" Value="{ThemeResource BrandAccentLightBrush}" />
                                        <Setter Target="InteractionBorder.BorderBrush" Value="{ThemeResource BrandAccentBrush}" />
                                        <Setter Target="InteractionBorder.BorderThickness" Value="3" />
                                        <Setter Target="InteractionBorder.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Background" Value="{ThemeResource BrandAccentLightBrush}" />
                                        <Setter Target="InteractionBorder.BorderBrush" Value="{ThemeResource BrandAccentSolidBrush}" />
                                        <Setter Target="InteractionBorder.BorderThickness" Value="4" />
                                        <Setter Target="InteractionBorder.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Opacity" Value="0.55" />
                                        <!-- A dimmed card wearing a filled check badge says "this is
                                             your choice" while everything else about it says "this
                                             does not apply right now". On the Live Preview page both
                                             pill groups are shown at once and only one is in use, so
                                             two cards were reading as selected simultaneously. The
                                             choice is still remembered; it just stops claiming to be
                                             the current one.

                                             OPACITY, not Visibility. The first attempt set
                                             Visibility here, which the CheckStates group below also
                                             sets - two VisualStateGroups writing one property, with
                                             no defined order between them, so the other group won
                                             and this did nothing. Measured on the running app: both
                                             badges still showed. Opacity is touched by no other
                                             group, so there is nothing to race. -->
                                        <Setter Target="CheckBadge.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource BrandDividerBrush}" />
                                        <Setter Target="SelectionBorder.Opacity" Value="0" />
                                        <Setter Target="CheckBadge.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource BrandAccentBrush}" />
                                        <Setter Target="CheckBadge.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                    <!--
                                        Clicking a card is a decision the user just made, and this
                                        ring is the one place the app tells them it heard. Measured
                                        arriving in a single frame, which reads as unresponsive
                                        rather than crisp.

                                        Opacity only, so the animation cannot move anything: the
                                        ring is already a zero-layout overlay and animating a size
                                        here would put back the two-pixel page shift this border
                                        exists to remove.

                                        The badge fades with it. Its Visibility stays a setter
                                        because that is what hit-testing and assistive tools read;
                                        opacity is only how it arrives.
                                    -->
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectionBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0"
                                            To="1"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CheckBadge"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0"
                                            To="1"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusBorder.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{ThemeResource BrandDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource BrandSectionRadius}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Padding="{TemplateBinding Padding}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border
                            x:Name="SelectionBorder"
                            BorderBrush="{ThemeResource BrandAccentBrush}"
                            BorderThickness="2"
                            CornerRadius="{ThemeResource BrandSectionRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            x:Name="InteractionBorder"
                            BorderBrush="{ThemeResource BrandAccentBrush}"
                            BorderThickness="2"
                            CornerRadius="{ThemeResource BrandSectionRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            x:Name="CheckBadge"
                            Width="24"
                            Height="24"
                            Margin="0,10,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{ThemeResource BrandAccentSolidBrush}"
                            CornerRadius="12"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource BrandOnAccentBrush}"
                                Glyph="&#xE73E;" />
                        </Border>
                        <Border
                            x:Name="FocusBorder"
                            Margin="-3"
                            BorderBrush="{ThemeResource BrandAccentBrush}"
                            BorderThickness="2"
                            CornerRadius="{ThemeResource BrandSectionRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
