<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CornerRadius x:Key="BrandWindowCardRadius">18</CornerRadius>
    <Thickness x:Key="BrandWindowFrameInset">14</Thickness>
    <x:Double x:Key="BrandContentCardMinimumWidth">480</x:Double>
    <CornerRadius x:Key="BrandSectionRadius">14</CornerRadius>
    <x:Double x:Key="BrandRowPaddingH">14</x:Double>
    <x:Double x:Key="BrandRowPaddingV">12</x:Double>
    <x:Double x:Key="BrandSectionSpacing">18</x:Double>
    <x:Double x:Key="BrandContentTop">18</x:Double>
    <x:Double x:Key="BrandContentH">24</x:Double>
    <x:Double x:Key="BrandContentBottom">32</x:Double>
    <CornerRadius x:Key="BrandPillRadius">100</CornerRadius>
    <!-- One measure for every settings page. Pages that each pick their own cap change width as the
         user navigates, which reads as the frame twitching rather than as a deliberate layout. -->
    <x:Double x:Key="BrandPageContentMaxWidth">1040</x:Double>
    <!-- Cap for content nested INSIDE a page card (a centred column within a section). -->
    <x:Double x:Key="BrandInlineContentMaxWidth">440</x:Double>
    <!-- Leading icon column on a setting row, and the inset that lines the glyph up with the row's
         first text line instead of centring it against the whole row. -->
    <x:Double x:Key="BrandRowIconColumnWidth">28</x:Double>
    <Thickness x:Key="BrandRowIconInset">0,2,0,0</Thickness>
    <x:Double x:Key="BrandOnboardingContentMaxWidth">1040</x:Double>
    <Thickness x:Key="BrandOnboardingContentPadding">40,28,40,48</Thickness>
    <x:Double x:Key="BrandOnboardingMarkSize">88</x:Double>
    <x:Double x:Key="BrandOnboardingIconTileSize">52</x:Double>
    <x:Double x:Key="BrandOnboardingIconGlyphSize">22</x:Double>
    <x:Double x:Key="BrandOnboardingStepCardMinHeight">146</x:Double>
    <x:Double x:Key="BrandOnboardingWideSpacing">24</x:Double>
    <x:Double x:Key="BrandOnboardingCardSpacing">12</x:Double>
    <x:Double x:Key="BrandOnboardingTextSpacing">4</x:Double>
    <Thickness x:Key="BrandOnboardingCardPadding">20</Thickness>
</ResourceDictionary>
