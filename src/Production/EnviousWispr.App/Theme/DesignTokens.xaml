<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic absence, used where the native control layer must reveal the branded surface below it. -->
    <Color x:Key="BrandTransparentColor">Transparent</Color>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BrandPageBgColor">#F8F5FF</Color>
            <SolidColorBrush x:Key="BrandPageBgBrush" Color="#F8F5FF" />
            <Color x:Key="BrandCardBgColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="BrandCardBgBrush" Color="#FFFFFF" />
            <Color x:Key="BrandSidebarBgColor">#E8E2F5</Color>
            <SolidColorBrush x:Key="BrandSidebarBgBrush" Color="#E8E2F5" />
            <Color x:Key="BrandWindowBgColor">#DDD5EE</Color>
            <SolidColorBrush x:Key="BrandWindowBgBrush" Color="#DDD5EE" />

            <Color x:Key="BrandTextPrimaryColor">#0F0A1A</Color>
            <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#0F0A1A" />
            <Color x:Key="BrandTextBodyColor">#332D47</Color>
            <SolidColorBrush x:Key="BrandTextBodyBrush" Color="#332D47" />
            <Color x:Key="BrandTextSecondaryColor">#4A3D60</Color>
            <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#4A3D60" />
            <Color x:Key="BrandTextTertiaryColor">#6B5E86</Color>
            <SolidColorBrush x:Key="BrandTextTertiaryBrush" Color="#6B5E86" />

            <Color x:Key="BrandAccentColor">#7C3AED</Color>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#7C3AED" />
            <Color x:Key="BrandAccentSolidColor">#7C3AED</Color>
            <SolidColorBrush x:Key="BrandAccentSolidBrush" Color="#7C3AED" />
            <Color x:Key="BrandOnAccentColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="BrandOnAccentBrush" Color="#FFFFFF" />
            <Color x:Key="BrandAccentLightColor">#177C3AED</Color>
            <SolidColorBrush x:Key="BrandAccentLightBrush" Color="#177C3AED" />

            <Color x:Key="BrandSuccessColor">#00A366</Color>
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#00A366" />
            <Color x:Key="BrandWarningColor">#CC7000</Color>
            <SolidColorBrush x:Key="BrandWarningBrush" Color="#CC7000" />
            <Color x:Key="BrandWarningSoftColor">#1ACC7000</Color>
            <Color x:Key="BrandSuccessSoftColor">#1A00A366</Color>
            <SolidColorBrush x:Key="BrandSuccessSoftBrush" Color="#1A00A366" />
            <Color x:Key="BrandErrorSoftColor">#1AC0392B</Color>
            <SolidColorBrush x:Key="BrandErrorSoftBrush" Color="#1AC0392B" />
            <SolidColorBrush x:Key="BrandWarningSoftBrush" Color="#1ACC7000" />
            <Color x:Key="BrandErrorColor">#C0392B</Color>
            <SolidColorBrush x:Key="BrandErrorBrush" Color="#C0392B" />
            <Color x:Key="BrandToggleOnColor">#00A366</Color>
            <SolidColorBrush x:Key="BrandToggleOnBrush" Color="#00A366" />
            <Color x:Key="BrandToggleOffColor">#9B8EB8</Color>
            <SolidColorBrush x:Key="BrandToggleOffBrush" Color="#9B8EB8" />
            <!--
                A CONTROL BOUNDARY IS NOT A DIVIDER, AND SHARING A TOKEN MADE THEM ONE. A
                divider is meant to be faint; the edge of a control the user is supposed to
                click into is meant to be seen, and WCAG asks 3:1 for one. At the divider
                value the text fields measured 1.13:1 in light and 1.31:1 in dark - visible
                only because the fill is a different HUE from the card, which contrast
                arithmetic is blind to and a colourblind user does not get.
                #847BA0 is 3.95:1 against the card and 3.66:1 against the field fill, so it
                clears the floor on BOTH sides of the line rather than only the one that
                happened to be measured.
            -->
            <Color x:Key="BrandControlBorderColor">#847BA0</Color>
            <SolidColorBrush x:Key="BrandControlBorderBrush" Color="#847BA0" />
            <Color x:Key="BrandDividerColor">#148A2BE2</Color>
            <!--
                A BRUSH THAT EXISTS TO BE HIT-TESTED, NOT TO BE SEEN. WinUI does not hit-test space
                whose background is null, so a row that should respond to a click needs SOME brush -
                and the one it needs is invisible. It is a token rather than a literal because the
                rule here is that every brush is named, and this one's name is the only thing that
                explains why an invisible colour is set at all. The same in every theme, on purpose.
            -->
            <SolidColorBrush x:Key="BrandHitTestBrush" Color="Transparent" />
            <SolidColorBrush x:Key="BrandDividerBrush" Color="#148A2BE2" />

            <Color x:Key="BrandSpectrumRedColor">#FF2A40</Color>
            <SolidColorBrush x:Key="BrandSpectrumRedBrush" Color="#FF2A40" />
            <Color x:Key="BrandSpectrumOrangeColor">#FF8C00</Color>
            <SolidColorBrush x:Key="BrandSpectrumOrangeBrush" Color="#FF8C00" />
            <Color x:Key="BrandSpectrumGoldColor">#FFD700</Color>
            <SolidColorBrush x:Key="BrandSpectrumGoldBrush" Color="#FFD700" />
            <Color x:Key="BrandSpectrumLimeColor">#ADFF2F</Color>
            <SolidColorBrush x:Key="BrandSpectrumLimeBrush" Color="#ADFF2F" />
            <Color x:Key="BrandSpectrumSpringColor">#00FA9A</Color>
            <SolidColorBrush x:Key="BrandSpectrumSpringBrush" Color="#00FA9A" />
            <Color x:Key="BrandSpectrumCyanColor">#00FFFF</Color>
            <SolidColorBrush x:Key="BrandSpectrumCyanBrush" Color="#00FFFF" />
            <Color x:Key="BrandSpectrumBlueColor">#1E90FF</Color>
            <SolidColorBrush x:Key="BrandSpectrumBlueBrush" Color="#1E90FF" />
            <Color x:Key="BrandSpectrumRoyalColor">#4169E1</Color>
            <SolidColorBrush x:Key="BrandSpectrumRoyalBrush" Color="#4169E1" />
            <Color x:Key="BrandSpectrumVioletColor">#8A2BE2</Color>
            <SolidColorBrush x:Key="BrandSpectrumVioletBrush" Color="#8A2BE2" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
