            <Color x:Key="BrandControlBorderColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <SolidColorBrush x:Key="BrandControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <Color x:Key="BrandDividerColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <!--
