            <Color x:Key="BrandCardBgColor">#201B2B</Color>
            <SolidColorBrush x:Key="BrandCardBgBrush" Color="#201B2B" />
            <Color x:Key="BrandSidebarBgColor">#1A1623</Color>
            <SolidColorBrush x:Key="BrandSidebarBgBrush" Color="#1A1623" />
            <Color x:Key="BrandWindowBgColor">#0D0B12</Color>
            <SolidColorBrush x:Key="BrandWindowBgBrush" Color="#0D0B12" />

            <Color x:Key="BrandTextPrimaryColor">#ECE9F4</Color>
            <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#ECE9F4" />
            <Color x:Key="BrandTextBodyColor">#D5D1E2</Color>
            <SolidColorBrush x:Key="BrandTextBodyBrush" Color="#D5D1E2" />
            <Color x:Key="BrandTextSecondaryColor">#AAA2BF</Color>
            <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#AAA2BF" />
            <!--
                RAISED FROM #7A7290, WHICH FAILED WCAG AA IN THIS THEME. It measured 3.70:1 on the
                card and 4.16:1 on the page, against the 4.5:1 normal-size text requires, and it is
                the colour every helper line in the window is painted in - the sentences that explain
                what a control does, including the onboarding copy.
                #9289AD measures 5.11:1 and 5.74:1. Still far dimmer than Windows' own dark secondary
                text at roughly 9.7:1, which is the intent; it just clears the floor now.
                NOBODY SAW THIS. Twenty screens were inspected by eye and the text read as fine every
                time, because eyes adapt to a palette and the person looking at it longest adapts
                hardest. It is not visible as a defect, only as a number - which is why the number is
                now asserted in the suite rather than left to a reader.
            -->
            <Color x:Key="BrandTextTertiaryColor">#9289AD</Color>
            <SolidColorBrush x:Key="BrandTextTertiaryBrush" Color="#9289AD" />

            <Color x:Key="BrandAccentColor">#A78BFA</Color>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#A78BFA" />
            <Color x:Key="BrandAccentSolidColor">#8B46F0</Color>
            <SolidColorBrush x:Key="BrandAccentSolidBrush" Color="#8B46F0" />
            <Color x:Key="BrandOnAccentColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="BrandOnAccentBrush" Color="#FFFFFF" />
            <Color x:Key="BrandAccentLightColor">#29A78BFA</Color>
            <SolidColorBrush x:Key="BrandAccentLightBrush" Color="#29A78BFA" />

            <Color x:Key="BrandSuccessColor">#5CC99A</Color>
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#5CC99A" />
            <Color x:Key="BrandWarningColor">#E6B766</Color>
            <SolidColorBrush x:Key="BrandWarningBrush" Color="#E6B766" />
            <Color x:Key="BrandWarningSoftColor">#24E6B766</Color>
            <Color x:Key="BrandSuccessSoftColor">#245CC99A</Color>
            <SolidColorBrush x:Key="BrandSuccessSoftBrush" Color="#245CC99A" />
            <Color x:Key="BrandErrorSoftColor">#24EF7C89</Color>
            <SolidColorBrush x:Key="BrandErrorSoftBrush" Color="#24EF7C89" />
            <SolidColorBrush x:Key="BrandWarningSoftBrush" Color="#24E6B766" />
            <Color x:Key="BrandErrorColor">#EF7C89</Color>
            <SolidColorBrush x:Key="BrandErrorBrush" Color="#EF7C89" />
            <Color x:Key="BrandToggleOnColor">#5CC99A</Color>
            <SolidColorBrush x:Key="BrandToggleOnBrush" Color="#5CC99A" />
            <Color x:Key="BrandToggleOffColor">#4A4360</Color>
            <SolidColorBrush x:Key="BrandToggleOffBrush" Color="#4A4360" />
            <!-- 3.55:1 on the card, 3.99:1 on the field fill. See the light block. -->
            <Color x:Key="BrandControlBorderColor">#75708C</Color>
            <SolidColorBrush x:Key="BrandControlBorderBrush" Color="#75708C" />
            <Color x:Key="BrandDividerColor">#24B8AAD6</Color>
            <!--
                A BRUSH THAT EXISTS TO BE HIT-TESTED, NOT TO BE SEEN. WinUI does not hit-test space
                whose background is null, so a row that should respond to a click needs SOME brush -
                and the one it needs is invisible. It is a token rather than a literal because the
                rule here is that every brush is named, and this one's name is the only thing that
                explains why an invisible colour is set at all. The same in every theme, on purpose.
            -->
            <SolidColorBrush x:Key="BrandHitTestBrush" Color="Transparent" />
            <SolidColorBrush x:Key="BrandDividerBrush" Color="#24B8AAD6" />

            <Color x:Key="BrandSpectrumRedColor">#FF2A40</Color>
            <SolidColorBrush x:Key="BrandSpectrumRedBrush" Color="#FF2A40" />
            <Color x:Key="BrandSpectrumOrangeColor">#FF8C00</Color>
            <SolidColorBrush x:Key="BrandSpectrumOrangeBrush" Color="#FF8C00" />
            <Color x:Key="BrandSpectrumGoldColor">#FFD700</Color>
            <SolidColorBrush x:Key="BrandSpectrumGoldBrush" Color="#FFD700" />
            <Color x:Key="BrandSpectrumLimeColor">#ADFF2F</Color>
            <SolidColorBrush x:Key="BrandSpectrumLimeBrush" Color="#ADFF2F" />
            <Color x:Key="BrandSpectrumSpringColor">#00FA9A</Color>
            <SolidColorBrush x:Key="BrandSpectrumSpringBrush" Color="#00FA9A" />
            <Color x:Key="BrandSpectrumCyanColor">#00FFFF</Color>
            <SolidColorBrush x:Key="BrandSpectrumCyanBrush" Color="#00FFFF" />
            <Color x:Key="BrandSpectrumBlueColor">#1E90FF</Color>
            <SolidColorBrush x:Key="BrandSpectrumBlueBrush" Color="#1E90FF" />
            <Color x:Key="BrandSpectrumRoyalColor">#4169E1</Color>
            <SolidColorBrush x:Key="BrandSpectrumRoyalBrush" Color="#4169E1" />
            <Color x:Key="BrandSpectrumVioletColor">#8A2BE2</Color>
            <SolidColorBrush x:Key="BrandSpectrumVioletBrush" Color="#8A2BE2" />
        </ResourceDictionary>

