            <Color x:Key="BrandSpectrumGoldColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <SolidColorBrush x:Key="BrandSpectrumGoldBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <Color x:Key="BrandSpectrumLimeColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <SolidColorBrush x:Key="BrandSpectrumLimeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <Color x:Key="BrandSpectrumSpringColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <SolidColorBrush x:Key="BrandSpectrumSpringBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <Color x:Key="BrandSpectrumCyanColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <SolidColorBrush x:Key="BrandSpectrumCyanBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
