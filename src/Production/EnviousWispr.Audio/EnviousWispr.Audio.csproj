  <ItemGroup>
    <ProjectReference Include="..\EnviousWispr.Core\EnviousWispr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.0.1" />
